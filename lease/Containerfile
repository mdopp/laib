# laib-lease in its container (ADR 0027): the llama template's policy
# proxy and GPU lease (ADR 0011). It gets its lease folder, presets.json
# read-only and two tokens (the model key, the lease hand's); it pauses
# services through laib's MCP, never with systemctl.
# One static binary on distroless/static, no shell. It runs as the
# container's root, which rootless podman maps to core: it owns its lease
# folder as the host unit did. The llama template ships the unit
# (templates/llama/llama-lease.container); laib pins this image into it.
FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /laib-lease ./lease/cmd/laib-lease
FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /laib-lease /laib-lease
LABEL org.opencontainers.image.source=https://github.com/mdopp/laib
ENTRYPOINT ["/laib-lease"]
