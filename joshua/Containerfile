# Joshua: WOPR from WarGames, the Bote's easter egg (#119); one static binary.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /joshua ./cmd/joshua
FROM scratch
LABEL org.opencontainers.image.source=https://github.com/mdopp/laib
COPY --from=build /joshua /joshua
EXPOSE 8644
ENTRYPOINT ["/joshua"]
