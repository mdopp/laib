# laib-notify in its container (ADR 0027): the watchdog ping and the
# owner's messages (#443, #441).
# One static binary on distroless/static: CA certificates for https (the
# model, the watchdog, SMTP) and tzdata, no shell. It runs as the
# container's root, which rootless podman maps to core: it owns its folder
# as the host unit did. Laib renders the unit (internal/render ownUnit).
FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /laib-notify ./notify/cmd/laib-notify
FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /laib-notify /laib-notify
LABEL org.opencontainers.image.source=https://github.com/mdopp/laib
ENTRYPOINT ["/laib-notify"]
