[Unit]
Description=Notizbuch of anna

[Container]
Image=docker.io/example/notizbuch:1.0
PublishPort=127.0.0.1:8481:8080
Volume=/mnt/data/stacks/notizbuch-anna:/data:Z
Environment=NOTIZBUCH_OWNER=anna
Secret=laib.notizbuch-anna.notizbuch-anna.NOTIZBUCH_KEY,type=env,target=NOTIZBUCH_KEY

[Service]
Restart=always

[Install]
WantedBy=default.target
