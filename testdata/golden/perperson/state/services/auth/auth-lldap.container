[Unit]
Description=LLDAP — users and groups (laib role: identity)

[Container]
Image=${LLDAP_IMAGE}
Pod=auth.pod
Environment=TZ=${TZ}
Environment=LLDAP_JWT_SECRET=${LLDAP_JWT}
Environment=LLDAP_LDAP_BASE_DN=${BASE_DN}
Environment=LLDAP_LDAP_USER_DN=admin
Environment=LLDAP_LDAP_USER_PASS=${LLDAP_ADMIN}
Environment=LLDAP_HTTP_PORT=17170
Environment=LLDAP_HTTP_HOST=0.0.0.0
Environment=LLDAP_LDAP_PORT=3890
Environment=LLDAP_LDAP_HOST=0.0.0.0
Volume=${DATA_DIR}/auth/lldap:/data:z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
