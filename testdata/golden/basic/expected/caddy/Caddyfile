# Rendered by laib. Do not edit; change services/*/laib.yml and run laib apply.
{
	email admin@example.home
	order request_header first
	cert_issuer acme {
		dns desec {
			token {env.LAIB_DNS_TOKEN}
		}
		dns_challenge_override_domain example-acme.dedyn.io
		resolvers 9.9.9.9 1.1.1.1
	}
}

(authelia) {
	forward_auth 127.0.0.1:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

laib.example.home {
	request_header -Remote-*
	@lan remote_ip private_ranges
	handle @lan {
		import authelia
		reverse_proxy 127.0.0.1:5900 {
			header_up X-Laib-Proxy "${secret:LAIB_PROXY_SECRET}"
		}
	}
	respond 403
}

*.example.home {
	request_header -Remote-*
	abort
}

auth.example.home {
	request_header -Remote-*
	reverse_proxy 127.0.0.1:9091
}

ldap.example.home {
	request_header -Remote-*
	@lan remote_ip private_ranges
	handle @lan {
		reverse_proxy 127.0.0.1:17170
	}
	respond 403
}

whoami.example.home {
	request_header -Remote-*
	@lan remote_ip private_ranges
	handle @lan {
		import authelia
		request_body {
		  max_size 10MB
		}
		reverse_proxy 127.0.0.1:8080
	}
	respond 403
}

