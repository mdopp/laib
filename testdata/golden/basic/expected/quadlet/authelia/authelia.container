[Unit]
Description=Authelia (laib role: sso)

[Container]
Image=docker.io/authelia/authelia:4
PublishPort=127.0.0.1:9091:9091
Environment=TZ=Europe/Berlin
Environment=X_AUTHELIA_CONFIG=/config/configuration.yml,/laib/laib-access.yml,/laib/laib-clients.yml
Environment=AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=${secret:AUTHELIA_JWT_SECRET}
Environment=AUTHELIA_SESSION_SECRET=${secret:AUTHELIA_SESSION_SECRET}
Environment=AUTHELIA_STORAGE_ENCRYPTION_KEY=${secret:AUTHELIA_STORAGE_KEY}
Volume=/mnt/data/stacks/authelia/config:/config:z
Volume=/mnt/data/laib/render/authelia:/laib:ro,z

[Service]
Restart=always

[Install]
WantedBy=default.target
