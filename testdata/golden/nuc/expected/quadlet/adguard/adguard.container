[Unit]
Description=AdGuard Home — LAN DNS (laib role: dns)
After=network-online.target

[Container]
Image=docker.io/adguard/adguardhome:latest
Network=host
Environment=TZ=Europe/Berlin
Volume=/mnt/data/stacks/adguard/conf:/opt/adguardhome/conf:z
Volume=/mnt/data/stacks/adguard/work:/opt/adguardhome/work:z
AddCapability=NET_BIND_SERVICE
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
