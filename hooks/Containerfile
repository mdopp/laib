# laib-hooks: where template hooks run (#36, ADR 0004 amended). Python with
# the standard library, bcrypt for AdGuard's first user, bash, curl and
# openssl, psql for the one-shot Immich library move (#263) — nothing of this
# lives on the host; Fedora CoreOS has no Python.
FROM python:3.13-alpine
RUN apk add --no-cache bash curl openssl ca-certificates postgresql17-client && pip install --no-cache-dir bcrypt==4.3.0
WORKDIR /laib/service
ENTRYPOINT ["/bin/sh", "-c", "exec \"$@\"", "--"]
