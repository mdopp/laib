# Rendered by laib: the box's admin agent (ADR 0013).
[Unit]
Description=Laib operator
After=laib.service
Wants=laib.service

[Service]
ExecStart=/var/opt/laib/laib-operator
Environment=LAIB_MCP_URL=http://127.0.0.1:5900/mcp
Environment=LAIB_TOKEN=${secret:OPERATOR_TOKEN}
Environment=MODEL_URL=
Environment=MODEL_KEY=
Environment=MODEL_NAME=gemma-4-e4b
Environment=OPERATOR_HOME=/mnt/data/laib/operator
Environment=OPERATOR_LISTEN=127.0.0.1:5901
Environment=OPERATOR_TICK=10m
Environment=OPERATOR_REPORT_AT=07:00
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
