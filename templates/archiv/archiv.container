[Unit]
Description=Archiv von ${PERSON}: Nachrichten im Tresor (ADR 0029)

[Container]
# pinned: msgvault's database lives inside, its storage format may change
# (alpha); a new archiv image is a template update the owner approves
Image=${ARCHIV_IMAGE}
# every address, not loopback: Homes reaches /intern/ from its pod (laib#1016); ports lan: false keeps the LAN out
PublishPort=18540:8080
Volume=${DATA_DIR}/${SERVICE}:/data
# read, write and delete: the archive removes packed backups and keeps the newest in letzte/
Volume=${DATA_DIR}/archiv-eingang/${PERSON}:/eingang
# the vault is a gocryptfs (FUSE) mount in the container's own user and mount
# namespace; labelling off as for Homes's shared inbox, which Homes writes too
AddDevice=/dev/fuse
AddCapability=SYS_ADMIN
SecurityLabelDisable=true
Environment=ARCHIV_PERSON=${PERSON}
Environment=PROXY_SECRET=${PROXY}
Environment=ARCHIV_HOMES_SECRET=${HOMES_SECRET}
Environment=TZ=${TZ}
Environment=PUBLIC_URL=https://archiv.${DOMAIN}/
# Homes' own port on the box (archiv#27, homes internal/uebernahme): the person's tap on an answer
# is written there server to server, signed with ARCHIV_HOMES_SECRET; never through Caddy
Environment=ARCHIV_HOMES_INTERN=http://host.containers.internal:8650
# contacts and calendars from Radicale, read only (archiv#21, laib#1009): its
# root on the host, its own login; the password a file, never the environment
Environment=RADICALE_URL=http://host.containers.internal:5232
Environment=RADICALE_USER=archiv-${PERSON}
Secret=${RADICALE_PASSWORD},type=mount,target=radicale-password
# Immich for Umfeld (archiv#27, ADR 0029 amendment 2026-11-10): the photos that show who meets whom. The key is
# the person's own, entered on the archive's page into the open vault; the box never holds one for the archive
Environment=IMMICH_URL=${IMMICH_URL}
Environment=IMMICH_PUBLIC_URL=${IMMICH_PUBLIC_URL}
# the box's own model for Umfeld's relation hints (archiv#27, owner 2026-11-11): only while the vault is open, a
# message with a relation word goes, with who wrote it to whom, to the household model through laib-lease's proxy
# (ADR 0007), and nowhere else; the lease says when the card is taken and the archive waits. Without a model on the
# box URL and key render empty and no message is sent
Environment=MODEL_URL=${MODEL_URL}
Environment=MODEL_LEASE=${MODEL_LEASE}
Environment=MODEL_KEY=${MODEL_KEY}
Environment=MODEL_NAME=qwen3.6-35b-a3b
# the household's document mailbox (archiv#34): the archive reads only mail to <person>+doc@<domain>,
# read-only, and never deletes there; the password a file, never the environment; empty: no file, not read
Environment=DOKUMENTE_MAIL_HOST=${DOKUMENTE_MAIL_HOST}
Environment=DOKUMENTE_MAIL_PORT=${DOKUMENTE_MAIL_PORT}
Environment=DOKUMENTE_MAIL_USER=${DOKUMENTE_MAIL_USER}
Environment=DOKUMENTE_MAIL_DOMAIN=${DOKUMENTE_MAIL_DOMAIN}
Environment=DOKUMENTE_MAIL_ORDNER=${DOKUMENTE_MAIL_ORDNER}
Secret=${DOKUMENTE_MAIL_PASSWORD},type=mount,target=dokumente-mail-password

[Service]
Restart=always
# closing stops msgvault (≤ 30 s) and unmounts the vault
TimeoutStopSec=120

[Install]
WantedBy=default.target
