[Unit]
Description=Paperless-ngx — Dokumente mit OCR
After=paperless-db.service paperless-redis.service

[Container]
Image=${IMAGE}
Pod=paperless.pod
Environment=TZ=${TZ}
Environment=PAPERLESS_REDIS=redis://127.0.0.1:6379
Environment=PAPERLESS_DBHOST=127.0.0.1
Environment=PAPERLESS_DBNAME=paperless
Environment=PAPERLESS_DBUSER=paperless
Environment=PAPERLESS_DBPASS=${DB_PASSWORD}
Environment=PAPERLESS_PORT=8000
Environment=PAPERLESS_URL=https://paperless.${DOMAIN}
Environment=PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.${DOMAIN}
Environment=PAPERLESS_SECRET_KEY=${SECRET_KEY}
Environment=PAPERLESS_OCR_LANGUAGE=${OCR_LANGUAGE}
# redo (#567): 11 of 19 documents kept a scanner's or an upside-down page's letter
# salad as their text under auto; redo recognises every page again and keeps a
# born-digital PDF's own text (force rasterises it). Paperless turns deskew off under redo.
Environment=PAPERLESS_OCR_MODE=${OCR_MODE}
Environment=PAPERLESS_OCR_ROTATE_PAGES=${OCR_ROTATE_PAGES}
Environment=PAPERLESS_OCR_DESKEW=${OCR_DESKEW}
# Paperless' AI (#567): suggestions and the document chat from the household model through
# the model role's proxy, the embeddings for the chat's index through the same proxy (it
# hands /v1/embeddings to llama-embed, owner 2026-10-24: no port of its own for pods).
# post-deploy clears these fields in Paperless' own settings, which would win over these.
Environment=PAPERLESS_AI_ENABLED=${AI_ENABLED}
Environment=PAPERLESS_AI_LLM_BACKEND=openai-like
Environment=PAPERLESS_AI_LLM_ENDPOINT=${MODEL_URL}
Environment=PAPERLESS_AI_LLM_API_KEY=${MODEL_KEY}
Environment=PAPERLESS_AI_LLM_MODEL=${AI_MODEL}
Environment=PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=${AI_LANGUAGE}
Environment=PAPERLESS_AI_LLM_CONTEXT_SIZE=${AI_CONTEXT}
Environment=PAPERLESS_AI_LLM_REQUEST_TIMEOUT=${AI_TIMEOUT}
Environment=PAPERLESS_AI_LLM_EMBEDDING_BACKEND=${AI_EMBED_BACKEND}
Environment=PAPERLESS_AI_LLM_EMBEDDING_MODEL=${AI_EMBED_MODEL}
Environment=PAPERLESS_AI_LLM_EMBEDDING_CHUNK_SIZE=${AI_EMBED_CHUNK}
# a folder in the consume folder is a tag (#521): the Bote files a document as
# Bote/<sender>/<title>.pdf, so it gets the tags Bote and the sender; a folder
# copied in over the share or by laib-import is filed and tagged the same
Environment=PAPERLESS_CONSUMER_RECURSIVE=true
Environment=PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
# One family login through Authelia's OIDC (django-allauth, #231): the account is
# made on the first login, groups follow Authelia's on every login (post-deploy makes
# the groups admins and family with their permissions, paperless-mail.py), the local
# admin stays as break-glass and
# the apps log in with a token. The client secret is a podman secret, rendered from
# secrets.age on every apply, so it cannot drift from Authelia's.
Environment=PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
Environment=PAPERLESS_SOCIAL_AUTO_SIGNUP=true
Environment=PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
Environment='PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"SCOPE":["openid","profile","email","groups"],"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"authelia","name":"Authelia","client_id":"paperless","secret":"${OIDC_SECRET}","settings":{"server_url":"https://auth.${DOMAIN}","token_auth_method":"client_secret_basic"}}]}}'
Environment=PAPERLESS_ADMIN_USER=${ADMIN_USER}
Environment=PAPERLESS_ADMIN_PASSWORD=${ADMIN_PW}
Environment=USERMAP_UID=1000
Environment=USERMAP_GID=1000
Volume=${DATA_DIR}/paperless/data:/usr/src/paperless/data:z
Volume=${DATA_DIR}/paperless/media:/usr/src/paperless/media:z
# the shared file-share tree: never relabelled (:z walks it on every start and
# fails on an entry core does not own, #230); labelling off for this container
SecurityLabelDisable=true
Volume=${CONSUME}:/usr/src/paperless/consume
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
