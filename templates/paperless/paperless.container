[Unit]
Description=Paperless-ngx — Dokumente mit OCR
After=paperless-db.service paperless-redis.service

[Container]
Image=${IMAGE}
Pod=paperless.pod
Environment=TZ=${TZ}
Environment=PAPERLESS_REDIS=redis://127.0.0.1:6379
Environment=PAPERLESS_DBHOST=127.0.0.1
Environment=PAPERLESS_DBNAME=paperless
Environment=PAPERLESS_DBUSER=paperless
Environment=PAPERLESS_DBPASS=${DB_PASSWORD}
Environment=PAPERLESS_PORT=8000
Environment=PAPERLESS_URL=https://paperless.${DOMAIN}
Environment=PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.${DOMAIN}
Environment=PAPERLESS_SECRET_KEY=${SECRET_KEY}
Environment=PAPERLESS_OCR_LANGUAGE=${OCR_LANGUAGE}
Environment=PAPERLESS_OCR_MODE=auto
# one family login, as in ServiceBay (solarisbay templates/paperless): Authelia's
# forward-auth in front, Paperless takes and auto-provisions its Remote-User.
# Caddy strips a client's own Remote-* first (#231); the API still wants a token.
Environment=PAPERLESS_ENABLE_HTTP_REMOTE_USER=true
Environment=PAPERLESS_HTTP_REMOTE_USER_HEADER_NAME=HTTP_REMOTE_USER
Environment=PAPERLESS_ADMIN_USER=${ADMIN_USER}
Environment=PAPERLESS_ADMIN_PASSWORD=${ADMIN_PW}
Environment=USERMAP_UID=1000
Environment=USERMAP_GID=1000
Volume=${DATA_DIR}/paperless/data:/usr/src/paperless/data:z
Volume=${DATA_DIR}/paperless/media:/usr/src/paperless/media:z
Volume=${CONSUME}:/usr/src/paperless/consume:z
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
