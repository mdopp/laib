#!/usr/bin/env bash
# The mail inbox from values (#521): paperless-mail.py makes or updates
# Paperless' IMAP account and its rule through Paperless' API, then writes
# the status laib shows. Idempotent; empty PAPERLESS_MAIL_HOST changes nothing.
set -euo pipefail
exec python3 "$(dirname "$0")/paperless-mail.py" setup
