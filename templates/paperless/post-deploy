#!/usr/bin/env bash
# The household's groups and the mail inbox from values (#231, #521):
# paperless-mail.py makes the groups admins and family with their
# permissions, Paperless' side of Dokumente (ADR 0028: its user, its token,
# the workflow „Dokument hinzugefügt“), makes or updates Paperless' IMAP
# account and its rule through Paperless' API, then writes the status laib
# shows. Idempotent; an empty PAPERLESS_MAIL_HOST changes nothing of
# Paperless' mail.
set -euo pipefail
# #665: `laib secret rotate PAPERLESS_DB_PASSWORD` hands the new value over: ALTER ROLE through psql in
# paperless-db over its local socket, from a 0600 file in pgdata (never argv, #214); laib takes the
# hand-back only when that psql ran through, and Paperless gets it with the restart that follows.
next=${LAIB_ROTATE_PAPERLESS_DB_PASSWORD:-}
if [ -n "$next" ] && [ "$next" != "${LAIB_SECRET_PAPERLESS_DB_PASSWORD:-}" ]; then
  q="'"
  (umask 077 && printf "ALTER ROLE paperless PASSWORD '%s';\n" "${next//$q/$q$q}" > "$LAIB_DATA_DIR/paperless/pgdata/.laib-rotate.sql")
  echo "laib-exec: systemd-paperless-db psql -q -v ON_ERROR_STOP=1 -U paperless -d paperless -f /var/lib/postgresql/data/.laib-rotate.sql"
  echo "laib-secret: PAPERLESS_DB_PASSWORD=$next"
  echo "laib-exec: systemd-paperless-db rm -f /var/lib/postgresql/data/.laib-rotate.sql"
  echo "paperless: the database password changes (laib secret rotate); Paperless takes it with its restart"
fi
# ADR 0028: the contract helper's record moves once, from Paperless' data folder (paperless-vertraege.timer,
# gone with this template) to Dokumente's, the scan service's, so the reminders made and the messages told
# carry over. Only while Dokumente has none: a copy made once is never overwritten, and the old file stays for
# a rollback. Staged and renamed, so Dokumente never reads half a file.
old="$LAIB_DATA_DIR/paperless/data/laib-vertraege.json" new="$LAIB_DATA_DIR/scan/laib-vertraege.json"
if [ -f "$old" ] && [ ! -e "$new" ]; then
  cp "$old" "$new.umzug" && mv "$new.umzug" "$new"
  echo "paperless: die Aufzeichnung der Vertragsauswertung ist zu Dokumente umgezogen ($new)"
fi
exec python3 "$(dirname "$0")/paperless-mail.py" setup
