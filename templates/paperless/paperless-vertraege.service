# Contract data and notice reminders (#709, #721): paperless-vertraege.sh feeds
# paperless-vertraege.py into the running Paperless container, as the
# paperless user (never root, as paperless-check), with Paperless' own admin
# and its AI settings from the container's environment: the household model
# through the model role's proxy, marked as background work. It fills only the
# empty contract fields of the documents VERTRAG_ARTEN names and the invoice
# fields of those RECHNUNG_ARTEN or the title names (#818), moves a passed
# notice date on by the renewal the text names, makes a reminder in Haus's
# Haushalt before each notice date, and on the reminder day hands a message
# for the owner to laib-notify's eingang/ (the Bote, else mail). It also has
# letter-salad texts recognised again, and clears a household person off the
# documents the AI gave them as correspondent (#737). With Haus it also keeps
# each document's sender in the family address book (kontakt_ergaenzen, #820). Haus's token reaches podman through the
# environment, never on argv; without Haus no calendar reminder is made.
# Hourly from the timer; the record in Paperless' data folder keeps it from
# asking twice.
[Unit]
Description=Paperless: Vertrags- und Rechnungsdaten lesen, an Kündigungen erinnern
After=paperless.service

[Service]
Type=oneshot
Environment=VERTRAG_ARTEN=${VERTRAG_ARTEN}
Environment=VERTRAG_VORLAUF_TAGE=${VERTRAG_VORLAUF_TAGE}
Environment=RECHNUNG_ARTEN=${RECHNUNG_ARTEN}
Environment=HAUSHALT_URL=${HAUSHALT_URL}
Environment=HAUSHALT_TOKEN=${HAUSHALT_TOKEN}
Environment=HAUSHALT_NAMEN=${HAUSHALT_NAMEN}
Environment=VERTRAEGE_SKRIPT=%h/.config/containers/systemd/paperless/paperless-vertraege.py
ExecStart=/bin/sh %h/.config/containers/systemd/paperless/paperless-vertraege.sh
TimeoutStartSec=2h
