# frage's detail line on the Box page (#785): frage-check.py in a stock Python
# image, fed on stdin (as kalender-abgleich), in the frage pod's network
# namespace, so it asks SearXNG where Frage does (127.0.0.1:8888, format=json).
# One search a run; it writes the status file laib.yml declares. The timer
# runs it once an hour (it asks the web's search engines, so never more often);
# laib starts it when someone looks and the file is older than its stale.
[Unit]
Description=Frage: eine Probesuche für laibs Status
After=frage-searx.service

[Service]
Type=oneshot
StandardInput=file:%h/.config/containers/systemd/frage/frage-check.py
ExecStart=/usr/bin/podman run --rm -i --name frage-check --pod frage --security-opt label=disable -e SEARX_URL=http://127.0.0.1:8888 -e STATUS_DIR=/data -v ${DATA_DIR}/frage/check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
