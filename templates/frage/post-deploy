#!/usr/bin/env bash
# SearXNG needs the JSON format enabled; the image ships settings without it.
set -euo pipefail
D="$LAIB_DATA_DIR/frage/searxng"
mkdir -p "$D"
if [ ! -f "$D/settings.yml" ]; then
  cat > "$D/settings.yml" <<YAML
use_default_settings: true
server:
  secret_key: "${LAIB_SECRET_SEARX_SECRET}"
  limiter: false
search:
  formats: [html, json]
  default_lang: de-DE
YAML
  echo "searxng settings written"
fi
