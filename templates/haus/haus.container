[Unit]
Description=Haus: pages and the companion API (laib role: haus)

[Container]
Image=${HAUS_IMAGE}
# the pod publishes 8650 (haus.pod)
Pod=haus.pod
Environment=HAUS_LISTEN=0.0.0.0:8650
Environment=LAIB_URL=http://host.containers.internal:5900
Environment=LAIB_TOKEN=${LAIB_TOKEN}
Environment=HAUS_PROXY_SECRET=${PROXY_SECRET}
Environment=LAIB_PUBLIC_URL=${LAIB_PAGE_URL}
# the house paths from Home Assistant (haus#10); without the token Haus serves none of them
Environment=HAUS_HA_URL=${HA_URL}
Environment=HAUS_HA_TOKEN=${HA_TOKEN}
Environment=HAUS_ENERGY_FLOW=${ENERGY_FLOW}
Environment=HAUS_ENERGY_TOTALS=${ENERGY_TOTALS}
Environment=HAUS_STT_PROVIDER=${STT_PROVIDER}
Environment=HAUS_STT_LANGUAGE=${STT_LANGUAGE}
Environment=HAUS_HA_PUBLIC_URL=${HA_PUBLIC_URL}
Environment=HAUS_ENERGY_STATS=${ENERGY_STATS}
Environment=HAUS_COVER_INVERTED=${COVER_INVERTED}
# the Haushalt (haus#11): the Bote's bearer, Radicale, the notes folder
Environment=HAUS_HAUSHALT_TOKEN=${HAUSHALT_TOKEN}
Environment=HAUS_RADICALE_URL=${RADICALE_URL}
Environment=HAUS_RADICALE_USER=${RADICALE_USER}
Environment=HAUS_RADICALE_PASSWORD=${RADICALE_PASSWORD}
Environment=HAUS_RADICALE_CALENDAR=${RADICALE_CALENDAR}
Environment=HAUS_RADICALE_ADDRESSBOOK=${RADICALE_ADDRESSBOOK}
# Haushalt/Kalender (haus#66): "Kalender in Radicale öffnen" and each calendar's address for the phone
Environment=HAUS_RADICALE_PUBLIC_URL=${RADICALE_PUBLIC_URL}
Environment=HAUS_PAPERLESS_URL=${PAPERLESS_URL}
Environment=HAUS_PAPERLESS_TOKEN=${PAPERLESS_TOKEN}
Environment=HAUS_PAPERLESS_PUBLIC_URL=${PAPERLESS_PUBLIC_URL}
# the Dokumente page (haus#68, #521): the address mail is filed from (Paperless fetches it), and
# whether Paperless opens only at home (its route is internal: from outside, a word instead of the link)
Environment=HAUS_DOCUMENTS_MAIL=${DOCUMENTS_MAIL}
Environment=HAUS_PAPERLESS_LAN_ONLY=${PAPERLESS_LAN_ONLY}
# the Box page's Werkstatt card (haus#15)
Environment=HAUS_WERKSTATT_REPOS=${WERKSTATT_REPOS}
Environment=HAUS_NOTES_DIR=/notes
# the memory library (haus#13): qmd on the pod's loopback (haus-qmd.container); qmd answers only a
# loopback Host. Its collection is qmd.json's "notizen" over the same folder as HAUS_NOTES_DIR
Environment=HAUS_QMD_URL=http://127.0.0.1:8181
Environment=HAUS_QMD_COLLECTION=notizen
# Paperless's documents in the library (#219): `haus export-documents` (the refresh's first step) mirrors their OCR
# text into HAUS_DOCUMENTS_DIR, qmd.json's collection "dokumente" indexes it. Without Paperless Haus leaves them out
Environment=HAUS_QMD_DOCUMENTS=dokumente
Environment=HAUS_DOCUMENTS_DIR=/dokumente
# the house model tidies the library's hits (#198), never blocking: the model role's proxy as this pod
# reaches it (host.containers.internal) and its key. Without a model on the box URL and key render
# empty and Haus's judge is off
Environment=HAUS_LLM_URL=${MODEL_URL}
Environment=HAUS_LLM_MODEL=qwen3.6-35b-a3b
Environment=HAUS_LLM_KEY=${MODEL_KEY}
# the Sprechen field (haus#12, #215): the Bote's OpenAI-compatible API as this pod reaches it, and its key;
# without the Bote the key renders empty and Haus shows no field
Environment=HAUS_BOTE_URL=${BOTE_URL}
Environment=HAUS_BOTE_KEY=${BOTE_KEY}
# podcasts by link (#676, haus#123): Audiobookshelf as this pod reaches it and the key of its user haus
# (an administrator: subscribing and checking for new episodes are admin-only in ABS); minted by
# audiobookshelf's post-deploy, empty without ABS, and then Haus shows no podcast page
Environment=HAUS_ABS_URL=${ABS_URL}
Environment=HAUS_ABS_TOKEN=${ABS_TOKEN}
# the music wish list (#695): Jellyfin as this pod reaches it and the token of its user haus (hidden, the
# music libraries only, no administrator: API keys have no levels); minted by media's post-deploy, empty
# without media, and then a wish is never „hast du schon“ nor ticked off by itself
Environment=HAUS_JELLYFIN_URL=${JELLYFIN_URL}
Environment=HAUS_JELLYFIN_TOKEN=${JELLYFIN_TOKEN}
# what the family uses (#266): counts per feature and day, never who, flushed every few minutes to
# usage-metrics as this pod reaches it; the admins' "Was wird genutzt" card reads it back. Without
# usage-metrics the token renders empty and Haus counts nothing
Environment=HAUS_USAGE_URL=${USAGE_URL}
Environment=HAUS_USAGE_TOKEN=${USAGE_TOKEN}
# the app's camera uploads, straight into Paperless's inbox (haus#10)
Environment=HAUS_UPLOAD_DIR=/upload
Environment=TZ=${TZ}
Environment=HAUS_DATA=/data
Environment=HAUS_PUBLIC_URL=https://haus.${DOMAIN}
# the house persona: title, greeting, icon, colours (ADR 0020, #129)
Environment=HAUS_PERSONA=${PERSONA}
Environment=PERSONA_REV=${PERSONA_REV}
Volume=/mnt/data/laib/render/persona:/persona:ro,z
Volume=${DATA_DIR}/haus:/data:Z
# the shared file-share tree: never relabelled (:z walks it on every start and
# fails on an entry core does not own, #230); labelling off for this container
SecurityLabelDisable=true
Volume=${DATA_DIR}/file-share/data/notes:/notes
Volume=${DATA_DIR}/file-share/data/paperless-consume:/upload
# music uploads into beets' Musik-Eingang (#639): written as ._<name>.part, renamed when whole;
# laib status beets says what went in. Nothing else of the share
Volume=${DATA_DIR}/file-share/data/musik-eingang:/musik-eingang
Volume=${DATA_DIR}/haus-dokumente:/dokumente:z
# the network drive's passwords (#296, haus#52): each person sets their own on /netzlaufwerk, Haus
# hands it to file-share's Samba through the FIFO there (no argv, no file) and reads who has one
Environment=HAUS_SAMBA_DIR=/samba-accounts
# shown to people as \\<address>\data and smb://<address>/data, never used to connect
Environment=HAUS_SAMBA_HOST=${LAN_IP}
Volume=${DATA_DIR}/file-share/samba-accounts:/samba-accounts
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
