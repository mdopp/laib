# haus's detail line on the Box page (#785): haus-check.py in a stock Python
# image, fed on stdin (as kalender-abgleich), with Haus's folder mounted
# read-only and no network: it counts the devices signed in to the app from
# devices.json (never a hash) and writes the status file laib.yml declares, in
# haus-check beside Haus's folder (Haus relabels its own, :Z). Labelling is off
# here, so neither folder is relabelled. laib starts it when someone looks and
# the file is older than its stale; the timer every 15 minutes.
[Unit]
Description=Haus: angemeldete Geräte für laibs Status
After=haus.service

[Service]
Type=oneshot
StandardInput=file:%h/.config/containers/systemd/haus/haus-check.py
ExecStart=/usr/bin/podman run --rm -i --name haus-check --network none --security-opt label=disable -e HAUS_DATA=/haus -e STATUS_DIR=/data -v ${DATA_DIR}/haus:/haus:ro -v ${DATA_DIR}/haus-check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
