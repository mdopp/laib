[Unit]
Description=Immich machine learning (GPU)

[Container]
Image=${ML_IMAGE}
Pod=immich.pod
AddDevice=nvidia.com/gpu=all
# labelling off: a container_t process may not open the NVIDIA device nodes the GPU line above adds
SecurityLabelDisable=true
Volume=${DATA_DIR}/immich/model-cache:/cache:z
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always

[Install]
WantedBy=default.target
