# immich's detail line on the Box page (#785): immich-check.py in a stock
# Python image, fed on stdin (as kalender-abgleich), in the immich pod's network
# namespace, so it asks Immich on 127.0.0.1. It logs in as the admin, reads the
# server statistics, logs out again, and writes the status file laib.yml
# declares. laib starts it when someone looks and the file is older than its
# stale; the timer every 15 minutes. The password reaches podman through the
# environment, never on argv.
[Unit]
Description=Immich: Fotos, Videos und Konten für laibs Status
After=immich.service

[Service]
Type=oneshot
Environment=IMMICH_PASSWORD=${ADMIN_PW}
Environment=ADMIN_EMAIL=${ADMIN_EMAIL}
StandardInput=file:%h/.config/containers/systemd/immich/immich-check.py
ExecStart=/usr/bin/podman run --rm -i --name immich-check --network container:systemd-immich --security-opt label=disable -e IMMICH_PASSWORD -e ADMIN_EMAIL -e DOMAIN=${DOMAIN} -e IMMICH_URL=http://127.0.0.1:2283 -e STATUS_DIR=/data -v ${DATA_DIR}/immich/check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
