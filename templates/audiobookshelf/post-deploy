#!/usr/bin/env python3
"""audiobookshelf post-deploy: the root user on first run, metadata kept
next to the files, the two libraries („Hörbücher & Hörspiele" on
/audiobooks, matched against audible.de; „Podcasts" on /podcasts), Music
Assistant's own account with an API key (#646), Haus' (#676), and the family's login
(#255). The care of the libraries (the one-time Audible match, the
Hörspiel series, the podcasts of sync_podcasts.py) is abs-pflege.py's,
on a timer: it is slow and resumes, a hook is neither.

Music Assistant plays books and podcasts on the speakers through its
Audiobookshelf provider: a user `musicassistant` (type user: listens,
changes nothing) and an API key for it, handed back as ABS_MA_TOKEN.
music-assistant declares that secret and renders it, so the same apply
re-applies Music Assistant and its post-deploy adds the provider (#349's
pattern). A key that still works is kept; one ABS refuses is replaced and
the old ones of its name deleted.

Haus subscribes podcasts by link and tells the subscriber of a new episode
(#676, haus#123): a user `haus`, an administrator (subscribing, checking a
feed and asking for new episodes are isAdminOrUp in ABS), and its API key
handed back as HAUS_ABS_TOKEN, the same way; the haus template renders it.

The login: ABS keeps its OIDC settings, the client secret among them, in
its own database, and builds its OIDC client from them once, in memory. That
pair retired ABS on ServiceBay (its secret drifted from Authelia's, #1725
there). So on every apply this hook sets the settings from Laib's secret
through ABS's API (PATCH /api/auth-settings), reads them back, and when they
changed switches openid off and on, which is what makes ABS drop its cached
client (MiscController.updateAuthSettings → unuse/init). ABS's own login
stays on: the fallback when Authelia is down."""
import json, os, secrets, sys, time, urllib.request, urllib.error

E = os.environ
BASE = E.get("ABS_URL", "http://127.0.0.1:13378")
PW = E["LAIB_SECRET_ABS_ROOT_PASSWORD"]
MA_USER, KEY_NAME = "musicassistant", "Music Assistant (laib)"
LIBRARIES = (("Hörbücher & Hörspiele", "/audiobooks", "book", "audible.de"), ("Podcasts", "/podcasts", "podcast", "itunes"))
AUTH = "https://auth." + E["LAIB_DOMAIN"]
WANT = {  # Authelia's endpoints; ABS does no discovery of its own
    "authOpenIDIssuerURL": AUTH, "authOpenIDAuthorizationURL": AUTH + "/api/oidc/authorization",
    "authOpenIDTokenURL": AUTH + "/api/oidc/token", "authOpenIDUserInfoURL": AUTH + "/api/oidc/userinfo",
    "authOpenIDJwksURL": AUTH + "/jwks.json", "authOpenIDClientID": "audiobookshelf", "authOpenIDClientSecret": E["OIDC_SECRET"],
    "authOpenIDTokenSigningAlgorithm": "RS256", "authOpenIDButtonText": "Mit Familienkonto anmelden",
    "authOpenIDAutoLaunch": False, "authOpenIDAutoRegister": True,
    "authOpenIDGroupClaim": "",  # with a group claim ABS refuses everyone not in a group named admin, user or guest
    "authOpenIDSubfolderForRedirectURLs": "",  # unset, ABS's callback becomes /undefined/auth/openid/callback
    "authOpenIDMobileRedirectURIs": ["audiobookshelf://oauth"],
}


def req(method, path, body=None, token=None):
    h = {"Content-Type": "application/json", **({"Authorization": "Bearer " + token} if token else {})}
    r = urllib.request.Request(BASE + path, data=json.dumps(body).encode() if body is not None else None, headers=h, method=method)
    with urllib.request.urlopen(r, timeout=20) as resp:
        data = resp.read()
        try:
            return json.loads(data) if data else None
        except ValueError:
            return data.decode(errors="replace")  # /init answers "OK", text

for _ in range(60):
    try:
        status = req("GET", "/status"); break
    except Exception:
        time.sleep(2)
else:
    print("audiobookshelf did not come up", file=sys.stderr); sys.exit(1)
if not status.get("isInit"):
    req("POST", "/init", {"newRoot": {"username": "root", "password": PW}})
    print("root user created")
login = req("POST", "/login", {"username": "root", "password": PW})
user = login["user"]
token = user.get("accessToken") or user["token"]  # ABS 2.26 added accessToken; token is the old one

# metadata.json and the cover next to the files (#646): the folder carries what the match found, a
# new ABS or a restore reads it back; the audio files themselves are never rewritten
if not (login.get("serverSettings") or {}).get("storeMetadataWithItem"):
    req("PATCH", "/api/settings", {"storeMetadataWithItem": True}, token=token)
    print("audiobookshelf: metadata is stored with each item")

# the libraries, found by their folder: one the owner made or renamed stays as it is
have = req("GET", "/api/libraries", token=token)["libraries"]
for name, folder, mtype, provider in LIBRARIES:
    if not any(l.get("mediaType") == mtype and folder in [f.get("fullPath") for f in l.get("folders") or []] for l in have):
        req("POST", "/api/libraries", {"name": name, "folders": [{"fullPath": folder}], "mediaType": mtype, "provider": provider}, token=token)
        print("library created:", name)

# the accounts with a key of their own, each handed back to Laib as a secret its template declares:
# Music Assistant's (#646) listens and changes nothing; Haus' (#676, haus#123) subscribes podcasts by
# link, checks a feed and asks for new episodes, which ABS lets administrators only do (isAdminOrUp)
LISTENS = {"download": True, "update": False, "delete": False, "upload": False,
           "accessAllLibraries": True, "accessAllTags": True, "accessExplicitContent": True}
ACCOUNTS = ((MA_USER, "user", KEY_NAME, "ABS_MA_TOKEN", "Laib re-applies Music Assistant, which adds Audiobookshelf as a source"),
            ("haus", "admin", "Haus (laib)", "HAUS_ABS_TOKEN", "Laib re-applies Haus, which shows its podcast page"))
users = req("GET", "/api/users", token=token)["users"]


def key_works(key, name):
    try:
        return bool(key) and req("GET", "/api/me", token=key).get("username") == name
    except urllib.error.HTTPError:
        return False


for name, kind, key_name, secret, then in ACCOUNTS:
    u = next((u for u in users if u.get("username") == name), None)
    if not u:
        u = req("POST", "/api/users", {"username": name, "password": secrets.token_urlsafe(32), "type": kind, "isActive": True,
                                       **({"permissions": LISTENS} if kind == "user" else {})}, token=token)["user"]   # an admin: ABS's
        print(f"audiobookshelf: account {name} created ({kind})")
    elif kind == "admin" and u.get("type") not in ("admin", "root"):
        req("PATCH", f"/api/users/{u['id']}", {"type": "admin"}, token=token)
        print(f"audiobookshelf: account {name} is an administrator now")
    have = E.get("LAIB_SECRET_" + secret, "")
    if key_works(have, name):
        continue
    for k in req("GET", "/api/api-keys", token=token)["apiKeys"]:
        if k.get("name") == key_name:
            req("DELETE", "/api/api-keys/" + k["id"], token=token)
    new = req("POST", "/api/api-keys", {"name": key_name, "userId": u["id"], "isActive": True}, token=token)["apiKey"]["apiKey"]
    print(f"laib-secret: {secret}={new}")
    print(f"audiobookshelf: {secret} minted (" + ("replaces one ABS refuses" if have else "new") + "): " + then)

ok = lambda s: all(s.get(k) == v for k, v in WANT.items()) and "openid" in s.get("authActiveAuthMethods", [])
if ok(req("GET", "/api/auth-settings", token=token)):
    print("audiobookshelf: family login (OIDC via Authelia) unchanged")
    sys.exit(0)
req("PATCH", "/api/auth-settings", {"authActiveAuthMethods": ["local"]}, token=token)  # drops the cached client
req("PATCH", "/api/auth-settings", {**WANT, "authActiveAuthMethods": ["local", "openid"]}, token=token)
if not ok(req("GET", "/api/auth-settings", token=token)):
    print("audiobookshelf: the OIDC settings did not stick", file=sys.stderr); sys.exit(1)
print("audiobookshelf: family login (OIDC via Authelia) set from Laib's secret")
