[Unit]
Description=Audiobookshelf — Hörbücher und Podcasts

[Container]
Image=${IMAGE}
PublishPort=13378:80
Environment=TZ=${TZ}
Volume=${DATA_DIR}/audiobookshelf/config:/config:z
Volume=${DATA_DIR}/audiobookshelf/metadata:/metadata:z
# the shared file-share tree: never relabelled (:z walks it on every start and
# fails on an entry core does not own, #230); labelling off for this container
SecurityLabelDisable=true
Volume=${AUDIOBOOKS}:/audiobooks:ro
Volume=${PODCASTS}:/podcasts
# Authelia for the OIDC discovery and the token exchange: the host gateway is the
# host (Caddy on 443); under pasta the container has the host's own address, so
# the LAN IP would stay inside it (ServiceBay #817, #252)
AddHost=auth.${DOMAIN}:host-gateway
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always

[Install]
WantedBy=default.target
