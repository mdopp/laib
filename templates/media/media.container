[Unit]
Description=Jellyfin — Musik und Video (GPU transcoding)

[Container]
Image=${IMAGE}
PublishPort=8096:8096
Environment=TZ=${TZ}
Environment=JELLYFIN_PublishedServerUrl=https://media.${DOMAIN}
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
Volume=${DATA_DIR}/media/jellyfin-config:/config:z
Volume=${DATA_DIR}/media/jellyfin-cache:/cache:z
Volume=${MEDIA_ROOT}:/media:ro,z
AddHost=auth.${DOMAIN}:${LAN_IP}
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
