# media's detail line on the Box page (#785): media-check.py in a stock Python
# image, fed on stdin (as kalender-abgleich), in Jellyfin's own network
# namespace, so it asks Jellyfin on 127.0.0.1. It logs in as the admin, reads
# what the library holds and who has an account, logs out again, and writes
# the status file laib.yml declares. laib starts it when someone looks and the
# file is older than its stale; the timer every 15 minutes. The password
# reaches podman through the environment, never on argv.
[Unit]
Description=Jellyfin: Bestand und Konten für laibs Status
After=media.service

[Service]
Type=oneshot
Environment=JELLYFIN_PASSWORD=${ADMIN_PW}
StandardInput=file:%h/.config/containers/systemd/media/media-check.py
ExecStart=/usr/bin/podman run --rm -i --name media-check --network container:systemd-media --security-opt label=disable -e JELLYFIN_PASSWORD -e JELLYFIN_ADMIN=${ADMIN_USER} -e JELLYFIN_URL=http://127.0.0.1:8096 -e STATUS_DIR=/data -v ${DATA_DIR}/media/check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
