#!/usr/bin/env python3
"""media post-deploy (Jellyfin): finish the first-run wizard, the local
admin (break-glass), the libraries, and the family's login (#256), as on
ServiceBay: the LDAP-Authentication plugin against LLDAP, so everyone logs
in with their own account, gets a Jellyfin user on the first login (members
of admins become administrators) and has their own history and favourites;
Quick Connect on, so a phone app pairs with a six-digit code. Idempotent:
every step checks before it acts; the plugin's configuration is rewritten
on every apply, and Jellyfin restarts only when it changed or the plugin
was just installed.

The plugin binds with the read-only LLDAP account `jellyfin` the auth
template seeds (JELLYFIN_LDAP_PASSWORD), never the LLDAP admin (ServiceBay
bound as the admin). Only members of family and admins may log in, as on
Authelia's wildcard rule; the service accounts may not. Home Assistant gets
a Jellyfin account of its own, `homeassistant`, not an LLDAP one (#375). A new user sees the
libraries Laib made, plus the ones ServiceBay's configuration already gave
new users — not anyone's private library.

Music and video only (#646, docs/SERVICES.md): ServiceBay's twin libraries
("Music2" beside "Music", the same folders) go, and Hörbücher, Podcasts and
Radio go once the owner set SPOKEN_WORD=audiobookshelf and Audiobookshelf
and Music Assistant answer with them; until then they stay."""
import json, os, re, sys, time, urllib.parse, urllib.request, urllib.error

E = os.environ
BASE = E.get("JELLYFIN_URL", "http://127.0.0.1:8096")
ADMIN, ADMIN_PW = E.get("ADMIN_USER", "admin"), E["LAIB_SECRET_JELLYFIN_ADMIN_PASSWORD"]
LDAP_PW, DN = E["LAIB_SECRET_JELLYFIN_LDAP_PASSWORD"], E["BASE_DN"]
MEDIA_ROOT = E.get("MEDIA_ROOT", "/mnt/data/stacks/file-share/data")
XML = os.path.join(E["LAIB_DATA_DIR"], "media", "jellyfin-config", "plugins", "configurations", "LDAP-Auth.xml")
PLUGIN = "958aad6637844d2ab89aa7b6fab6e25c"   # jellyfin-plugin-ldapauth
# Jellyfin 12 reads the client id from Authorization only and answers 400 to X-Emby-Authorization (ServiceBay #3048)
CLIENT = 'MediaBrowser Client="laib", Device="laib", DeviceId="laib-post-deploy", Version="1"'
LIBRARIES = [("Musik", "music", "music"), ("Filme", "movies", "movies"), ("Serien", "tvshows", "tv")]
# #646: spoken word lives in Audiobookshelf, radio in Music Assistant. A Jellyfin library on these
# folders goes once the owner set SPOKEN_WORD=audiobookshelf AND its replacement answers with content
SPOKEN = E.get("SPOKEN_WORD") or "jellyfin"
ABS, MA = E.get("ABS_URL", "http://127.0.0.1:13378"), E.get("MA_URL", "http://127.0.0.1:8095")
ABS_KEY, MA_TOKEN = E.get("LAIB_SECRET_ABS_MA_TOKEN", ""), E.get("LAIB_SECRET_HA_MUSIC_ASSISTANT_TOKEN", "")
MOVED = {"/media/audiobooks": ("book", "/audiobooks", "Hörbücher"), "/media/podcasts": ("podcast", "/podcasts", "Podcasts"),
         "/media/radio": ("radio", None, "Radio")}


def req(method, path, body=None, token=None, raw=False):
    h = {"Content-Type": "application/json", "Authorization": CLIENT + (f', Token="{token}"' if token else "")}
    r = urllib.request.Request(BASE + path, data=json.dumps(body).encode() if body is not None else None, headers=h, method=method)
    for _ in range(60):  # while Jellyfin finishes its start it answers 503, /health already up (vm-install run 39031896537)
        try:
            with urllib.request.urlopen(r, timeout=20) as resp:
                data = resp.read()
                return data if raw else (json.loads(data) if data else None)
        except urllib.error.HTTPError as e:
            if e.code != 503:
                raise
            time.sleep(3)
    red(f"jellyfin answered {path} 503 for three minutes")


def red(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def up():
    """the server, not only /health: during its start Jellyfin answers /health and 503 elsewhere"""
    for _ in range(90):
        try:
            req("GET", "/health", raw=True)
            return req("GET", "/System/Info/Public")
        except Exception:
            time.sleep(2)
    red("jellyfin did not come up")


info = up()
# 1. the wizard, once
try:
    if not info.get("StartupWizardCompleted"):
        req("POST", "/Startup/Configuration", {"UICulture": "de", "MetadataCountryCode": "DE", "PreferredMetadataLanguage": "de"})
        req("GET", "/Startup/User")
        req("POST", "/Startup/User", {"Name": ADMIN, "Password": ADMIN_PW})
        req("POST", "/Startup/RemoteAccess", {"EnableRemoteAccess": True, "EnableAutomaticPortMapping": False})
        req("POST", "/Startup/Complete")
        print("wizard completed, admin created:", ADMIN)
except urllib.error.HTTPError as e:
    red(f"wizard step failed: {e.code}")

# 2. login as admin
token = req("POST", "/Users/AuthenticateByName", {"Username": ADMIN, "Pw": ADMIN_PW})["AccessToken"]

# 3. libraries for the folders that exist
have = {f["Name"] for f in req("GET", "/Library/VirtualFolders", token=token)}
for name, ctype, sub in LIBRARIES:
    path = os.path.join(MEDIA_ROOT, sub)
    if name in have or not os.path.isdir(path):
        continue
    req("POST", f"/Library/VirtualFolders?name={urllib.parse.quote(name)}&collectionType={ctype}&refreshLibrary=true",
        {"LibraryOptions": {"PathInfos": [{"Path": f"/media/{sub}"}], "EnableRealtimeMonitor": True}}, token=token)
    print("library created:", name)

# 3b. Musik watches its folder (#639): what the Musik-Eingang imports shows without a scan. A library
# made here has it from the start; one from ServiceBay or set by hand may not. Found by name or folder
for f in req("GET", "/Library/VirtualFolders", token=token):
    if f.get("Name") != "Musik" and "/media/music" not in (f.get("Locations") or []):
        continue
    opts = f.get("LibraryOptions") or {}
    if not opts.get("EnableRealtimeMonitor"):
        req("POST", "/Library/VirtualFolders/LibraryOptions", {"Id": f["ItemId"], "LibraryOptions": {**opts, "EnableRealtimeMonitor": True}}, token=token)
        print("realtime monitor on:", f.get("Name"))

# 3c. ServiceBay's twins (#646): it registered most libraries twice, "Music" and "Music2" on one folder,
# and a player's shuffle sees both. Strict: the name is the other's plus "2", the same kind, the same
# non-empty folders. Only Jellyfin's entry goes (DELETE /Library/VirtualFolders), never a file; whoever
# saw the twin sees the one that stays.
twins = {}  # removed id -> the id that stays
libs = req("GET", "/Library/VirtualFolders", token=token)
by_name = {f["Name"]: f for f in libs}
for f in libs:
    t = by_name.get(f["Name"][:-1]) if f["Name"].endswith("2") else None
    locs = sorted(f.get("Locations") or [])
    if not t or not locs or locs != sorted(t.get("Locations") or []) or f.get("CollectionType") != t.get("CollectionType"):
        continue
    req("DELETE", f"/Library/VirtualFolders?name={urllib.parse.quote(f['Name'])}&refreshLibrary=false", token=token)
    twins[f["ItemId"]] = t["ItemId"]
    print(f"library removed: {f['Name']} (a twin of {t['Name']}: {f.get('CollectionType')} on {', '.join(locs)}; Jellyfin's entry only, no file touched)")


def guard(kind, folder):
    """why the replacement of a Jellyfin library is not there yet, or "" when it answers with content"""
    try:
        if kind == "radio":
            if not MA_TOKEN:
                return "Music Assistant has handed out no token yet (laib add music-assistant)"
            r = urllib.request.Request(MA + "/api", data=json.dumps({"message_id": "laib", "command": "music/radios/count", "args": {}}).encode(),
                                       headers={"Content-Type": "application/json", "Authorization": "Bearer " + MA_TOKEN}, method="POST")
            with urllib.request.urlopen(r, timeout=20) as resp:
                n = json.loads(resp.read() or b"0")
            return "" if isinstance(n, int) and n > 0 else "Music Assistant holds no radio station yet (its post-deploy imports radio/*.m3u)"
        if not ABS_KEY:
            return "Audiobookshelf is not there yet (laib add audiobookshelf hands its key over)"
        get = lambda path: json.loads(urllib.request.urlopen(urllib.request.Request(ABS + path, headers={"Authorization": "Bearer " + ABS_KEY}), timeout=20).read())
        lib = next((l for l in get("/api/libraries")["libraries"] if l.get("mediaType") == kind
                    and folder in [x.get("fullPath") for x in l.get("folders") or []]), None)
        if not lib:
            return f"Audiobookshelf has no {kind} library on {folder}"
        return "" if get(f"/api/libraries/{lib['id']}/items?limit=1").get("total", 0) > 0 else f"Audiobookshelf's library on {folder} is still empty (scanning?)"
    except (OSError, ValueError) as e:
        return f"{'Music Assistant' if kind == 'radio' else 'Audiobookshelf'} does not answer: {e}"


# 3d. spoken word and radio leave Jellyfin (#646), only after their replacement is there: the owner's
# switch SPOKEN_WORD=audiobookshelf, then per library a live look at Audiobookshelf or Music Assistant.
# Never the other way round: the family is never without their audiobooks in between.
retired, held = set(), []
for f in req("GET", "/Library/VirtualFolders", token=token):
    locs = [x.rstrip("/") for x in f.get("Locations") or []]
    if not locs or not all(x in MOVED for x in locs):
        continue
    if SPOKEN != "audiobookshelf":
        print(f"library {f['Name']} stays in Jellyfin until SPOKEN_WORD=audiobookshelf (docs/SERVICES.md)")
        continue
    why = "; ".join(w for w in (guard(MOVED[x][0], MOVED[x][1]) for x in locs) if w)
    if why:
        held.append(f"{f['Name']}: {why}")
        continue
    req("DELETE", f"/Library/VirtualFolders?name={urllib.parse.quote(f['Name'])}&refreshLibrary=false", token=token)
    retired.add(f["ItemId"])
    print(f"library removed: {f['Name']} ({', '.join(MOVED[x][2] for x in locs)} live in "
          f"{'Music Assistant' if MOVED[locs[0]][0] == 'radio' else 'Audiobookshelf'} now; Jellyfin's entry only, no file touched)")

# whoever saw a removed twin sees the one that stays; an administrator sees all anyway
if twins:
    for u in req("GET", "/Users", token=token):
        pol = u.get("Policy") or {}
        have = pol.get("EnabledFolders") or []
        if pol.get("EnableAllFolders") or not any(i in twins for i in have):
            continue
        want = list(dict.fromkeys(twins.get(i, i) for i in have))
        req("POST", f"/Users/{u['Id']}/Policy", {**pol, "EnabledFolders": want}, token=token)
        print(f"jellyfin user {u['Name']} sees the libraries that stay instead of their twins")

# 4. Quick Connect
conf = req("GET", "/System/Configuration", token=token)
if not conf.get("QuickConnectAvailable"):
    conf["QuickConnectAvailable"] = True
    req("POST", "/System/Configuration", conf, token=token)
    print("Quick Connect on")

# 5. the LDAP plugin: installed, configured, loaded
plugin = lambda: next((p for p in req("GET", "/Plugins", token=token) if p.get("Id", "").replace("-", "") == PLUGIN), None)
restart = False
if not plugin():
    req("POST", "/Packages/Installed/LDAP%20Authentication?assemblyGuid=958aad66-3784-4d2a-b89a-a7b6fab6e25c", token=token)
    print("LDAP-Authentication plugin installed")
    restart = True
old = open(XML).read() if os.path.exists(XML) else ""
folders = re.findall(r"<string>([^<]+)</string>", (re.search(r"(?s)<EnabledFolders>(.*?)</EnabledFolders>", old) or [None, ""])[1])
folders = [i for i in dict.fromkeys(twins.get(i, i) for i in folders) if i not in retired]  # #646: no library that is gone
for f in req("GET", "/Library/VirtualFolders", token=token):
    if f["Name"] in {n for n, _, _ in LIBRARIES} and f["ItemId"] not in folders:
        folders.append(f["ItemId"])
esc = lambda s: s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
people, groups = "ou=people," + DN, "ou=groups," + DN
xml = f"""<?xml version="1.0" encoding="utf-8"?>
<!-- written by laib post-deploy (templates/media, #256) on every apply; edits here are overwritten -->
<PluginConfiguration xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <LdapServer>host.containers.internal</LdapServer>
  <LdapPort>3890</LdapPort>
  <UseSsl>false</UseSsl>
  <UseStartTls>false</UseStartTls>
  <SkipSslVerify>false</SkipSslVerify>
  <LdapBindUser>uid=jellyfin,{people}</LdapBindUser>
  <LdapBindPassword>{esc(LDAP_PW)}</LdapBindPassword>
  <LdapBaseDn>{people}</LdapBaseDn>
  <LdapSearchFilter>(&amp;(objectClass=person)(|(memberOf=cn=family,{groups})(memberOf=cn=admins,{groups})))</LdapSearchFilter>
  <LdapAdminBaseDn>{people}</LdapAdminBaseDn>
  <LdapAdminFilter>(memberOf=cn=admins,{groups})</LdapAdminFilter>
  <EnableLdapAdminFilterMemberUid>false</EnableLdapAdminFilterMemberUid>
  <LdapSearchAttributes>uid, mail</LdapSearchAttributes>
  <LdapUidAttribute>uid</LdapUidAttribute>
  <LdapUsernameAttribute>uid</LdapUsernameAttribute>
  <LdapPasswordAttribute>userPassword</LdapPasswordAttribute>
  <CreateUsersFromLdap>true</CreateUsersFromLdap>
  <AllowPassChange>false</AllowPassChange>
  <EnableAllFolders>false</EnableAllFolders>
  <EnabledFolders>{"".join(f"<string>{f}</string>" for f in folders)}</EnabledFolders>
</PluginConfiguration>
"""
if xml != old:
    os.makedirs(os.path.dirname(XML), exist_ok=True)
    with open(XML + ".tmp", "w") as f:
        f.write(xml)
    os.chmod(XML + ".tmp", 0o600)
    os.replace(XML + ".tmp", XML)
    print("LDAP-Authentication configured: LLDAP, bound read-only as jellyfin")
    restart = True
if restart:
    req("POST", "/System/Restart", token=token)
    print("jellyfin restarts to load the plugin")
p = None
for _ in range(90):  # a fresh install shows up after the restart, first as "Restart"
    try:
        if restart:
            token = req("POST", "/Users/AuthenticateByName", {"Username": ADMIN, "Pw": ADMIN_PW})["AccessToken"]
        p = plugin()
        if p and p.get("Status") not in (None, "Restart"):
            break
    except (OSError, urllib.error.HTTPError):
        pass  # down for the restart
    time.sleep(2)
if not p or p.get("Status") != "Active":
    red(f"the LDAP-Authentication plugin is not active ({p and p.get('Status')}): the family cannot log in with their accounts")

# 6. Home Assistant's own account (#375): a Jellyfin user, not an LLDAP one, so
# the LDAP filter stays family and admins, and no person's login sits in HA.
# Hidden from the login screen, no administrator, the family's libraries. Only
# when the owner set JELLYFIN_HA_PASSWORD (the same password goes into HA's
# Jellyfin entry); a new value is the account's new password.
HA_USER, HA_PW = "homeassistant", E.get("LAIB_SECRET_JELLYFIN_HA_PASSWORD", "")


def logs_in(user, pw):
    try:
        req("POST", "/Users/AuthenticateByName", {"Username": user, "Pw": pw})
        return True
    except urllib.error.HTTPError as e:
        if e.code != 401:
            raise
        return False


if HA_PW:
    u = next((u for u in req("GET", "/Users", token=token) if u["Name"] == HA_USER), None)
    if not u:
        u = req("POST", "/Users/New", {"Name": HA_USER, "Password": HA_PW}, token=token)
        print("jellyfin account created:", HA_USER, "(Home Assistant's)")
    elif not logs_in(HA_USER, HA_PW):
        req("POST", f"/Users/Password?userId={u['Id']}", {"NewPw": HA_PW}, token=token)
        print("jellyfin account", HA_USER, "has the password from JELLYFIN_HA_PASSWORD again")
    pol = u.get("Policy") or {}
    want = {**pol, "IsAdministrator": False, "IsHidden": True, "EnableAllFolders": False, "EnabledFolders": folders}
    if want != pol:
        req("POST", f"/Users/{u['Id']}/Policy", want, token=token)
    if not logs_in(HA_USER, HA_PW):
        red(f"the jellyfin account {HA_USER} does not log in with JELLYFIN_HA_PASSWORD: Home Assistant's entry gets 401")
    print(f"jellyfin account {HA_USER} logs in: Home Assistant's Jellyfin entry uses it")
if held:  # the owner switched, the replacement is not there: say so, never green while the libraries stay (#646)
    red("SPOKEN_WORD=audiobookshelf, but these stay in Jellyfin until their replacement answers: " + " | ".join(held))
print("jellyfin provisioned: the family logs in with LLDAP, Quick Connect on, local admin kept")
