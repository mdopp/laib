#!/usr/bin/env python3
"""llama pre-start: write the router's presets.ini from presets.json. The
router reads it once, when it starts (--models-preset), so it is on disk
before laib (re)starts llama (#512); the weights follow in post-deploy.
And lease/voice-device.env, when it is missing: Stimme's Whisper reads it
as a required EnvironmentFile (#557), and laib-lease writes it only on a
mode change. The lease's own gpu default; one it wrote is kept."""
import json, os

DATA = os.environ["LAIB_DATA_DIR"]
MODELS = os.path.join(DATA, "llama", "models")
here = os.path.dirname(os.path.abspath(__file__))
presets = json.load(open(os.path.join(here, "presets.json")))
os.makedirs(MODELS, exist_ok=True)

lines = []
for p in presets["presets"]:
    lines.append(f"[{p['alias']}]")
    lines.append(f"model = /models/{p['file']}")
    if p.get("draft"):
        lines += [f"model-draft = /models/{p['draft']}", "spec-type = draft-mtp", f"spec-draft-n-max = {p.get('draftMax', 4)}"]  # --draft-max is gone from llama.cpp (#423)
    if p.get("mmproj"):
        lines.append(f"mmproj = /models/{p['mmproj']}")
    lines.append(f"ctx-size = {p.get('ctx', 32768)}")
    # #501: no thinking unless the preset opts in; a request's chat_template_kwargs.enable_thinking still wins (the Bote's /model denken)
    lines.append(f"reasoning = {'on' if p.get('thinking') else 'off'}")
    # #525: prompt-eval knobs per preset, measured with measure.py; unset leaves llama.cpp's default
    for k, key in (("cacheK", "cache-type-k"), ("cacheV", "cache-type-v"), ("batch", "batch-size"), ("ubatch", "ubatch-size"),
                   ("ngl", "n-gpu-layers"), ("nCpuMoe", "n-cpu-moe"), ("parallel", "parallel")):
        if p.get(k) is not None:
            lines.append(f"{key} = {p[k]}")
    if p.get("flashAttn") is not None:  # true/false or "auto"
        fa = p["flashAttn"]
        lines.append(f"flash-attn = {fa if isinstance(fa, str) else ('on' if fa else 'off')}")
    lines.append("")
part = os.path.join(MODELS, "presets.ini.part")
with open(part, "w") as f:
    f.write("\n".join(lines))
os.replace(part, os.path.join(MODELS, "presets.ini"))
voice = os.path.join(DATA, "llama", "lease", "voice-device.env")
if not os.path.exists(voice):
    os.makedirs(os.path.dirname(voice), exist_ok=True)
    with open(voice, "w") as f:
        f.write("WHISPER_DEVICE=cuda\nTTS_DEVICE=cuda\n")   # internal/lease voiceDevice("gpu")
    print("voice-device.env written (gpu, until the lease says otherwise)")
print(f"presets.ini written for {len(presets['presets'])} presets")
