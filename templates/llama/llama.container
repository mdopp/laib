[Unit]
Description=llama-server router (laib role: model)
After=network-online.target

[Container]
Image=${IMAGE}
Network=host
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
Volume=${DATA_DIR}/llama/models:/models:z
# Router mode: one server holds every preset and loads the one a request
# names; the policy proxy in front decides which presets a mode allows.
# Router mode: presets come from /models/presets.ini, written by the post-deploy hook from presets.json.
Exec=--host 127.0.0.1 --port ${ROUTER_PORT} --models-dir /models --models-max 1 --models-preset /models/presets.ini
# no AutoUpdate: the image is pinned by tag and digest (ADR 0019 §4, #423); a new llama.cpp build is a proposal

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
