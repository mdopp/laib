#!/usr/bin/env python3
"""home-assistant pre-start: the configuration Home Assistant reads at start,
written before it starts, on every apply. Idempotent; the admin's own
configuration.yaml is only ever added to.

1. The family's Authelia login (#253; owner decision in #229). The custom
   component christiaangoossens/hass-oidc-auth, from the tag archive pinned by
   AUTH_OIDC_ARCHIVE and AUTH_OIDC_SHA256 (an update is a values change),
   installed under custom_components/auth_oidc; and packages/laib_auth_oidc.yaml,
   a file Laib owns whole. The client secret is not in it: the unit hands it
   to Home Assistant as AUTH_OIDC_SECRET (a podman secret), so a rotation
   restarts Home Assistant with the new one. Home Assistant's own login stays.
2. rest_command.mitteilung (#177, ADR 0022 §3): an automation's message to a
   person, delivered by the Bote's bote-notify on 127.0.0.1:8645 with the
   bearer from BOTE_NOTIFY_AUTH in Home Assistant's environment.
3. The packages include both need, in configuration.yaml; a fresh box gets
   Home Assistant's default configuration with it, so the first start has
   both.
4. The Z-Wave network keys (#664): zwave-js-ui's settings.json holds the
   S0/S2 keys, and ServiceBay left copies of it next to it
   (settings.json.servicebay, .sb-bak-…). Each is 0600 for the store's
   owner, the user the zwave container runs as (its root, which is the
   box's core); home-assistant-check names one that others can read.
5. The media sentences (#933): the house's stations, music by artist, a podcast by name and the volume (#1272),
   answered on the speakers of the room whose satellite heard them; and the automation that mutes what plays in a
   room while its satellite listens (#1272).
6. The tone for a wake nobody meant (owner 2026-11-14): www/laib/falsch.wav,
   served at /local/laib/falsch.wav; Frage plays it on the satellite instead
   of an answer (frage/gate.go). Computed, so every apply writes the same bytes."""
import hashlib, io, json, math, os, re, shutil, struct, sys, tarfile, urllib.request, wave

E = os.environ
C = os.path.join(E["LAIB_DATA_DIR"], "home-assistant", "homeassistant")
DOMAIN = E["LAIB_DOMAIN"]
INCLUDE = "packages: !include_dir_named packages"


def write(path, text):
    """only when it differs, so a second run changes nothing; text or bytes"""
    path, b = os.path.join(C, path), "b" if isinstance(text, bytes) else ""
    if os.path.exists(path) and open(path, "r" + b).read() == text:
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w" + b) as f:
        f.write(text)
    os.replace(path + ".tmp", path)
    return True


def red(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


# 1a. the component, from the pinned archive
comp = os.path.join(C, "custom_components", "auth_oidc")
stamp = os.path.join(comp, ".laib-archive")
want = E["AUTH_OIDC_SHA256"].lower()
if not (os.path.exists(stamp) and open(stamp).read().strip() == want):
    with urllib.request.urlopen(E["AUTH_OIDC_ARCHIVE"], timeout=120) as r:
        blob = r.read()
    if hashlib.sha256(blob).hexdigest() != want:
        red(f"auth_oidc: the archive {E['AUTH_OIDC_ARCHIVE']} is not the pinned one (SHA-256 differs): nothing installed")
    new = comp + ".new"
    shutil.rmtree(new, ignore_errors=True)
    with tarfile.open(fileobj=io.BytesIO(blob)) as tf:
        for m in tf.getmembers():
            parts = m.name.split("/", 3)
            rel = os.path.normpath(parts[3]) if len(parts) == 4 and parts[1:3] == ["custom_components", "auth_oidc"] else ""
            if m.isfile() and rel and not rel.startswith(("..", "/")):  # files only: no links, nothing outside
                os.makedirs(os.path.dirname(os.path.join(new, rel)), exist_ok=True)
                with open(os.path.join(new, rel), "wb") as f:
                    f.write(tf.extractfile(m).read())
    if not os.path.exists(os.path.join(new, "manifest.json")):
        red("auth_oidc: the archive holds no custom_components/auth_oidc/manifest.json")
    with open(os.path.join(new, ".laib-archive"), "w") as f:
        f.write(want + "\n")
    shutil.rmtree(comp + ".old", ignore_errors=True)
    if os.path.exists(comp):
        os.rename(comp, comp + ".old")
    os.rename(new, comp)
    shutil.rmtree(comp + ".old", ignore_errors=True)
    print("auth_oidc installed from", E["AUTH_OIDC_ARCHIVE"])

# 1b. the block, as a package Laib owns
write("packages/laib_auth_oidc.yaml", f"""# rendered by laib pre-start (templates/home-assistant, #253); do not edit by hand
auth_oidc:
  client_id: homeassistant
  client_secret: !env_var AUTH_OIDC_SECRET
  discovery_url: https://auth.{DOMAIN}/.well-known/openid-configuration
  display_name: Familienkonto                 # the button reads "Login with Familienkonto"
  features:
    automatic_user_linking: true      # an existing Home Assistant user with the LLDAP name is that person
    automatic_person_creation: true
  roles:
    admin: admins
    user: family
""")

# 2. rest_command.mitteilung
write("packages/laib_mitteilung.yaml", f"""# rendered by laib pre-start (templates/home-assistant, #177); do not edit by hand
rest_command:
  mitteilung:
    url: "{E.get("BOTE_NOTIFY_URL") or "http://127.0.0.1:8645/mitteilung"}"
    method: post
    content_type: application/json
    headers:
      Authorization: !env_var BOTE_NOTIFY_AUTH
    payload: '{{"an": {{{{ an | tojson }}}}, "text": {{{{ text | tojson }}}}}}'
    timeout: 60
""")

# 3. configuration.yaml
Y = os.path.join(C, "configuration.yaml")
if not os.path.exists(Y):
    for f, empty in (("automations.yaml", "[]\n"), ("scripts.yaml", ""), ("scenes.yaml", "")):
        if not os.path.exists(os.path.join(C, f)):
            write(f, empty)
    write("configuration.yaml", f"""# written by laib pre-start (templates/home-assistant) because there was none: yours from here on
default_config:

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

homeassistant:
  {INCLUDE}
""")
    print("configuration.yaml written: Home Assistant's defaults and the packages include")
text = open(Y).read()
if re.search(r"(?m)^\s+" + re.escape(INCLUDE) + r"\s*$", text):
    pass
elif re.search(r"(?m)^\s*packages:", text):
    red("configuration.yaml loads packages from elsewhere: add '" + INCLUDE + "' for laib's packages (the family login and "
        "rest_command.mitteilung are in them)")
elif m := re.search(r"(?m)^homeassistant:[ \t]*(#.*)?\n", text):
    nxt = re.search(r"(?m)^([ \t]+)\S", text[m.end():])
    indent = nxt.group(1) if nxt and nxt.start() == 0 else "  "
    text = text[:m.end()] + indent + INCLUDE + "\n" + text[m.end():]
elif re.search(r"(?m)^homeassistant:", text):
    red("configuration.yaml's homeassistant: is not a plain block: add '" + INCLUDE + "' under it by hand")
else:
    text = text.rstrip("\n") + "\n\n# added by laib (templates/home-assistant): its packages\nhomeassistant:\n  " + INCLUDE + "\n"
if write("configuration.yaml", text):
    print("configuration.yaml: laib's packages included")
# 4. the Z-Wave network keys: settings.json and its copies, and users.json (the UI login's hash), the store's owner's alone
Z = os.path.join(E["LAIB_DATA_DIR"], "home-assistant", "zwave-js")
if os.path.isdir(Z):
    own = os.stat(Z)
    for f in sorted(os.listdir(Z)):
        p = os.path.join(Z, f)
        if not (f in ("settings.json", "users.json") or f.startswith("settings.json.")) or os.path.islink(p) or not os.path.isfile(p):
            continue
        st = os.stat(p)
        if (st.st_uid, st.st_gid) != (own.st_uid, own.st_gid):
            os.chown(p, own.st_uid, own.st_gid)
        if st.st_mode & 0o777 != 0o600:
            os.chmod(p, 0o600)
            print(f"zwave-js/{f}: 0600 (the Z-Wave keys or login, #664; was {st.st_mode & 0o777:04o})")
# 5. the media sentences (#933, ADR 0015 check 1)
WORDS = dict(zip("0123456789", ("null", "eins", "zwei", "drei", "vier", "fünf", "sechs", "sieben", "acht", "neun")))


def spoken(name):
    """how a station's name is said and written by Whisper: as it is, digits as words joined and apart
    („1LIVE“: „Einslive“, „eins live“), without hassil's template characters"""
    plain = re.sub(r"\s+", " ", re.sub(r"[^\w\s&'.-]", " ", re.sub(r"\([^)]*\)", " ", name))).strip()
    out = [plain]
    if re.search(r"\d", plain):
        apart = re.sub(r"\s+", " ", re.sub(r"\d", lambda m: " " + WORDS[m.group()] + " ", plain)).strip()
        out += [apart] + ([apart.replace(" ", "").capitalize()] if " " not in plain else [])
        # the digit kept but apart from the word: Whisper wrote „Spieler 1 live.“ (2026-10-31)
        out.append(re.sub(r"\s+", " ", re.sub(r"(?<=\d)(?=[^\W\d])|(?<=[^\W\d])(?=\d)", " ", plain)).strip())
    return [x for i, x in enumerate(out) if x and x.lower() not in (y.lower() for y in out[:i])]


def stations():
    """the house's stations, as Music Assistant takes them from the share's radio/ (#646): a .strm by its
    file's name, an .m3u by its #EXTINF names"""
    d, names = os.path.join(E["LAIB_DATA_DIR"], "file-share", "data", "radio"), []
    for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if f.endswith(".strm"):
            names.append(f[:-5])
        elif f.endswith(".m3u"):
            with open(os.path.join(d, f), errors="replace") as m3u:
                names += [l.rsplit(",", 1)[1].strip() for l in m3u if l.startswith("#EXTINF") and "," in l]
    return [n for i, n in enumerate(names) if n and n not in names[:i]]


SAY = "(spielen|abspielen|anmachen|einschalten)"
# „Spiele“ as Whisper writes it: „Spieler 1 live.“ (2026-10-31), „Spiel …“, „Spielt …“
PLAY = "(spiel|spiele|spieler|spielt)"
PROZENT = "{laib_prozent}[ ][Prozent|%]"
intents = {"LaibMusik": {"data": [{"sentences": [PLAY + " (Musik|Lieder|Songs|[et]was) (von|vom) {laib_kuenstler}",
                                                 "(Musik|Lieder|Songs|[et]was) (von|vom) {laib_kuenstler} " + SAY]}]},
           # #1272: a podcast by its name; „die aktuelle“ needs no „Podcast“ („Spiele die aktuelle Lage der Nation“)
           "LaibPodcast": {"data": [{"sentences": [
               PLAY + " [den ]Podcast {laib_podcast}",
               PLAY + " (die|den) (aktuelle|aktuellen|neueste|neuesten|letzte) [Folge [(von|vom Podcast) ]]{laib_podcast}"]}]},
           # #1272: the volume, to a value or a step; laib_richtung says which, the script reads it
           "LaibLautstaerke": {"data": [
               {"sentences": ["[(stell|stelle) ][die ]Lautstärke auf " + PROZENT, "(mach|mache) [es ]auf {laib_prozent}[ ](Prozent|%)"],
                "slots": {"laib_richtung": "auf"}},
               {"sentences": ["[(mach|mache) ][(es|die Musik) ]lauter", "[die ]Lautstärke um " + PROZENT + " erhöhen"],
                "slots": {"laib_richtung": "lauter"}},
               {"sentences": ["[(mach|mache) ][(es|die Musik) ]leiser", "[die ]Lautstärke um " + PROZENT + " (reduzieren|verringern)"],
                "slots": {"laib_richtung": "leiser"}}]}}
lists = {"laib_kuenstler": {"wildcard": True}, "laib_podcast": {"wildcard": True}, "laib_prozent": {"range": {"from": 0, "to": 100}}}
if names := stations():
    intents["LaibRadio"] = {"data": [{"sentences": [PLAY + " [(den Sender|das Radio|Radio) ]{laib_sender}",
                                                    "[(den Sender|das Radio|Radio) ]{laib_sender} " + SAY]}]}
    said, values = set(), []
    for n in names:   # a name said once: the first station that has it takes it
        if forms := [x for x in spoken(n) if x.lower() not in said]:
            said |= {x.lower() for x in forms}
            values.append({"in": "(" + "|".join(forms) + ")", "out": n})
    lists["laib_sender"] = {"values": values}
changed = write("custom_sentences/de/laib_medien.yaml", "# rendered by laib pre-start (templates/home-assistant, #933); do not edit by hand\n"
                + json.dumps({"language": "de", "intents": intents, "lists": lists}, ensure_ascii=False, indent=2) + "\n")
# the player: the area's standard speaker, Music Assistant's player in the satellite's area with HA's label
# „Standard-Lautsprecher“ (set in Homes' Geräte or in HA, owner 2026-11-12), else Music Assistant's in the area, else
# one named like the area (MA's players have no area of their own: media_player.wohnzimmer_2 is the Wohnzimmer's),
# else none, and the answer says so. The satellite's own answer stays on the satellite: only the music goes there.
STANDARD = "Standard-Lautsprecher"
MA = "{% set ma = integration_entities('music_assistant') | select('match', 'media_player[.]') | list %}"
AREA = "{% set a = preferred_area_id | default('', true) %}"   # the area of the satellite that heard it
STD = ("{% set std = (label_entities('" + STANDARD + "') | select('in', ma) | select('in', area_entities(a)) | list) if a else [] %}"
       "{% set player = (std + (ma | select('in', area_entities(a)) | list) + (ma | select('search', a) | list) if a else []) | first | default('') %}")
PLAYER = MA + AREA + STD + "{{ player }}"
# #1272, the room's speakers: every media player in the area `a` (and Music Assistant's named like it), never a
# satellite's own. Those are the players of a device that has an assist_satellite, and the ones named after that
# device (a Voice PE is media_player.<device> once more as Music Assistant's player, on a device of its own);
# a satellite named like a room has no such twin, the room's players keep that name. Needs `ma` and `a`.
ROOM = ("{% set ns = namespace(own=[]) %}"
        "{% for d in states.assist_satellite | map(attribute='entity_id') | map('device_id') | select('string') | unique %}"
        "{% set n = device_attr(d, 'name') | default('', true) | slugify %}"
        "{% set ns.own = ns.own + device_entities(d) + (states.media_player | map(attribute='entity_id')"
        " | select('match', 'media_player[.]' ~ n ~ '(_|$)') | list if n and n not in areas() else []) %}"
        "{% endfor %}"
        "{% set room = ((area_entities(a) | select('match', 'media_player[.]') | list) + (ma | select('search', a) | list) if a else [])"
        " | unique | reject('in', ns.own) | list %}")
# whose volume: what plays in the room, Music Assistant's players alone when one of them plays (the same speaker is
# often there twice, as a cast player too: a step must not count twice), else the standard speaker as PLAYER picks
# it. [[player, percent], …], 0 to 100
ZIELE = (MA + AREA + STD + ROOM + "{% set on = room | select('is_state', 'playing') | list %}"
         "{% set step = laib_prozent | default(10) | int(10) %}{% set z = namespace(l=[]) %}"
         "{% for p in (on | select('in', ma) | list) or on or ([player] if player else []) %}"
         "{% set now = ((state_attr(p, 'volume_level') | float(0)) * 100) | round | int %}"
         "{% set z.l = z.l + [[p, ([0, step if laib_richtung == 'auf' else now + step if laib_richtung == 'lauter' else now - step, 100] | sort)[1]]] %}"
         "{% endfor %}{{ z.l }}")
# what goes quiet while a satellite listens: what plays in its room and is not muted already
STUMM = (MA + "{% set a = area_id(trigger.entity_id) | default('', true) %}" + ROOM
         + "{{ room | select('is_state', 'playing') | reject('is_state_attr', 'is_volume_muted', true) | list }}")
NONE = "Ich finde hier keinen Lautsprecher."


def play(slot, kind, said):
    return f"""    action:
      - variables:
          player: "{PLAYER}"
      - if: "{{{{ player != '' }}}}"
        then:
          - action: music_assistant.play_media
            target:
              entity_id: "{{{{ player }}}}"
            data:
              media_id: "{{{{ {slot} }}}}"
              media_type: {kind}
              enqueue: replace
      - variables:
          result:
            player: "{{{{ player }}}}"
      - stop: ""
        response_variable: result
    speech:
      text: "{{{{ ('{said} ' ~ {slot} ~ '.') if action_response.player else '{NONE}' }}}}"
"""


def each(of, service, data):
    """one call per player, so one that fails does not keep the others from theirs"""
    return f"""      - repeat:
          for_each: "{{{{ {of} }}}}"
          sequence:
            - action: media_player.{service}
              continue_on_error: true
              target:
                entity_id: "{{{{ repeat.item{'[0]' if of == 'ziele' else ''} }}}}"
              data:
                {data}
"""


SET = each("ziele", "volume_set", 'volume_level: "{{ repeat.item[1] / 100 }}"')
VOLUME = f"""    action:
      - variables:
          ziele: "{ZIELE}"
{SET}      - variables:
          result:
            ziele: "{{{{ ziele }}}}"
      - stop: ""
        response_variable: result
    speech:
      text: "{{{{ ('Lautstärke ' ~ action_response.ziele[0][1] ~ ' Prozent.') if action_response.ziele else '{NONE}' }}}}"
"""


def satellites():
    """the assist satellites Home Assistant knows, from its entity registry (read before it starts): a state trigger
    names its entities, there is none for a whole domain. A new satellite is in it on the next apply."""
    try:
        with open(os.path.join(C, ".storage", "core.entity_registry"), encoding="utf-8") as f:
            reg = json.load(f)["data"]["entities"]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    return sorted(e["entity_id"] for e in reg if isinstance(e, dict) and str(e.get("entity_id", "")).startswith("assist_satellite.")
                  and re.fullmatch(r"[a-z0-9_.]+", e["entity_id"]) and not e.get("disabled_by"))


def mute(sats):
    """#1272: while a satellite listens, what plays in its room is muted, and exactly that unmuted when it stops
    listening or after 20 s; a run per satellite, side by side"""
    return f"""automation:
  - id: laib_stumm_beim_zuhoeren
    alias: "Laib: Lautsprecher im Raum stumm, solange das Sprachgerät zuhört"
    mode: parallel
    max: 10
    trigger:
      - platform: state
        entity_id:
{"".join(f"          - {s}{chr(10)}" for s in sats)}        to: listening
    variables:
      stumm: "{STUMM}"
    condition:
      - condition: template
        value_template: "{{{{ stumm | count > 0 }}}}"
    action:
{each("stumm", "volume_mute", "is_volume_muted: true")}      - wait_template: "{{{{ not is_state(trigger.entity_id, 'listening') }}}}"
        timeout: 20
{each("stumm", "volume_mute", "is_volume_muted: false")}"""


sats = satellites()
changed = write("packages/laib_medien.yaml", "# rendered by laib pre-start (templates/home-assistant, #933, #1272); do not edit by hand\nintent_script:\n"
                + "  LaibRadio:\n" + play("laib_sender", "radio", "Ich spiele")
                + "  LaibMusik:\n" + play("laib_kuenstler", "artist", "Ich spiele Musik von")
                + "  LaibPodcast:\n" + play("laib_podcast", "podcast", "Ich spiele den Podcast")
                + "  LaibLautstaerke:\n" + VOLUME + (mute(sats) if sats else "")) or changed
if changed:
    write(".laib-sentences-changed", "")   # post-deploy reloads them once (#933)
    print("custom_sentences/de/laib_medien.yaml: " + (f"{len(names)} Sender" if names else "keine Sender auf der Freigabe")
          + f", Musik von …, Podcast …, Lautstärke; stumm beim Zuhören für {len(sats)} Sprachgerät(e)")


def tone(rate=16000):
    """„düü-doow“, 0.4 s, quiet: D5, then A4 falling to G4; a soft start and end, so it does not click"""
    pcm = bytearray()
    for f0, f1, sec in ((587.33, 587.33, 0.15), (440.0, 392.0, 0.25)):
        n, phase = int(rate * sec), 0.0
        for i in range(n):
            phase += 2 * math.pi * (f0 + (f1 - f0) * i / n) / rate
            pcm += struct.pack("<h", round(0.18 * 32767 * min(1, i / (0.01 * rate), (n - i) / (0.05 * rate)) * math.sin(phase)))
    out = io.BytesIO()
    with wave.open(out, "wb") as w:
        w.setnchannels(1), w.setsampwidth(2), w.setframerate(rate), w.writeframes(bytes(pcm))
    return out.getvalue()


# 6. the tone (HA serves www/ at /local/ when the folder is there at its start: pre-start runs before it)
if write("www/laib/falsch.wav", tone()):
    print("www/laib/falsch.wav: the tone for a wake nobody meant")
print("home-assistant: family login (auth_oidc via Authelia), rest_command.mitteilung, the media sentences and the tone in place")
