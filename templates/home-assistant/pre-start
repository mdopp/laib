#!/usr/bin/env python3
"""home-assistant pre-start: the configuration Home Assistant reads at start,
written before it starts, on every apply. Idempotent; the admin's own
configuration.yaml is only ever added to.

1. The family's Authelia login (#253; owner decision in #229). The custom
   component christiaangoossens/hass-oidc-auth, from the tag archive pinned by
   AUTH_OIDC_ARCHIVE and AUTH_OIDC_SHA256 (an update is a values change),
   installed under custom_components/auth_oidc; and packages/laib_auth_oidc.yaml,
   a file Laib owns whole. The client secret is not in it: the unit hands it
   to Home Assistant as AUTH_OIDC_SECRET (a podman secret), so a rotation
   restarts Home Assistant with the new one. Home Assistant's own login stays.
2. rest_command.mitteilung (#177, ADR 0022 §3): an automation's message to a
   person, delivered by the Bote's bote-notify on 127.0.0.1:8645 with the
   bearer from BOTE_NOTIFY_AUTH in Home Assistant's environment.
3. The packages include both need, in configuration.yaml; a fresh box gets
   Home Assistant's default configuration with it, so the first start has
   both.
4. The Z-Wave network keys (#664): zwave-js-ui's settings.json holds the
   S0/S2 keys, and ServiceBay left copies of it next to it
   (settings.json.servicebay, .sb-bak-…). Each is 0600 for the store's
   owner, the user the zwave container runs as (its root, which is the
   box's core); home-assistant-check names one that others can read."""
import hashlib, io, json, os, re, shutil, sys, tarfile, urllib.request

E = os.environ
C = os.path.join(E["LAIB_DATA_DIR"], "home-assistant", "homeassistant")
DOMAIN = E["LAIB_DOMAIN"]
INCLUDE = "packages: !include_dir_named packages"


def write(path, text):
    """only when it differs, so a second run changes nothing"""
    path = os.path.join(C, path)
    if os.path.exists(path) and open(path).read() == text:
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)
    return True


def red(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


# 1a. the component, from the pinned archive
comp = os.path.join(C, "custom_components", "auth_oidc")
stamp = os.path.join(comp, ".laib-archive")
want = E["AUTH_OIDC_SHA256"].lower()
if not (os.path.exists(stamp) and open(stamp).read().strip() == want):
    with urllib.request.urlopen(E["AUTH_OIDC_ARCHIVE"], timeout=120) as r:
        blob = r.read()
    if hashlib.sha256(blob).hexdigest() != want:
        red(f"auth_oidc: the archive {E['AUTH_OIDC_ARCHIVE']} is not the pinned one (SHA-256 differs): nothing installed")
    new = comp + ".new"
    shutil.rmtree(new, ignore_errors=True)
    with tarfile.open(fileobj=io.BytesIO(blob)) as tf:
        for m in tf.getmembers():
            parts = m.name.split("/", 3)
            rel = os.path.normpath(parts[3]) if len(parts) == 4 and parts[1:3] == ["custom_components", "auth_oidc"] else ""
            if m.isfile() and rel and not rel.startswith(("..", "/")):  # files only: no links, nothing outside
                os.makedirs(os.path.dirname(os.path.join(new, rel)), exist_ok=True)
                with open(os.path.join(new, rel), "wb") as f:
                    f.write(tf.extractfile(m).read())
    if not os.path.exists(os.path.join(new, "manifest.json")):
        red("auth_oidc: the archive holds no custom_components/auth_oidc/manifest.json")
    with open(os.path.join(new, ".laib-archive"), "w") as f:
        f.write(want + "\n")
    shutil.rmtree(comp + ".old", ignore_errors=True)
    if os.path.exists(comp):
        os.rename(comp, comp + ".old")
    os.rename(new, comp)
    shutil.rmtree(comp + ".old", ignore_errors=True)
    print("auth_oidc installed from", E["AUTH_OIDC_ARCHIVE"])

# 1b. the block, as a package Laib owns
write("packages/laib_auth_oidc.yaml", f"""# rendered by laib pre-start (templates/home-assistant, #253); do not edit by hand
auth_oidc:
  client_id: homeassistant
  client_secret: !env_var AUTH_OIDC_SECRET
  discovery_url: https://auth.{DOMAIN}/.well-known/openid-configuration
  display_name: Familienkonto                 # the button reads "Login with Familienkonto"
  features:
    automatic_user_linking: true      # an existing Home Assistant user with the LLDAP name is that person
    automatic_person_creation: true
  roles:
    admin: admins
    user: family
""")

# 2. rest_command.mitteilung
write("packages/laib_mitteilung.yaml", f"""# rendered by laib pre-start (templates/home-assistant, #177); do not edit by hand
rest_command:
  mitteilung:
    url: "{E.get("BOTE_NOTIFY_URL") or "http://127.0.0.1:8645/mitteilung"}"
    method: post
    content_type: application/json
    headers:
      Authorization: !env_var BOTE_NOTIFY_AUTH
    payload: '{{"an": {{{{ an | tojson }}}}, "text": {{{{ text | tojson }}}}}}'
    timeout: 60
""")

# 3. configuration.yaml
Y = os.path.join(C, "configuration.yaml")
if not os.path.exists(Y):
    for f, empty in (("automations.yaml", "[]\n"), ("scripts.yaml", ""), ("scenes.yaml", "")):
        if not os.path.exists(os.path.join(C, f)):
            write(f, empty)
    write("configuration.yaml", f"""# written by laib pre-start (templates/home-assistant) because there was none: yours from here on
default_config:

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

homeassistant:
  {INCLUDE}
""")
    print("configuration.yaml written: Home Assistant's defaults and the packages include")
text = open(Y).read()
if re.search(r"(?m)^\s+" + re.escape(INCLUDE) + r"\s*$", text):
    pass
elif re.search(r"(?m)^\s*packages:", text):
    red("configuration.yaml loads packages from elsewhere: add '" + INCLUDE + "' for laib's packages (the family login and "
        "rest_command.mitteilung are in them)")
elif m := re.search(r"(?m)^homeassistant:[ \t]*(#.*)?\n", text):
    nxt = re.search(r"(?m)^([ \t]+)\S", text[m.end():])
    indent = nxt.group(1) if nxt and nxt.start() == 0 else "  "
    text = text[:m.end()] + indent + INCLUDE + "\n" + text[m.end():]
elif re.search(r"(?m)^homeassistant:", text):
    red("configuration.yaml's homeassistant: is not a plain block: add '" + INCLUDE + "' under it by hand")
else:
    text = text.rstrip("\n") + "\n\n# added by laib (templates/home-assistant): its packages\nhomeassistant:\n  " + INCLUDE + "\n"
if write("configuration.yaml", text):
    print("configuration.yaml: laib's packages included")
# 4. the Z-Wave network keys: settings.json and its copies, and users.json (the UI login's hash), the store's owner's alone
Z = os.path.join(E["LAIB_DATA_DIR"], "home-assistant", "zwave-js")
if os.path.isdir(Z):
    own = os.stat(Z)
    for f in sorted(os.listdir(Z)):
        p = os.path.join(Z, f)
        if not (f in ("settings.json", "users.json") or f.startswith("settings.json.")) or os.path.islink(p) or not os.path.isfile(p):
            continue
        st = os.stat(p)
        if (st.st_uid, st.st_gid) != (own.st_uid, own.st_gid):
            os.chown(p, own.st_uid, own.st_gid)
        if st.st_mode & 0o777 != 0o600:
            os.chmod(p, 0o600)
            print(f"zwave-js/{f}: 0600 (the Z-Wave keys or login, #664; was {st.st_mode & 0o777:04o})")
# 5. the media sentences (#933, ADR 0015 check 1)
WORDS = dict(zip("0123456789", ("null", "eins", "zwei", "drei", "vier", "fünf", "sechs", "sieben", "acht", "neun")))


def spoken(name):
    """how a station's name is said and written by Whisper: as it is, digits as words joined and apart
    („1LIVE“: „Einslive“, „eins live“), without hassil's template characters"""
    plain = re.sub(r"\s+", " ", re.sub(r"[^\w\s&'.-]", " ", re.sub(r"\([^)]*\)", " ", name))).strip()
    out = [plain]
    if re.search(r"\d", plain):
        apart = re.sub(r"\s+", " ", re.sub(r"\d", lambda m: " " + WORDS[m.group()] + " ", plain)).strip()
        out += [apart] + ([apart.replace(" ", "").capitalize()] if " " not in plain else [])
    return [x for i, x in enumerate(out) if x and x.lower() not in (y.lower() for y in out[:i])]


def stations():
    """the house's stations, as Music Assistant takes them from the share's radio/ (#646): a .strm by its
    file's name, an .m3u by its #EXTINF names"""
    d, names = os.path.join(E["LAIB_DATA_DIR"], "file-share", "data", "radio"), []
    for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if f.endswith(".strm"):
            names.append(f[:-5])
        elif f.endswith(".m3u"):
            with open(os.path.join(d, f), errors="replace") as m3u:
                names += [l.rsplit(",", 1)[1].strip() for l in m3u if l.startswith("#EXTINF") and "," in l]
    return [n for i, n in enumerate(names) if n and n not in names[:i]]


SAY = "(spielen|abspielen|anmachen|einschalten)"
intents = {"LaibMusik": {"data": [{"sentences": ["spiel[e] (Musik|Lieder|Songs|[et]was) (von|vom) {laib_kuenstler}",
                                                 "(Musik|Lieder|Songs|[et]was) (von|vom) {laib_kuenstler} " + SAY]}]}}
lists = {"laib_kuenstler": {"wildcard": True}}
if names := stations():
    intents["LaibRadio"] = {"data": [{"sentences": ["spiel[e] [(den Sender|das Radio|Radio) ]{laib_sender}",
                                                    "[(den Sender|das Radio|Radio) ]{laib_sender} " + SAY]}]}
    said, values = set(), []
    for n in names:   # a name said once: the first station that has it takes it
        if forms := [x for x in spoken(n) if x.lower() not in said]:
            said |= {x.lower() for x in forms}
            values.append({"in": "(" + "|".join(forms) + ")", "out": n})
    lists["laib_sender"] = {"values": values}
changed = write("custom_sentences/de/laib_medien.yaml", "# rendered by laib pre-start (templates/home-assistant, #933); do not edit by hand\n"
                + json.dumps({"language": "de", "intents": intents, "lists": lists}, ensure_ascii=False, indent=2) + "\n")
# the player: Music Assistant's in the satellite's area, else one named like the area (MA's players have no area of
# their own: media_player.wohnzimmer_2 is the Wohnzimmer's), else none, and the answer says so
PLAYER = ("{% set ma = integration_entities('music_assistant') | select('match', 'media_player[.]') | list %}"
          "{% set a = preferred_area_id | default('', true) %}"
          "{{ ((ma | select('in', area_entities(a)) | list) + (ma | select('search', a) | list) if a else []) | first | default('') }}")


def play(slot, kind, said):
    return f"""    action:
      - variables:
          player: "{PLAYER}"
      - if: "{{{{ player != '' }}}}"
        then:
          - action: music_assistant.play_media
            target:
              entity_id: "{{{{ player }}}}"
            data:
              media_id: "{{{{ {slot} }}}}"
              media_type: {kind}
              enqueue: replace
      - variables:
          result:
            player: "{{{{ player }}}}"
      - stop: ""
        response_variable: result
    speech:
      text: "{{{{ ('{said} ' ~ {slot} ~ '.') if action_response.player else 'Ich finde hier keinen Lautsprecher.' }}}}"
"""


changed = write("packages/laib_medien.yaml", "# rendered by laib pre-start (templates/home-assistant, #933); do not edit by hand\nintent_script:\n"
                + "  LaibRadio:\n" + play("laib_sender", "radio", "Ich spiele")
                + "  LaibMusik:\n" + play("laib_kuenstler", "artist", "Ich spiele Musik von")) or changed
if changed:
    write(".laib-sentences-changed", "")   # post-deploy reloads them once (#933)
    print("custom_sentences/de/laib_medien.yaml: " + (f"{len(names)} Sender" if names else "keine Sender auf der Freigabe") + ", Musik von …")
print("home-assistant: family login (auth_oidc via Authelia), rest_command.mitteilung and the media sentences in place")
