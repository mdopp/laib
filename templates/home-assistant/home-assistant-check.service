# laib's look at Home Assistant's integrations (#55, #309): the script runs
# inside the running Home Assistant container and writes the status file
# laib.yml declares. laib starts this when someone looks at diag or the Box
# page and the file is older than five minutes; the timer once an hour.
# The token reaches podman through the environment, never on argv.
[Unit]
Description=Home Assistant: check the integrations for laib's status
After=home-assistant.service

[Service]
Type=oneshot
Environment=HA_TOKEN=${HA_TOKEN}
# the service's name for the HA_INSTALL proposal its update findings carry (#528)
Environment=LAIB_SERVICE=${SERVICE}
# Music Assistant set up, with Jellyfin's titles and players (#526); empty without Music Assistant
Environment=MA_TOKEN=${MA_TOKEN}
# the house persona's Assist pipeline (#634): its name, wake word and phrase. A persona change changes
# this unit, so laib applies home-assistant again and post-deploy moves the pipeline
Environment=VOICE_PERSONA=${PERSONA_DISPLAY}
Environment=VOICE_WAKEWORD=${PERSONA_WAKEWORD}
Environment="VOICE_PHRASE=${PERSONA_PHRASE}"
# the satellites' end of speech post-deploy sets (VOICE_VAD); here so a change applies the hook again
Environment=VOICE_VAD=${VOICE_VAD}
Environment="VOICE_WAKE_FALLBACK=${VOICE_WAKE_FALLBACK}"
# zwave-js-ui's driver health (#417): not ready fails this unit, and laib status shows home-assistant red
Environment=ZWAVE_URL=http://127.0.0.1:8091
StandardInput=file:%h/.config/containers/systemd/home-assistant/home-assistant-check.py
# only where the box runs Z-Wave JS: a template without the zwave unit (no stick) checks no Z-Wave
# the Z-Wave network keys others can read (#664): the store is not in the Home Assistant container, so the host looks
ExecStart=/bin/sh -c 'test -f %h/.config/containers/systemd/home-assistant/home-assistant-zwave.container || unset ZWAVE_URL; export ZWAVE_OPEN_KEYS="$$(find ${DATA_DIR}/home-assistant/zwave-js -maxdepth 1 -type f -name "settings.json*" -perm /077 -printf "%%f " 2>/dev/null)"; exec /usr/bin/podman exec -i -e HA_TOKEN -e LAIB_SERVICE -e MA_TOKEN -e ZWAVE_URL -e ZWAVE_OPEN_KEYS -e VOICE_PERSONA -e VOICE_WAKEWORD -e VOICE_PHRASE systemd-home-assistant python3 -'
TimeoutStartSec=60
