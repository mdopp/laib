[Unit]
Description=Z-Wave JS UI
After=network-online.target

[Container]
Image=${ZWAVE_IMAGE}
# host network: only so Home Assistant and Caddy reach it on the host's loopback (HOST=127.0.0.1);
# the stick is a device, not the network: a pod with a loopback port would do (#1166)
Network=host
Environment=TZ=${TZ}
Environment=SESSION_SECRET=${ZWAVE_SECRET}
Environment=HOST=127.0.0.1
Environment=PORT=8091
Volume=${DATA_DIR}/home-assistant/zwave-js:/usr/src/app/store:z
AddDevice=${ZWAVE_DEVICE}:${ZWAVE_DEVICE}
# labelling off: a container_t process may not open a USB serial device; with the
# label on, the stick gives EACCES and the whole Z-Wave network is down while
# Home Assistant answers 200 (#417). ServiceBay ran this container privileged.
SecurityLabelDisable=true
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always

[Install]
WantedBy=default.target
