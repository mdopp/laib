[Unit]
Description=Z-Wave JS UI
After=network-online.target

[Container]
Image=${ZWAVE_IMAGE}
Network=host
Environment=TZ=${TZ}
Environment=SESSION_SECRET=${ZWAVE_SECRET}
Environment=HOST=0.0.0.0
Environment=PORT=8091
Volume=${DATA_DIR}/home-assistant/zwave-js:/usr/src/app/store:z
AddDevice=${ZWAVE_DEVICE}:${ZWAVE_DEVICE}
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always

[Install]
WantedBy=default.target
