[Unit]
Description=Matter server
After=network-online.target

[Container]
Image=${MATTER_IMAGE}
Network=host
Environment=TZ=${TZ}
Volume=${DATA_DIR}/home-assistant/matter:/data:z
Volume=/run/dbus:/run/dbus:ro
PodmanArgs=--privileged
Exec=--storage-path /data --paa-root-cert-dir /data/credentials --bluetooth-adapter 0
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always

[Install]
WantedBy=default.target
