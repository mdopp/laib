        print("home-assistant: its home is box.yml zuhause")
        return
    ws = WS(tok)
    try:
        ws("config/core/update", **want)
    finally:
        ws.close()
    print("home-assistant: home set from box.yml zuhause (" + ", ".join(want) + ")")


