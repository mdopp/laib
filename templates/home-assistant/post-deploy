def pipeline_users(pid):
    """the files under HA's config that name a pipeline's id: its YAML (automations, scripts,
    packages) and its .storage, but the pipelines' own file"""
    conf = os.path.dirname(os.path.dirname(HA_STORAGE))
    out = []
    for d, dirs, files in os.walk(conf):
        rel = os.path.relpath(d, conf)
        if rel == ".":
            dirs[:] = [x for x in dirs if x in (".storage", "packages")]   # not the database, backups, custom components
        for f in files:
            if not (rel == ".storage" or f.endswith((".yaml", ".yml"))) or f.startswith("assist_pipeline.pipelines"):
                continue
            try:
                with open(os.path.join(d, f), encoding="utf-8", errors="replace") as fh:
                    if pid in fh.read():
                        out.append(os.path.normpath(os.path.join(rel, f)))
            except OSError:
                pass
    return out


def voice(stimme):
    """#634: one Assist pipeline named after the house persona (ADR 0020), Laib's own: Frage with HA's
    local intents first (HA's own agent without Frage), Stimme's Whisper and Piper (the persona's
    voice: tts_voice None is the voice Piper runs with), and the persona's wake word once Stimme's
    openWakeWord offers it; until then the one the preferred pipeline had, if the engine offers it,
    else none — never a wake word nobody can say. It is preferred, every satellite's pipeline select
    is on it, a satellite's wake word is the persona's once the device has it, its end of speech is
    VOICE_VAD. The pipelines named in VOICE_OLD_PIPELINES (the Solaris era's) go once nothing
    uses them; one a select or a file under HA's config names is renamed „… (alt)“ instead."""
    try:
        with open(PERSONA_JSON) as f:
            persona = json.load(f)
        name, lang, wid, phrase = persona["display"], (persona.get("languages") or ["de"])[0], persona["wakeword"], persona["phrase"]
    except (OSError, ValueError, KeyError) as e:
        print(f"home-assistant: the house persona is not readable ({type(e).__name__}): the Assist pipelines stay as they are")
        return
    if not stimme.get("Whisper") or not stimme.get("Piper"):
        print(f'home-assistant: no Assist pipeline "{name}": Stimme is not there (after laib add stimme: laib apply home-assistant)')
        return
    tok = admin_session()
    entries = call("GET", "/api/config/config_entries/entry", token=tok)[1] or []
    frage = next((e.get("entry_id") for e in entries if e.get("domain") == "ollama" and e.get("title") == FRAGE), None)
    states = {s.get("entity_id"): s for s in call("GET", "/api/states", token=tok)[1] or []}
    ws = WS(tok)
    try:
        reg = ws("config/entity_registry/list")
        of = lambda entry, dom: next((r["entity_id"] for r in reg if entry and r.get("config_entry_id") == entry
                                      and r.get("entity_id", "").startswith(dom + ".") and not r.get("disabled_by")), None)
        stt, tts, wake, conv = of(stimme["Whisper"], "stt"), of(stimme["Piper"], "tts"), of(stimme.get("openWakeWord"), "wake_word"), of(frage, "conversation")
        langs = {}
        for kind, eng in (("stt", stt), ("tts", tts)):
            langs[kind] = next((x.get("supported_languages") or [] for x in (ws(f"{kind}/engine/list", language=lang) or {}).get("providers") or []
                                if x.get("engine_id") == eng), [])
            if not langs[kind]:
                print(f'home-assistant: no Assist pipeline "{name}": {eng} speaks no {lang}', file=sys.stderr)
                return
        listed = ws("assist_pipeline/pipeline/list") or {}
        pipes, preferred = listed.get("pipelines") or [], listed.get("preferred_pipeline")
        ours = next((p for p in pipes if p.get("name") == name), None)
        before = ours or next((p for p in pipes if p.get("id") == preferred), {})
        try:
            offered = [w.get("id") for w in (ws("wake_word/info", entity_id=wake) or {}).get("wake_words") or []] if wake else []
        except RuntimeError:
            offered = None   # the engine does not say: the wake word stays as it is
        if offered is None:
            ww = (before.get("wake_word_entity"), before.get("wake_word_id"))
        elif wid in offered:
            ww = (wake, wid)
        elif before.get("wake_word_id") in offered:
            ww = (wake, before["wake_word_id"])
            print(f"home-assistant: wake word {before['wake_word_id']} stays: openWakeWord does not offer {wid} yet (Stimme's trainer)")
        else:
            ww = (None, None)
            print(f"home-assistant: no wake word on the server: openWakeWord offers neither {wid} (Stimme's trainer) nor "
                  f"{before.get('wake_word_id') or 'one from before'}; the satellites wake on the device or by their button")
        agent = conv if conv and (states.get(conv) or {}).get("state") not in ("unavailable", None) else "conversation.home_assistant"
        want = {"name": name, "language": lang, "conversation_engine": agent, "conversation_language": lang, "prefer_local_intents": True,
                "stt_engine": stt, "stt_language": langs["stt"][0], "tts_engine": tts, "tts_language": langs["tts"][0], "tts_voice": None,
                "wake_word_entity": ww[0], "wake_word_id": ww[1]}
        if ours is None:
            ours = ws("assist_pipeline/pipeline/create", **want)
            print(f'home-assistant: Assist pipeline "{name}" created ({agent}, {lang}, wake word {ww[1] or "none"})')
        elif any(ours.get(k) != v for k, v in want.items()):
            changed = [k for k, v in want.items() if ours.get(k) != v]
            ours = ws("assist_pipeline/pipeline/update", pipeline_id=ours["id"], **dict({k: v for k, v in ours.items() if k != "id"}, **want))
            print(f'home-assistant: Assist pipeline "{name}": ' + ", ".join(changed) + " set again")
        else:
            print(f'home-assistant: Assist pipeline "{name}" is there')
        if preferred != ours["id"]:
            ws("assist_pipeline/pipeline/set_preferred", pipeline_id=ours["id"])
            print(f'home-assistant: Assist pipeline "{name}" is preferred')
        old = [p for p in pipes if p.get("name") in OLD_PIPELINES and p.get("id") != ours["id"]]
        retiring = {p["name"] for p in old}
        # the satellites (a Voice PE, any Assist satellite): their selects, by HA's translation keys;
        # a select's options follow the pipelines, so the states are read after the create
        states = {s.get("entity_id"): s for s in call("GET", "/api/states", token=tok)[1] or []}
        said = []

        def pick(eid, option, why):
            st = states.get(eid) or {}
            if st.get("state") == option:
                return
            if option not in (st.get("attributes") or {}).get("options", []):
                said.append(f"{eid}: {why} is no option, it stays {st.get('state')}")
                return
            code, _ = call("POST", "/api/services/select/select_option", {"entity_id": eid, "option": option}, token=tok)
            said.append(f"{eid} {st.get('state')} -> {option} ({why})" if code == 200 else f"{eid}: NOT set to {option} (HTTP {code})")
            if code == 200:
                st["state"] = option

        for r in reg:
            eid, tk = r.get("entity_id", ""), r.get("translation_key")
            if not eid.startswith("select.") or r.get("disabled_by"):
                continue
            st = states.get(eid) or {}
            if tk == "pipeline" or (tk == "pipeline_n" and st.get("state") in retiring):
                pick(eid, name, "the persona's pipeline")
            elif tk == "vad_sensitivity" and VAD:
                pick(eid, VAD, f"VOICE_VAD {VAD}")
            elif tk == "wake_word":
                opts = (st.get("attributes") or {}).get("options", [])
                hit = next((o for o in opts if o.casefold() == phrase.casefold()), None)
                if hit:
                    pick(eid, hit, "the persona's wake word, on the device")
                elif WAKE_FALLBACK:   # the first slot only: the second (wake_word_n) stays the owner's
                    pick(eid, next((o for o in opts if o.casefold() == WAKE_FALLBACK.casefold()), WAKE_FALLBACK),
                         f"VOICE_WAKE_FALLBACK {WAKE_FALLBACK}, until the device has {phrase}")
        for s in said:
            print("home-assistant: satellite " + s)
        for p in old:
            users = [e for e, s in states.items() if e.startswith("select.") and s.get("state") == p["name"]] + pipeline_users(p["id"])
            if users:
                new = p["name"] + " (alt)"
                ws("assist_pipeline/pipeline/update", pipeline_id=p["id"], **dict({k: v for k, v in p.items() if k != "id"}, name=new))
                print(f'home-assistant: Assist pipeline "{p["name"]}" renamed "{new}", not deleted: ' + ", ".join(users) + " name it")
            else:
                ws("assist_pipeline/pipeline/delete", pipeline_id=p["id"])
                print(f'home-assistant: Assist pipeline "{p["name"]}" deleted (Solaris era, nothing uses it)')
    finally:
        ws.close()


HA_CONFIG = os.path.dirname(os.path.dirname(HA_STORAGE))   # HA's /config, at its host path (a data path of this service)
GONE = ("unavailable", "unknown")


def update_state(eid, until, ready):
    """(HTTP status, state) of an update entity once ready(state) holds, or the last answer at until.
    After a restart, which every approved change brings (laib snapshots Home Assistant stopped, #40),
    HA answers before HACS has set its update entities up: /api/states/<eid> is 404 for a while (#528)"""
    while True:
        st, s = call("GET", "/api/states/" + eid, token=admin_session())
        if st == 200 and s and ready(s):
            return st, s
        if time.monotonic() >= until:
            return st, s
        time.sleep(RETRY)


def storage(key):
    """data of one of HA's .storage files, or None"""
    try:
        with open(os.path.join(os.path.dirname(HA_STORAGE), key), encoding="utf-8") as f:
            return json.load(f).get("data")
    except (OSError, ValueError):
        return None


def hacs_domain(eid):
    """the integration domain behind a HACS update entity: its unique id is HACS's repository id"""
    ent = next((e for e in (storage("core.entity_registry") or {}).get("entities") or [] if e.get("entity_id") == eid), None)
    if not ent or ent.get("platform") != "hacs":
        return None
    repo = ((storage("hacs.repositories") or {}).get(str(ent.get("unique_id"))) or {})
    return repo.get("domain") if repo.get("category") == "integration" else None


def manifest(path):
    try:
        with open(os.path.join(path, "manifest.json"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def straighten():
    """every custom integration where Home Assistant loads it, custom_components/<domain>/manifest.json (#528).
    HACS 2.0.5 unpacked marq24/ha-senec-v3 one level too deep: custom_components/senec/__init__.py a dummy
    (the repository's custom_components/__init__.py), the integration in custom_components/senec/senec/,
    and HA said "Integration not found". One whose manifest.json lies one level down, with its own domain,
    is moved up; what HACS left on top is kept in .laib-<domain>-sicherung/<time>/. (straightened, broken)"""
    cc = os.path.join(HA_CONFIG, "custom_components")
    try:
        names = sorted(n for n in os.listdir(cc) if not n.startswith((".", "_")) and os.path.isdir(os.path.join(cc, n)))
    except OSError:
        return [], []
    done, broken = [], []
    for domain in names:
        base = os.path.join(cc, domain)
        if manifest(base):
            continue
        nested = next((n for n in (os.path.join(base, domain), os.path.join(base, "custom_components", domain))
                       if (manifest(n) or {}).get("domain") == domain), None)
        if not nested:
            broken.append(f"Erweiterung {domain}: custom_components/{domain}/manifest.json fehlt, Home Assistant lädt sie nicht. "
                          "In HACS neu herunterladen, dann laib apply home-assistant")
            continue
        keep = os.path.join(HA_CONFIG, f".laib-{domain}-sicherung", time.strftime("%Y-%m-%dT%H-%M-%SZ", time.gmtime()))
        os.makedirs(keep)
        tmp = os.path.join(cc, f".laib-{domain}-gerade")
        os.rename(nested, tmp)                          # out of base first: nested may be base/<domain>
        os.rename(base, os.path.join(keep, domain))     # the dummy and whatever else HACS put on top
        os.rename(tmp, base)
        print(f"home-assistant: Erweiterung {domain} lag eine Ebene zu tief ({os.path.relpath(nested, HA_CONFIG)}), gerade gezogen; "
              f"was darüber lag, liegt in {os.path.relpath(keep, HA_CONFIG)}")
        done.append(domain)
    return done, broken


def install_updates():
    """HA_INSTALL (#528): the extensions a person approved, "update.a=1.2,update.b=3.0"
    as the Operator proposed them from home-assistant-check.py (laib snapshotted
    Home Assistant before this apply). Each is installed only while Home
    Assistant still offers exactly that version, and waited for until HACS has
    downloaded it (HA's service call returns before). Then every custom
    integration must lie where HA loads it (straighten); an approved one whose
    manifest says another version is said. Home Assistant restarts once, as a
    custom integration needs. Device firmware is never proposed. Returns what
    is broken: the hook is red for it after the other steps ran."""
    want = [w.split("=", 1) for w in E.get("HA_INSTALL", "").split(",") if "=" in w]
    installed, broken = [], []
    for eid, ver in want:
        st, s = update_state(eid, time.monotonic() + WAIT, lambda s: s.get("state") not in GONE)
        a = (s or {}).get("attributes") or {}
        if st != 200 or (s or {}).get("state") in GONE:
            broken.append(f"{eid}: Home Assistant kennt diese Erweiterung nicht (HTTP {st}, {(s or {}).get('state') or 'kein Zustand'}, "
                          f"{WAIT:.0f} s gewartet); den Vorschlag neu machen lassen, sobald laib diag sie wieder anbietet")
            continue
        if a.get("installed_version") == ver:
            print(f"home-assistant: {eid} {ver}: schon installiert")
            continue
        if s.get("state") != "on" or a.get("latest_version") != ver:
            print(f"home-assistant: {eid} {ver}: nichts zu installieren (installiert: {a.get('installed_version')}, angeboten: {a.get('latest_version')})")
            continue
        body = {"entity_id": eid}
        if int(a.get("supported_features") or 0) & 2:   # UpdateEntityFeature.SPECIFIC_VERSION
            body["version"] = ver
        st, _ = call("POST", "/api/services/update/install", body, token=admin_session())
        if st != 200:
            broken.append(f"update.install {eid} {ver}: HTTP {st}")
            continue
        st, s = update_state(eid, time.monotonic() + WAIT, lambda s: not (s.get("attributes") or {}).get("in_progress")
                             and (s.get("state") == "off" or (s.get("attributes") or {}).get("installed_version") != a.get("installed_version")))
        if ((s or {}).get("attributes") or {}).get("in_progress"):
            broken.append(f"{eid} {ver}: nach {WAIT:.0f} s lädt Home Assistant noch; laib apply home-assistant, wenn es fertig ist")
            continue
        installed.append((eid, ver))
    straightened, bad = straighten()
    broken += bad
    for eid, ver in installed:
        domain = hacs_domain(eid)
        if domain is None:
            continue   # not a HACS integration (or HA has not written its registry): straighten looked at every folder
        have = (manifest(os.path.join(HA_CONFIG, "custom_components", domain)) or {}).get("version")
        if have and have != ver:
            print(f"home-assistant: {domain}: installiert ist {have}, freigegeben war {ver} (HACS lädt, was es für das Neueste hält)")
    if installed:
        print("home-assistant: installiert: " + ", ".join(f"{e} {v}" for e, v in installed))
    if installed or straightened:
        call("POST", "/api/services/homeassistant/restart", {}, token=admin_session())
        print("home-assistant: Home Assistant startet neu")
    return broken


def ma(command, **args):
    """one command on Music Assistant's JSON-RPC API with HA_MUSIC_ASSISTANT_TOKEN"""
    req = urllib.request.Request(MA + "/api", data=json.dumps({"message_id": "laib", "command": command, "args": args}).encode(),
                                 headers={"Authorization": "Bearer " + MA_TOKEN, "Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=150) as r:
            raw = r.read()
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Music Assistant {command}: HTTP {e.code}")
    return json.loads(raw) if raw else None


def ma_flow(step, values):
    """a Music Assistant provider setup flow, its form filled with values, to its FINISH step"""
    submitted = None
    for _ in range(60):
        t = step.get("type")
        if t == "finish":
            return
        if t == "form" and not (submitted == step.get("step_id") and step.get("errors")):
            keys = {e.get("key") for e in step.get("entries") or []}
            submitted = step.get("step_id")
            step = ma("config/flows/submit", flow_id=step["flow_id"], values={k: v for k, v in values.items() if k in keys})
        elif t == "progress":
            time.sleep(RETRY)
            step = ma("config/flows/get", flow_id=step["flow_id"])
        else:
            raise RuntimeError(f"Music Assistant's Home Assistant plugin was refused: {step.get('reason') or step.get('errors') or t}")
    raise RuntimeError("Music Assistant's Home Assistant plugin did not finish its setup")


def ha_flow(tok, flow):
    """Home Assistant's music_assistant config flow (2026.10, config_flow.py) to its end: the url,
    then the browser step (or the token form without one) with MA's token as the code"""
    answer = {"user": {"url": MA}, "auth_manual": {"token": MA_TOKEN}, "reauth_confirm": {}}
    for _ in range(8):
        t, sid = flow.get("type"), flow.get("step_id")
        if t == "create_entry":
            return "added"
        if t == "abort":
            if flow.get("reason") in ("already_configured", "reauth_successful"):
                return flow["reason"]
            raise RuntimeError(f"the Music Assistant integration was refused: {flow.get('reason')}")
        if t == "form" and sid in answer and not flow.get("errors"):
            body = answer[sid]
        elif t == "external" and sid == "auth":
            body = {"code": MA_TOKEN}  # what MA's /login sends back to HA's callback (config_flow.py async_step_auth)
        elif t == "external_done":
            body = {}
        else:
            raise RuntimeError(f"the Music Assistant integration stopped at {t} {sid}: {flow.get('errors') or ''}")
        st, flow = call("POST", "/api/config/config_entries/flow/" + flow["flow_id"], body, token=tok)
        if st != 200 or not isinstance(flow, dict):
            raise RuntimeError(f"the Music Assistant integration's flow answered HTTP {st}")
    raise RuntimeError("the Music Assistant integration's flow did not end")


def music_assistant():
    """MA's Home Assistant plugin and HA's Music Assistant integration, each once (#526)"""
    if not MA_TOKEN:
        print("home-assistant: Music Assistant is not installed: no integration (laib add music-assistant connects it)")
        return
    ma("auth/me")  # MA answers and takes its token, or the error says which
    tok = admin_session()
    # 1. Music Assistant's Home Assistant plugin: HA's users for MA's login, with an administrator token
    plug, minted = machine("MUSIC_ASSISTANT_HA_TOKEN")
    VERIFIED.discard("MUSIC_ASSISTANT_HA_TOKEN")   # verified once the plugin has it, below
    minted = minted or any(n == "MUSIC_ASSISTANT_HA_TOKEN" for n, _ in RETIRED)   # still moving: the plugin gets the new one first
    values = {"url": HA_PUBLIC, "verify_ssl": True, "token": plug}
    have = ma("config/providers", provider_domain="hass") or []
    if not have:
        ma_flow(ma("config/providers/setup", provider_domain="hass"), values)
        print(f"home-assistant: Music Assistant's Home Assistant plugin connected ({HA_PUBLIC}): the family signs in to MA with Home Assistant")
    elif minted or have[0].get("status") in ("auth_required", "error"):
        ma_flow(ma("config/providers/reconfigure", instance_id=have[0]["instance_id"]), values)
        print(f"home-assistant: Music Assistant's Home Assistant plugin connected again ({HA_PUBLIC}, it was {have[0].get('status')})")
    VERIFIED.add("MUSIC_ASSISTANT_HA_TOKEN")
    # 2. Home Assistant's Music Assistant integration
    entry = next((e for e in call("GET", "/api/config/config_entries/entry", token=tok)[1] or [] if e.get("domain") == "music_assistant"), None)
    if entry is None:
        st, flow = call("POST", "/api/config/config_entries/flow", {"handler": "music_assistant"}, token=tok)
        if st != 200 or not isinstance(flow, dict):
            raise RuntimeError(f"the Music Assistant integration's flow did not start (HTTP {st})")
        print(f"home-assistant: Music Assistant integration {ha_flow(tok, flow)} ({MA})")
        return
    if entry.get("state") == "loaded":
        print("home-assistant: Music Assistant integration is there")
        return
    ws = WS(tok)
    try:
        flows = [f for f in ws("config_entries/flow/progress") or []
                 if f.get("handler") == "music_assistant" and (f.get("context") or {}).get("source") == "reauth"]
    finally:
        ws.close()
    if not flows:
        print(f"home-assistant: Music Assistant integration is {entry.get('state')}, no sign-in asked: left as it is", file=sys.stderr)
        return
    print(f"home-assistant: Music Assistant integration signed in again ({ha_flow(tok, dict(flows[0], type='form'))})")


