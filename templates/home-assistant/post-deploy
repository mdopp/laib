CADDY = ("127.0.0.1/32", "::1/128")   # Caddy, on this host, reaches HA on loopback (#724)


def trusts_caddy(conf):
    """HA reads the client from Caddy's X-Forwarded-For: use_x_forwarded_for, and 127.0.0.1 in trusted_proxies"""
    nets = []
    for net in conf.get("trusted_proxies") or []:
        try:
            nets.append(ipaddress.ip_network(net, strict=False))
        except ValueError:
            pass
    return bool(conf.get("use_x_forwarded_for")) and any(ipaddress.ip_address("127.0.0.1") in t for t in nets)


def wanted_proxies(problems):
    """#729: the proxies HA trusts, exactly: loopback (Caddy) and HA_TRUSTED_PROXIES, the owner's own (comma-
    separated addresses or CIDRs; a bare address is a /32 or /128). None, with a problem, when the value holds
    anything else: then the list HA has is not touched, so a typo neither drops a proxy the owner meant nor
    trusts a range nobody did."""
    want = list(CADDY)
    bad = []
    for part in E.get("HA_TRUSTED_PROXIES", "").split(","):
        part = part.strip()
        if not part:
            continue
        try:
            net = str(ipaddress.ip_network(part, strict=False))
        except ValueError:
            bad.append(part)
            continue
        if net not in want:
            want.append(net)
    if bad:
        problems.append("HA_TRUSTED_PROXIES: " + ", ".join(repr(b) for b in bad) + " ist keine IP-Adresse und kein Netz "
                        "(z. B. 192.168.178.2 oder 10.0.0.0/8, mehrere mit Komma); Home Assistants Proxy-Liste bleibt, wie sie ist")
        return None
    return want


def proxy_set(entries):
    """the entries as networks, order-insensitive; one HA cannot read is no network (and so not wanted)"""
    out = set()
    for e in entries or []:
        try:
            out.add(str(ipaddress.ip_network(e, strict=False)))
        except (ValueError, TypeError):
            out.add(repr(e))
    return out


def http_settings():
    """Home Assistant's HTTP settings, in its own store since 2026.8 (it ignores a YAML http: block), set
    through http/config, configure and promote as ServiceBay set the proxy trust there (#2573); configure
    restarts HA into it on trial and an unpromoted one reverts after five minutes. One configure for all,
    only when something differs, so an apply that changes nothing does not restart HA.

    The proxy trust (#724, #729): Laib owns trusted_proxies. Caddy reaches HA on 127.0.0.1, and HA answers a
    forwarded request from a proxy it does not trust with 400 and logs every client as 127.0.0.1. So
    use_x_forwarded_for is on and trusted_proxies is exactly 127.0.0.1/32, ::1/128 and HA_TRUSTED_PROXIES;
    anything else is removed (ServiceBay's private ranges on a migrated box: HA is on the host network, and a
    trusted LAN range lets any device there claim another address in X-Forwarded-For, and steer the login
    alerts of #703). The same set in another order is no change. A value that is no address leaves the list
    as it is (red), only adding loopback where HA does not trust Caddy at all.

    HA_LOGIN_SPERRE (#703): Home Assistant bans an address after that many failed logins, "aus" never, empty
    leaves it as it is (the default). Only with the proxy trust: otherwise every login from outside is
    127.0.0.1 to HA, and a ban would lock out everyone. A ban HA sets also locks out a consumer on 127.0.0.1
    whose token went stale (the check, Haus, the Bote): the counter in templates/auth tells the owner of
    every ban HA logs. Returns what is not set, or None."""
    problems = []
    want = E.get("HA_LOGIN_SPERRE", "").strip().lower()
    n = None
    if want == "aus":
        n = -1
    elif want.isdigit() and int(want) >= 1:
        n = int(want)
    elif want:
        problems.append(f"HA_LOGIN_SPERRE={want!r}: a number of failed logins (like 5), aus, or empty")
    proxies = wanted_proxies(problems)
    ws = WS(admin_session())
    try:
        cur = ws("http/config") or {}
        stable = {k: v for k, v in (cur.get("stable") or {}).items() if k not in ("created_at", "error", "error_message")}
        conf = dict(stable)
        have = stable.get("trusted_proxies") or []
        if proxies is None:
            if not trusts_caddy(conf):
                conf["use_x_forwarded_for"] = True
                conf["trusted_proxies"] = have + [c for c in CADDY if c not in have]
        else:
            conf["use_x_forwarded_for"] = True
            if proxy_set(have) != set(proxies):
                conf["trusted_proxies"] = proxies
        if n is not None:
            conf["login_attempts_threshold"] = n
            if n > 0:
                conf["ip_ban_enabled"] = True
        if conf == stable:
            print("home-assistant: trusts Caddy on 127.0.0.1 (X-Forwarded-For): as set" + (f"; HA_LOGIN_SPERRE {want}: as set" if n is not None else ""))
            return "; ".join(problems) or None
        res = ws("http/config/configure", config=conf) or {}
    finally:
        ws.close()
    if res.get("restart"):
        time.sleep(float(E.get("HA_RETRY_SECONDS", "5")))
        if not ha_up(WAIT):
            return "; ".join(problems + ["Home Assistant did not come back from the restart into its HTTP settings; they revert in five minutes"])
    ws = WS(admin_session())
    try:
        ws("http/config/promote")
    finally:
        ws.close()
    gone = sorted(proxy_set(stable.get("trusted_proxies")) - proxy_set(conf.get("trusted_proxies")))
    if not trusts_caddy(stable) or conf.get("trusted_proxies") != stable.get("trusted_proxies"):
        print("home-assistant: trusts Caddy now: use_x_forwarded_for, trusted_proxies " + ", ".join(conf["trusted_proxies"])
              + (" (no longer trusted: " + ", ".join(gone) + ")" if gone else ""))
    if n is not None:
        print(f"home-assistant: HA_LOGIN_SPERRE {want}: " + (f"Home Assistant bans an address after {n} failed logins" if n > 0 else "no bans"))
    return "; ".join(problems) or None


