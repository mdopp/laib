        if any(E.get("ZUHAUSE_" + k) for k in ("STREET", "POSTCODE", "CITY")):
            print("home-assistant: box.yml zuhause has an address but no latitude/longitude: Home Assistant's location "
                  "stays as it is (laib zuhause set --latitude … --longitude …)")
        return
    want = {"latitude": float(lat), "longitude": float(lon), "time_zone": E.get("LAIB_TZ") or "Europe/Berlin"}
    if E.get("ZUHAUSE_ELEVATION"):
        want["elevation"] = int(E["ZUHAUSE_ELEVATION"])
    if E.get("ZUHAUSE_COUNTRY"):
        want["country"] = E["ZUHAUSE_COUNTRY"]
    tok = admin_session()
    st, have = call("GET", "/api/config", token=tok)
