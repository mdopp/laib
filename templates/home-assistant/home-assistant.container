[Unit]
Description=Home Assistant — das Haus und die Stimme (Assist)
After=network-online.target

[Container]
Image=${HA_IMAGE}
Network=host
Environment=TZ=${TZ}
# box.yml zuhause (#561): a move changes it, so laib applies HA again and post-deploy sets its home
Environment=ZUHAUSE_REV=${ZUHAUSE_REV}
# rest_command.mitteilung's bearer (packages/laib_mitteilung.yaml reads it with !env_var, #177)
Environment="BOTE_NOTIFY_AUTH=Bearer ${NOTIFY_TOKEN}"
# auth_oidc's client secret (packages/laib_auth_oidc.yaml reads it with !env_var, #253)
Environment=AUTH_OIDC_SECRET=${OIDC_SECRET}
Volume=${DATA_DIR}/home-assistant/homeassistant:/config:z
Volume=/run/dbus:/run/dbus:ro
PodmanArgs=--privileged
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target
