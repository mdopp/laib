#!/usr/bin/env python3
"""adguard post-deploy (#36): the rewrites from render/adguard/rewrites.json
synced through AdGuard's API on every apply (the service is up and green).
The first AdGuardHome.yaml is pre-start's."""
import base64, json, os, sys, time, urllib.request

E = os.environ
user, pw = E.get("ADMIN_USER", "admin"), E["LAIB_SECRET_ADGUARD_ADMIN_PASSWORD"]

# rewrites: *.domain and the apex → this box (rendered by laib), synced via the API
rewrites_path = "/mnt/data/laib/render/adguard/rewrites.json"
try:
    wanted = json.load(open(rewrites_path))
except OSError:
    print("no rewrites rendered yet (box.yml lanIp missing?)"); sys.exit(0)
auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
def api(path, body=None):
    req = urllib.request.Request("http://127.0.0.1:8083/control" + path, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": "Basic " + auth, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as r:
        raw = r.read()
        return json.loads(raw) if raw else None
current = None
for _ in range(45):
    try:
        current = api("/rewrite/list") or []
        break
    except Exception:
        time.sleep(2)
if current is None:
    print("AdGuard API did not answer; rewrites not synced (re-run laib apply adguard)", file=sys.stderr); sys.exit(1)
have = {(r["domain"], r["answer"]) for r in current}
want = {(r["domain"], r["answer"]) for r in wanted}
for d, a in want - have:
    api("/rewrite/add", {"domain": d, "answer": a}); print("rewrite added:", d, "→", a)
for d, a in have - want:
    if d.endswith(E["LAIB_DOMAIN"]) or d == E["LAIB_DOMAIN"]:
        api("/rewrite/delete", {"domain": d, "answer": a}); print("rewrite removed:", d)
print(f"rewrites in step: {len(want)}")
