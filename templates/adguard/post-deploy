#!/usr/bin/env python3
"""adguard post-deploy: the first AdGuardHome.yaml (admin user, web on
8083, DNS on 53, upstreams) when none exists, then the rewrites from
render/adguard/rewrites.json synced through the API on every apply. The
bcrypt hash comes from Caddy's hash-password, which the box has anyway."""
import base64, json, os, subprocess, sys, time, urllib.request

E = os.environ
conf_dir = os.path.join(E["LAIB_DATA_DIR"], "adguard", "conf")
os.makedirs(conf_dir, exist_ok=True)
conf = os.path.join(conf_dir, "AdGuardHome.yaml")
user, pw = E.get("ADMIN_USER", "admin"), E["LAIB_SECRET_ADGUARD_ADMIN_PASSWORD"]

def install_api(path, body):
    req = urllib.request.Request("http://127.0.0.1:3000/control" + path, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return r.read()

if not os.path.exists(conf):
    # AdGuard's own setup wizard, driven through its API on the setup port
    # 3000: web on 8083, DNS on 53, the admin user. AdGuard writes the
    # yaml itself, with the right schema version.
    for _ in range(45):
        try:
            urllib.request.urlopen("http://127.0.0.1:3000/control/install/get_addresses", timeout=5); break
        except Exception:
            time.sleep(2)
    install_api("/install/configure", {
        "web": {"ip": "0.0.0.0", "port": 8083},
        "dns": {"ip": "0.0.0.0", "port": 53},
        "username": user, "password": pw,
    })
    print("AdGuard configured through its setup API")
    time.sleep(3)
    upstreams = E.get("UPSTREAMS", "https://dns.quad9.net/dns-query").split()
    auth0 = base64.b64encode(f"{user}:{pw}".encode()).decode()
    req = urllib.request.Request("http://127.0.0.1:8083/control/dns_config", data=json.dumps({"upstream_dns": upstreams, "bootstrap_dns": ["9.9.9.9", "1.1.1.1"]}).encode(),
                                 headers={"Authorization": "Basic " + auth0, "Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=10).read()
    print("upstreams set")

# rewrites: *.domain and the apex → this box (rendered by laib), synced via the API
rewrites_path = "/mnt/data/laib/render/adguard/rewrites.json"
try:
    wanted = json.load(open(rewrites_path))
except OSError:
    print("no rewrites rendered yet (box.yml lanIp missing?)"); sys.exit(0)
auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
def api(path, body=None):
    req = urllib.request.Request("http://127.0.0.1:8083/control" + path, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": "Basic " + auth, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as r:
        raw = r.read()
        return json.loads(raw) if raw else None
current = None
for _ in range(45):
    try:
        current = api("/rewrite/list") or []
        break
    except Exception:
        time.sleep(2)
if current is None:
    print("AdGuard API did not answer; rewrites not synced (re-run laib apply adguard)", file=sys.stderr); sys.exit(1)
have = {(r["domain"], r["answer"]) for r in current}
want = {(r["domain"], r["answer"]) for r in wanted}
for d, a in want - have:
    api("/rewrite/add", {"domain": d, "answer": a}); print("rewrite added:", d, "→", a)
for d, a in have - want:
    if d.endswith(E["LAIB_DOMAIN"]) or d == E["LAIB_DOMAIN"]:
        api("/rewrite/delete", {"domain": d, "answer": a}); print("rewrite removed:", d)
print(f"rewrites in step: {len(want)}")
