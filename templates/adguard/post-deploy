#!/usr/bin/env python3
"""adguard post-deploy (#36): the rewrites from render/adguard/rewrites.json
synced through AdGuard's API on every apply (the service is up and green),
the PTR upstream for private addresses (#551), the user rules that answer
PTR for 172.16.0.0/12 here (#901) and the query log's retention (#901). The
first AdGuardHome.yaml is pre-start's."""
import base64, json, os, re, socket, struct, sys, time, urllib.request

E = os.environ
# a rotation (#665): pre-start set the new one in AdGuardHome.yaml before the restart; had it not, it was red
# and this hook does not run
user, pw = E.get("ADMIN_USER", "admin"), E.get("LAIB_ROTATE_ADGUARD_ADMIN_PASSWORD") or E["LAIB_SECRET_ADGUARD_ADMIN_PASSWORD"]
BASE = E.get("ADGUARD_URL", "http://127.0.0.1:8083")
auth = base64.b64encode(f"{user}:{pw}".encode()).decode()


def api(path, body=None, method=None):
    req = urllib.request.Request(BASE + "/control" + path, data=json.dumps(body).encode() if body is not None else None,
                                 method=method, headers={"Authorization": "Basic " + auth, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as r:
        raw = r.read()
        return json.loads(raw) if raw else None


def gateway(table):
    """The default gateway (IPv4) with the lowest metric from the host's
    routing table; the hook runs on the host network, so this is the box's."""
    best = None
    try:
        lines = open(table).read().splitlines()[1:]
    except OSError:
        return None
    for line in lines:
        f = line.split()
        if len(f) < 7 or f[1] != "00000000" or not int(f[3], 16) & 2:  # default route, RTF_GATEWAY
            continue
        if best is None or int(f[6]) < best[0]:
            best = (int(f[6]), socket.inet_ntoa(struct.pack("<L", int(f[2], 16))))
    return best and best[1]


current = None
for _ in range(45):
    try:
        current = api("/rewrite/list") or []
        break
    except Exception:
        time.sleep(2)
if current is None:
    print("AdGuard API did not answer; rewrites not synced (re-run laib apply adguard)", file=sys.stderr); sys.exit(1)

# rewrites: *.domain and the apex → this box (rendered by laib), synced via the API
rewrites_path = os.path.join(E.get("LAIB_RENDER_DIR", "/mnt/data/laib/render"), "adguard", "rewrites.json")
try:
    wanted = json.load(open(rewrites_path))
except OSError:
    print("no rewrites rendered yet (box.yml lanIp missing?)")
    wanted = None
if wanted is not None:
    have = {(r["domain"], r["answer"]) for r in current}
    want = {(r["domain"], r["answer"]) for r in wanted}
    for d, a in want - have:
        api("/rewrite/add", {"domain": d, "answer": a}); print("rewrite added:", d, "→", a)
    for d, a in have - want:
        if d.endswith(E["LAIB_DOMAIN"]) or d == E["LAIB_DOMAIN"]:
            api("/rewrite/delete", {"domain": d, "answer": a}); print("rewrite removed:", d)
    print(f"rewrites in step: {len(want)}")

# PTR for private addresses (#551): AdGuard asks local_ptr_upstreams, and with
# none it asks the system resolver, which on this box is AdGuard itself: every
# such query ran into the timeout. The router knows the LAN's names. A
# PTR_UPSTREAMS value wins; without one, an empty list gets the default
# gateway and a list the owner set in the UI stays.
dns = api("/dns_info") or {}
have_ptr = dns.get("local_ptr_upstreams") or []
explicit = E.get("PTR_UPSTREAMS", "").split()
want_ptr = explicit or (have_ptr or [g for g in [gateway(E.get("ROUTE_TABLE", "/proc/net/route"))] if g])
if not want_ptr:
    print("PTR upstream not set: no default gateway in the routing table (set PTR_UPSTREAMS)", file=sys.stderr)
elif want_ptr != have_ptr:
    api("/dns_config", {"local_ptr_upstreams": want_ptr}); print("PTR upstream for private addresses:", " ".join(want_ptr))
else:
    print("PTR upstream in step:", " ".join(want_ptr))

# PTR for 172.16.0.0/12 (#901): the router does not serve that range and asks
# its own DNS, which is AdGuard, which forwarded to the router again: a loop
# until the 2 s timeout, ~10,000 times for 172.16.255.1. AdGuard now answers
# those itself with NXDOMAIN. A dnsrewrite, not a block: AdGuard counts it as
# rewritten, so the Box page's "blockiert" stays the ad filter's. The router
# stays the PTR upstream for everything else (the LAN's names); a 172.16-31
# network the router or a PTR upstream sits in is left to them. Ours are the
# marker and the rules of exactly this shape, at the end; every other line is
# the owner's and stays where it is.
MARK = "! laib (#901): PTR for 172.16.0.0/12 answered here, the router does not serve it"
OURS = re.compile(r"^\|\|(\d+)\.172\.in-addr\.arpa\^\$dnstype=PTR,dnsrewrite=NXDOMAIN$")
lan = {int(m) for a in want_ptr + [gateway(E.get("ROUTE_TABLE", "/proc/net/route")) or ""] for m in re.findall(r"(?<![\d.])172\.(\d+)\.\d+\.\d+", a)}
ours = [MARK] + [f"||{o}.172.in-addr.arpa^$dnstype=PTR,dnsrewrite=NXDOMAIN" for o in range(16, 32) if o not in lan]
have_rules = (api("/filtering/status") or {}).get("user_rules") or []
owners = [r for r in have_rules if not (r.startswith("! laib (#901)") or OURS.match(r))]
while owners and not owners[-1].strip():
    owners.pop()
if owners + ours != have_rules:
    api("/filtering/set_rules", {"rules": owners + ours}); print(f"PTR for 172.16.0.0/12 answered here: {len(ours) - 1} rules")
else:
    print("PTR rules for 172.16.0.0/12 in step")

# the query log (#901): AdGuard keeps 90 days by default, 1.3 GB on the
# Kraftwerk; QUERYLOG_DAYS (7) is enough to find who asks what. AdGuard takes
# an hour to a year and only the whole config (enabled and anonymize_client_ip
# must not be null), so the rest is sent back as it was.
try:
    days = int(E.get("QUERYLOG_DAYS") or 7)
except ValueError:
    days = 0
if not 1 <= days <= 365:
    print(f"query log retention not set: QUERYLOG_DAYS={E.get('QUERYLOG_DAYS')!r} is not 1 to 365 days", file=sys.stderr)
else:
    ql = api("/querylog/config") or {}
    if int(ql.get("interval") or 0) != days * 86400000:
        api("/querylog/config/update", {**ql, "interval": days * 86400000}, method="PUT"); print(f"query log keeps {days} days")
    else:
        print(f"query log in step: {days} days")
