[Unit]
Description=AdGuard Home — LAN DNS (laib role: dns)
After=network-online.target

[Container]
Image=${IMAGE}
# host network: the house's DNS, port 53 on the box's own address for every device in the LAN
Network=host
Environment=TZ=${TZ}
Volume=${DATA_DIR}/adguard/conf:/opt/adguardhome/conf:z
Volume=${DATA_DIR}/adguard/work:/opt/adguardhome/work:z
AddCapability=NET_BIND_SERVICE
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
