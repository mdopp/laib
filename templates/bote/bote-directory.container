[Unit]
Description=Bote: the directory (ADR 0030) as an MCP tool

[Container]
Image=${DIRECTORY_IMAGE}
Pod=bote.pod
Environment=DIRECTORY_LISTEN=127.0.0.1:8644
Environment=DIRECTORY_DATA=/data
# the name the family talks to (box.yml assistant, ADR 0030)
Environment=ASSISTANT=${ASSISTANT}
# a Signal profile name resolves to its number through signal-cli's contacts in the pod (#127)
Environment=SIGNAL_URL=http://127.0.0.1:8080
Environment=SIGNAL_ACCOUNT=${SIGNAL_ACCOUNT}
# only the admin's number is offered the box: status, proposals (#863)
Environment=ADMIN_NUMBER=${ADMIN_NUMBER}
Volume=${DATA_DIR}/bote/directory:/data:Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
