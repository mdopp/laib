[Unit]
Description=Bote: the persona engine (ADR 0020; today Joshua) as an MCP tool

[Container]
Image=${PERSONA_IMAGE}
Pod=bote.pod
Environment=PERSONA_LISTEN=127.0.0.1:8644
Environment=PERSONA_DATA=/data
Volume=${DATA_DIR}/bote/persona:/data:Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
