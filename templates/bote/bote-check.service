# bote's detail line on the Box page (#785): bote-check.py in a stock Python
# image, fed on stdin (as kalender-abgleich), in the bote pod's network
# namespace (bote-notify is in every Bote), so it asks signal-cli's daemon
# where bote-notify does (127.0.0.1:8080/api/v1/check) and usage-metrics where
# the plugin does (USAGE_URL). The channels reach it as set or empty, through
# the environment, never on argv; the script never writes a number or an id.
# It writes the status file laib.yml declares. laib starts it when someone
# looks and the file is older than its stale; the timer every 15 minutes.
[Unit]
Description=Bote: Kanäle und Gespräche für laibs Status
After=bote-notify.service

[Service]
Type=oneshot
Environment=CH_SIGNAL=${SIGNAL_ACCOUNT}
Environment=CH_MATRIX=${MATRIX_HOMESERVER}
Environment=CH_TELEGRAM=${TELEGRAM_ALLOWED_USERS}
Environment=CH_DISCORD=${DISCORD_ALLOWED_USERS}
Environment=USAGE_TOKEN=${USAGE_TOKEN}
StandardInput=file:%h/.config/containers/systemd/bote/bote-check.py
ExecStart=/usr/bin/podman run --rm -i --name bote-check --network container:systemd-bote-notify --security-opt label=disable -e CH_SIGNAL -e CH_MATRIX -e CH_TELEGRAM -e CH_DISCORD -e USAGE_TOKEN -e SIGNAL_URL=http://127.0.0.1:8080 -e USAGE_URL=${USAGE_URL} -e STATUS_DIR=/data -v ${DATA_DIR}/bote/check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
