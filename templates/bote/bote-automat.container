[Unit]
Description=Bote: Automat — Home Assistant automations as an MCP tool (#26)

[Container]
Image=${AUTOMAT_IMAGE}
Pod=bote.pod
Environment=HA_URL=${HA_URL}
Environment=HA_TOKEN=${AUTOMAT_HA_TOKEN}
Environment=AUTOMAT_LISTEN=127.0.0.1:8643
Environment=AUTOMAT_DATA=/data
Volume=${DATA_DIR}/bote/automat:/data:Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
