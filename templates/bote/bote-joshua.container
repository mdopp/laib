[Unit]
Description=Bote: Joshua — WOPR from WarGames as an MCP tool, an easter egg (#119)

[Container]
Image=${JOSHUA_IMAGE}
Pod=bote.pod
Environment=JOSHUA_LISTEN=127.0.0.1:8644
Environment=JOSHUA_DATA=/data
Volume=${DATA_DIR}/bote/joshua:/data:Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
