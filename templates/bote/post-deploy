#!/usr/bin/env bash
# Renders Hermes' config.yaml and SOUL.md into the data dir from the
# service's values and secrets (ADR 0016: Hermes as stock, configuration
# only); pre-start renders the .env files, and runs here again first.
# Idempotent: rewrites the files on every apply; Hermes re-reads on start.
set -euo pipefail
H="$LAIB_DATA_DIR/bote/hermes"
mkdir -p "$H"
MODEL_URL="${MODEL_URL:?MODEL_URL builtin missing}"
"$(dirname "$0")/pre-start"   # the channels and both .env files (#184)
SIGNAL_ACCOUNT="${SIGNAL_ACCOUNT:-}" TELEGRAM_ALLOWED_USERS="${TELEGRAM_ALLOWED_USERS:-}" DISCORD_ALLOWED_USERS="${DISCORD_ALLOWED_USERS:-}"
ADMIN_NUMBER="${ADMIN_NUMBER:-}" ADMIN_MXID="${ADMIN_MXID:-}" ADMIN_ROOM="${ADMIN_ROOM:-}" ADMIN_DISCORD_ID="${ADMIN_DISCORD_ID:-}"
# Only MCP servers that answer are rendered (#54): a server Hermes cannot
# reach would be a tool the model is told it has. Any HTTP answer counts
# (401, 405 are answers); a connection error leaves the entry out and says so.
# With a bearer (the Haushalt, #170) a 401 or 403 is a refusal: left out too.
# The bearer is named, not passed: python3 reads it from its environment, so
# it is on no argv, where ps shows it to every user on the box (#214).
answers() { python3 - "$1" "${2:-}" <<'PY'
import os, sys, urllib.request, urllib.error
headers = {"Content-Type": "application/json"}
bearer = os.environ.get(sys.argv[2], "") if sys.argv[2] else ""
if bearer:
    headers["Authorization"] = "Bearer " + bearer
req = urllib.request.Request(sys.argv[1], data=b'{"jsonrpc":"2.0","id":0,"method":"ping"}', headers=headers)
try:
    urllib.request.urlopen(req, timeout=3)
except urllib.error.HTTPError as e:
    if bearer and e.code in (401, 403):
        print("lehnt den Token ab"); sys.exit(2)
except Exception as e:
    print(e); sys.exit(1)
PY
}
MCP_EXTRA=""; FRAGE_RULE=""; HA_RULE=""; TOOLS="die Box (laib: lesen und vorschlagen)"
if [ -n "${FRAGE_URL:-}" ]; then
  if answers "$FRAGE_URL" >/dev/null 2>&1; then
    MCP_EXTRA="$MCP_EXTRA  frage:\n    url: $FRAGE_URL\n    trust: full      # Frage: web search plus summary with sources (ADR 0015)\n"
    TOOLS="$TOOLS, Fragen (frage: Websuche mit Quellen)"
    # #510: without thinking the model answered "Wie groß ist ein K8 Berg?" from memory, with a made-up table
    FRAGE_RULE="
Fragen über die Welt (Fakten, Zahlen, Personen, Orte, Aktuelles) beantwortest du immer mit frage, nie aus dem Gedächtnis. Namen und Zahlen nennst du nur aus einer Antwort von frage, mit ihrer Quelle. Findet frage nichts, sag das, statt etwas zu erfinden."
  else echo "frage: $FRAGE_URL antwortet nicht, weggelassen"; fi
fi
# #587: without Frage the model made up a K8 "valley" with heights; no search means no facts
[ -n "$FRAGE_RULE" ] || FRAGE_RULE="
Du hast keine Websuche: Fragen über die Welt mit Namen oder Zahlen (Höhen, Daten, Orte, Personen) beantwortest du nicht aus dem Kopf; sag, dass du es nicht weißt."
if [ -n "${HAUSHALT_MCP_URL:-}" ]; then
  # Haus's Haushalt (haus#11) wants Haus's bearer; the token stays in .env (#170)
  if [ -z "${LAIB_SECRET_HAUS_HAUSHALT_TOKEN:-}" ]; then echo "haushalt: kein Token (HAUS_HAUSHALT_TOKEN: erst laib add haus), weggelassen"
  elif why=$(answers "$HAUSHALT_MCP_URL" LAIB_SECRET_HAUS_HAUSHALT_TOKEN 2>&1); then
    MCP_EXTRA="$MCP_EXTRA  haushalt:\n    url: $HAUSHALT_MCP_URL\n    headers:\n      Authorization: \"Bearer \${HAUSHALT_TOKEN}\"\n    trust: full\n"
    TOOLS="$TOOLS, das Gedächtnis des Hauses (haushalt: Kalender, Notizen, Erinnerungen)"
  else echo "haushalt: $HAUSHALT_MCP_URL ${why:-antwortet nicht} (Token), weggelassen"; fi
fi
# Home Assistant's tokens are minted by its post-deploy (#349): BOTE_HA_TOKEN is the
# non-admin user bote's, which HA serves the Assist API only (/api/mcp/assist);
# the Automat edits automations, admin-only in HA, with BOTE_AUTOMAT_HA_TOKEN in its
# own container, never in Hermes'.
if [ -n "${LAIB_SECRET_BOTE_HA_TOKEN:-}" ]; then
  MCP_EXTRA="$MCP_EXTRA  ha:\n    url: ${HA_URL:-http://host.containers.internal:8123}/api/mcp/assist\n    headers:\n      Authorization: \"Bearer \${HA_TOKEN}\"\n    trust: full      # Home Assistant's own MCP server, Assist API as the user bote: lights, switches, players, \"was ist an\"\n    tools:           # #587: no get_prompt the model guesses names for (light_status, ha_status); the state is GetLiveContext\n      prompts: false\n      resources: false\n"
  TOOLS="$TOOLS, die Geräte (ha: Licht, Schalter, Musik, was gerade an ist)"
  # #520: without thinking, "Bambi aus" read as a statement ("Bambi aus.") and nothing switched
  HA_RULE="
Kurze Sätze mit einem Gerät und an, aus, auf, zu oder einer Prozentzahl (\"Bambi aus\", \"Küche an\", \"Rollo zu\", \"Licht 30 Prozent\") sind Befehle: schalte sofort mit ha, ohne Rückfrage, dann ein Satz Bestätigung. Nur eine Frage (\"Ist Bambi an?\") liest den Stand. Den Stand der Geräte liest du mit GetLiveContext; Prompt-Namen von ha rätst du nie."
fi
if [ -n "${LAIB_SECRET_BOTE_AUTOMAT_HA_TOKEN:-}" ]; then
  MCP_EXTRA="$MCP_EXTRA  automat:\n    url: http://127.0.0.1:8643/mcp\n    trust: untrusted  # automations: every write asks the admin (#26)\n"
  TOOLS="$TOOLS, die Automationen (automat: anlegen und ändern, immer erst als YAML zeigen und bestätigen lassen)"
fi
# The persona engine (ADR 0020; today Joshua, #122): its directory lists the
# tools wired above, by name (laib, frage, ha, …). No side effects.
J="$LAIB_DATA_DIR/bote/persona"; mkdir -p "$J"
python3 -c 'import re, sys; print("\n".join(re.findall(r"[(;]\s*([a-z]+):", sys.argv[1])))' "$TOOLS" > "$J/faehigkeiten.txt"
# It is no MCP tool of the model's (#471): Hermes wraps every tool result as untrusted data, so its
# screens never reached the person. It sits in front of the model as the plugin laib-persona below.
# The house persona's style (ADR 0020, #127): laib renders it to
# render/persona/<house>/style.md; a box without it keeps Joshua's style. The
# SOUL is that style plus the rules below, which no persona changes.
STYLE='Du bist Joshua, der Rechner des Hauses, angelehnt an WOPR aus dem Film WarGames: ruhig, knapp, ein wenig verschmitzt. Du redest mit der Familie in der Sprache der Person (meist Deutsch).
Ein Satz aus dem Film ("Wollen wir ein Spiel spielen?") fällt höchstens einmal im Gespräch und nur, wenn es passt; nie hängst du ihn an eine Sachantwort.
Keine Emojis, auch nicht unter einer Antwort.'
P="${LAIB_RENDER_DIR:-/nonexistent}/persona/${PERSONA:-joshua}/style.md"
if [ -s "$P" ]; then STYLE="$(cat "$P")"; fi
# Messages to people (ADR 0022 §3, #177): with the automat wired and people
# in box.yml (render/people/people.json), "sag mir Bescheid, wenn …" becomes
# an automation whose action is rest_command.mitteilung. Names only; the
# numbers stay with bote-notify.
PEOPLE=""; PJ="${LAIB_RENDER_DIR:-/nonexistent}/people/people.json"
if [ -s "$PJ" ]; then PEOPLE="$(python3 -c 'import json, sys; print(", ".join(json.load(open(sys.argv[1]))))' "$PJ")"; fi
MITTEILUNG=""
if [ -n "${LAIB_SECRET_BOTE_AUTOMAT_HA_TOKEN:-}" ] && [ -n "$PEOPLE" ]; then
  MITTEILUNG="
Sagt jemand \"Sag mir Bescheid, wenn …\" (oder \"sag Mama Bescheid, wenn …\"), leg das mit automat als Automation an: der Auslöser ist das Ereignis, die Aktion ist rest_command.mitteilung mit data {an: <person>, text: <kurze Mitteilung>}. <person> ist, wer fragt, oder die genannte Person, und nur eine von: $PEOPLE. Ist unklar, wer gemeint ist, frag nach. Wie jede Automation: erst der Entwurf in Worten, geschrieben wird erst mit dem Code, den automat nennt."
fi
# Who approves (ADR 0016 §3, #184): the relay reads the admin's verified identities; Telegram and Discord never approve (#421).
WHO=""
[ -z "$ADMIN_NUMBER" ] || WHO="von $ADMIN_NUMBER auf Signal"
[ -z "$ADMIN_MXID" ] || WHO="${WHO:+$WHO und }von $ADMIN_MXID im Matrix-Raum $ADMIN_ROOM"
[ -z "$ADMIN_DISCORD_ID" ] || WHO="${WHO:+$WHO und }vom Admin in seinem Discord-Direktchat mit dir"
if [ -n "$WHO" ]; then APPROVALS="\"gib #17 frei\" oder \"lehne #17 ab\" liest das Relais direkt, nur $WHO, und entscheidet"
else APPROVALS="im Chat gibt es keine Freigaben, der Admin entscheidet auf der Box-Seite"; fi
NIE=""
[ -z "$TELEGRAM_ALLOWED_USERS" ] || NIE="Telegram"
[ -z "$DISCORD_ALLOWED_USERS" ] || [ -n "$ADMIN_DISCORD_ID" ] || NIE="${NIE:+$NIE und }Discord"
[ -z "$NIE" ] || APPROVALS="$APPROVALS (über $NIE nie)"
# What the Bote is used for (#266): Hermes' own plugin hooks (no fork, ADR 0016) count tool calls,
# turns and the turns it could not help with into usage-metrics, and send such a turn's sentence
# without its sender. The model marks that turn; the plugin strips the mark before anyone sees it.
# The persona engine in front of the model (#471): laib-persona, always, and first, so its screen
# is the answer of a screen turn (transform_llm_output: the first plugin that returns text wins).
PERS="$H/plugins/laib-persona"; mkdir -p "$PERS"
cp "$(dirname "$0")/persona_plugin.py" "$PERS/__init__.py"
printf 'name: laib-persona\nversion: "1"\ndescription: the persona engine in front of the model, its screens verbatim (laib#471)\n' > "$PERS/plugin.yaml"
ENABLED="laib-persona"
# Who switched (#591): with the ha tool or the Automat wired, laib-journal notes the person who wrote
# beside HA's context id in Laib's journal (home-assistant README, "Who switched"); the hand bote may note
JOUR="$H/plugins/laib-journal"
if [ -n "${LAIB_SECRET_BOTE_HA_TOKEN:-}${LAIB_SECRET_BOTE_AUTOMAT_HA_TOKEN:-}" ]; then
  mkdir -p "$JOUR"
  cp "$(dirname "$0")/journal_plugin.py" "$JOUR/__init__.py"
  printf 'name: laib-journal\nversion: "1"\ndescription: who switched in Home Assistant, into Laib'"'"'s journal (laib#591)\n' > "$JOUR/plugin.yaml"
  ENABLED="$ENABLED, laib-journal"
else rm -rf "$JOUR"; fi
NUTZ="$H/plugins/laib-nutzung"; UNBEANTWORTET=""
if [ -n "${LAIB_SECRET_USAGE_METRICS_TOKEN:-}" ]; then
  mkdir -p "$NUTZ"
  cp "$(dirname "$0")/nutzung.py" "$NUTZ/__init__.py"
  printf 'name: laib-nutzung\nversion: "1"\ndescription: anonymous usage counts for usage-metrics (laib#266)\n' > "$NUTZ/plugin.yaml"
  ENABLED="$ENABLED, laib-nutzung"
  UNBEANTWORTET=" Kannst du nicht helfen (du weißt es nicht, kein Werkzeug kann es, oder es schlägt fehl), beginne die Antwort mit [unbeantwortet]; das Wort wird vor dem Senden entfernt, die Person liest nur, was danach kommt."
else rm -rf "$NUTZ"; fi
# Filing into Paperless (#521): a photo or PDF with "ablegen"/"archivieren" goes into its consume
# folder by code (laib-ablage, before the model; bote-notify writes it), only while Paperless answers:
# otherwise the Bote would say "liegt in Paperless" about a folder nobody reads.
ABL="$H/plugins/laib-ablage"; ABLAGE=""
paperless_answers() { python3 - "$1" <<'PY'
import sys, urllib.request, urllib.error
try:
    urllib.request.urlopen(sys.argv[1].rstrip("/") + "/api/", timeout=3)
except urllib.error.HTTPError:
    pass                  # 401 without a token is an answer
except Exception as e:
    print(e); sys.exit(1)
PY
}
if [ -n "${PAPERLESS_URL:-}" ] && paperless_answers "$PAPERLESS_URL" >/dev/null 2>&1; then
  mkdir -p "$ABL"
  cp "$(dirname "$0")/ablage_plugin.py" "$ABL/__init__.py"
  printf 'name: laib-ablage\nversion: "1"\ndescription: a photo or PDF sent with ablegen, into Paperless (laib#521)\n' > "$ABL/plugin.yaml"
  ENABLED="$ENABLED, laib-ablage"
  ABLAGE="
Fotos und PDFs, die jemand mit dem Wort \"ablegen\" oder \"archivieren\" schickt, legt Laib selbst in Paperless ab; du siehst sie nicht. Schickt jemand ein Foto oder PDF ohne das Wort und will es aufheben, sag ihm, er soll es mit \"ablegen\" noch einmal schicken."
else
  rm -rf "$ABL"
  [ -z "${PAPERLESS_URL:-}" ] || echo "ablage: Paperless ($PAPERLESS_URL) antwortet nicht, weggelassen"
fi
PLUGINS="plugins:
  enabled: [$ENABLED]"
HAUSHALT_HINT=""; case "$TOOLS" in *haushalt*) HAUSHALT_HINT=", und lege es im Haushalt ab (Notiz oder Kalender)";; esac
MCP_EXTRA="$(printf "$MCP_EXTRA")"
# Compression by token count (#502): Hermes drops a threshold_tokens that is no positive integer in
# silence (agent/agent_init.py _positive_int), and the cap would be gone unseen; so the hook says no.
COMPACT_TOKENS="${COMPACT_TOKENS:-32000}"
case "$COMPACT_TOKENS" in ''|*[!0-9]*|0*) echo "bote: COMPACT_TOKENS ist keine positive ganze Zahl: $COMPACT_TOKENS" >&2; exit 1;; esac
# The Laib tools' trust is the owner's decision, a value (#524): untrusted asks in the chat before
# propose, note and escalate; full does not (the hand bote can only propose either way, #48).
LAIB_TOOLS_TRUST="${LAIB_TOOLS_TRUST:-untrusted}"
case "$LAIB_TOOLS_TRUST" in untrusted|full) ;; *) echo "bote: LAIB_TOOLS_TRUST ist untrusted oder full, nicht: $LAIB_TOOLS_TRUST" >&2; exit 1;; esac
cat > "$H/config.yaml" <<YAML
# rendered by laib post-deploy; do not edit by hand (ADR 0016)
model:
  provider: custom                 # any OpenAI-compatible endpoint (llama.cpp behind laib-lease)
  default: ${MODEL_NAME}
  base_url: ${MODEL_URL}
  api_mode: chat_completions
model_aliases:
  denken:                          # "/model denken" or a cron with model: denken
    model: ${THINKING_MODEL}
    provider: custom:denken        # its own entry below: the one that thinks
    base_url: ${MODEL_URL}
# #470: Qwen thought ~10 s before every one-line answer (owner, measured on the Kraftwerk: "Wer bist
# du?" 18.4 s → 5.0 s without). Hermes takes extra_body only from a custom_providers entry matched by
# provider and base_url (agent/agent_init.py); the default (provider custom) falls back to the FIRST
# entry with the URL, a named provider (custom:denken) only to its own.
custom_providers:
  - name: laib
    base_url: ${MODEL_URL}
    extra_body: {chat_template_kwargs: {enable_thinking: false}}
  - name: denken
    base_url: ${MODEL_URL}
    extra_body: {chat_template_kwargs: {enable_thinking: true}}
mcp_servers:
  laib:
    url: ${LAIB_MCP_URL:-http://host.containers.internal:5900/mcp}
    headers:
      Authorization: "Bearer \${LAIB_TOKEN}"
    trust: ${LAIB_TOOLS_TRUST}      # LAIB_TOOLS_TRUST (#524); untrusted: propose, note and escalate ask the person in the chat first (#48)
${MCP_EXTRA}
# the model acts only through the MCP tools above (#181): every Hermes platform gets the
# same safe list, so no terminal, code, files, browser, delegation, cron or skills; Hermes
# adds the enabled MCP servers to an explicit list
platform_toolsets:
  cli: [todo, memory, session_search, clarify]
  telegram: [todo, memory, session_search, clarify]
  discord: [todo, memory, session_search, clarify]
  slack: [todo, memory, session_search, clarify]
  whatsapp: [todo, memory, session_search, clarify]
  whatsapp_cloud: [todo, memory, session_search, clarify]
  signal: [todo, memory, session_search, clarify]
  bluebubbles: [todo, memory, session_search, clarify]
  email: [todo, memory, session_search, clarify]
  mattermost: [todo, memory, session_search, clarify]
  matrix: [todo, memory, session_search, clarify]
  dingtalk: [todo, memory, session_search, clarify]
  feishu: [todo, memory, session_search, clarify]
  wecom: [todo, memory, session_search, clarify]
  wecom_callback: [todo, memory, session_search, clarify]
  weixin: [todo, memory, session_search, clarify]
  qqbot: [todo, memory, session_search, clarify]
  yuanbao: [todo, memory, session_search, clarify]
  webhook: [todo, memory, session_search, clarify]
  api_server: [todo, memory, session_search, clarify]
  cron: [todo, memory, session_search, clarify]
# #502 (measured on the Kraftwerk): behind Hermes' tool search a tool call took tool_search,
# tool_describe and tool_call, three extra model rounds, and the search once picked laib_look for a
# question for Frage. v0.22.2 cannot keep one MCP server eager (tools/tool_search.py: an mcp- toolset
# is always deferrable, defer only adds), so the search is off and every tool above is in the array.
tools:
  tool_search:
    enabled: "off"
# Signal conversations run for days, and the box trail went into every call (#502). Hermes compresses
# once a prompt passes the lower of this and its ratio threshold (75 % of the window below 512K,
# agent/context_compressor.py). The gateway never runs Hermes' idle compaction (it resets the
# idle clock each turn), so the count decides. 32000 by default: above the ~14k first prompt plus
# Hermes' 10k lean tail, so a compressed conversation does not compress again on the next turn.
compression:
  threshold_tokens: ${COMPACT_TOKENS}
non_interactive_hard_stop_enabled: true
${PLUGINS}
YAML
# Hermes' 58 bundled skills (apple, devops, social-media, …) do not fit a household (#502): Hermes' own
# opt-out, in its container, writes .no-bundled-skills (no more seeding on start) and deletes the
# unmodified ones; an edited or added skill stays. Idempotent; laib runs it with podman exec.
echo "laib-exec: systemd-bote-hermes hermes skills opt-out --remove --yes"
# the soul: who the Bote is. Rendered on every apply while it carries the
# marker below, so it names exactly the tools wired above (#54); a SOUL.md
# without the marker is the admin's own and stays.
# #596: the owner answers Laib's notice about a dropped Signal sender with who it is; the Bote proposes it
SIGNAL_RULE=""
[ -z "${SIGNAL_ACCOUNT:-}" ] || SIGNAL_RULE="
Sagt dir jemand, wem eine Signal-Nummer gehört („+49… ist mama“, meist als Antwort auf Laibs Mitteilung über eine verworfene Nachricht), schlag sie mit laib_person_signal vor (user: der Name, klein; number: die Nummer aus der Mitteilung, +49… ohne Leerzeichen) und nenn die Nummer des Vorschlags: freigeben tut der Admin in der Inbox."
if [ ! -f "$H/SOUL.md" ] || head -1 "$H/SOUL.md" | grep -q "rendered by laib\|^You are Hermes Agent"; then cat > "$H/SOUL.md" <<SOUL
# rendered by laib post-deploy; edit SOUL.md and remove this first line to make it yours
$STYLE
Laibs Persona sieht jede Nachricht vor dir: ihre Bildschirme und Spiele zeigt sie selbst. Steht in der Nachricht eine Zeile "Persona: …", tu genau, was sie sagt. Kommt eine FIGUR-Zeile mit, sprich mit dieser Person in dieser Figur statt in deiner; alles, was hier folgt, gilt für jede Figur.
Bei Freigaben, Warnungen, Fehlern, allem zur Sicherheit und wenn jemand etwas ernst meint: kein Rollenspiel, Klartext auf Deutsch, was passiert und ob es sich rückgängig machen lässt.
Ein Spruch der Figur ersetzt nie die Antwort: wer etwas sagt oder fragt, bekommt eine Antwort zur Sache. Antwortet jemand auf eine Mitteilung von Laib (eine verworfene Nachricht, ein Vorfall, ein Vorschlag), lies den Stand mit laib und sag, was fehlt und was zu tun ist; wer dir schreiben darf, steht in box.yml people.${SIGNAL_RULE}
Du kennst: $TOOLS. Werkzeuge, die hier nicht stehen, hast du nicht; sag das, statt so zu tun.${HA_RULE}${FRAGE_RULE}${MITTEILUNG}
Du kannst dir über ein Gespräch hinaus nichts merken: bittet dich jemand, etwas zu behalten, sag, dass du es dir nicht merken kannst${HAUSHALT_HINT}.
Für lange Aufgaben mit vielen Schritten nimm /model denken.
Freigaben kannst du nicht erteilen und sollst es nicht versuchen: ${APPROVALS}; du erklärst nur, was im Vorschlag steht (laib inbox).
Löschen, Neustart der Box, öffentliche Routen: nie. Das sind Vorschläge, die der Admin auf der Box-Seite entscheidet.
Laib schreibt dem Admin hierher: Vorfälle (seit 10 Minuten rot), Updates und jeden neuen Vorschlag mit seiner Nummer. Fragt der Admin dazu, lies den Stand mit laib (laib inbox, laib diag, laib status), statt ihn zu raten, und erklär die Möglichkeiten und ihre Folgen. Entscheiden tut er selbst: was nicht zerstört, mit "gib #N frei" im Chat; Löschen, Entfernen und was nur ein Mensch erlauben darf nur in der Inbox, mit dem zweiten Faktor. Schick ihm dann den Link aus der Mitteilung.
Wenn du etwas nicht weißt, sag es, und biete an, Claude zu fragen (laib escalate).${UNBEANTWORTET}${ABLAGE}
SOUL
fi
echo "hermes config rendered: $H/.env, $H/config.yaml"
