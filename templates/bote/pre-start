#!/usr/bin/env bash
# Renders the Bote's channel config before the units start (#184): Hermes'
# .env and bote-notify's copy of the platform lines. Hermes reads it on start
# and bote-notify's /health on every probe, so a channel switched off is gone
# before verify asks. post-deploy runs it again (it renders the rest).
set -euo pipefail
H="$LAIB_DATA_DIR/bote/hermes"
mkdir -p "$H"
# signal-cli's data belongs to the image's user, uid 1000 (#469): laib makes the folder as
# core, which is root in here and in the pod, and the daemon could not read its accounts
if [ -n "${SIGNAL_ACCOUNT:-}" ] && [ "$(id -u)" = 0 ]; then
  mkdir -p "$LAIB_DATA_DIR/bote/signal" && chown -R 1000:1000 "$LAIB_DATA_DIR/bote/signal"
fi
# laib's SOUL before Hermes' first start (#469): without one Hermes writes its stock
# "You are Hermes Agent" and the Bote introduced itself as Hermes. post-deploy renders the
# real one over anything with the marker; Hermes' stock text counts as replaceable.
if [ ! -f "$H/SOUL.md" ] || head -1 "$H/SOUL.md" | grep -q "^You are Hermes Agent"; then
  printf '%s\n%s\n' "# rendered by laib pre-start; post-deploy writes the Bote's soul" "Du bist der Bote dieses Haushalts. Einen Moment, ich werde gerade eingerichtet." > "$H/SOUL.md"
fi
# The channels (#184): each optional, at least one; an unset one writes no
# line, so Hermes starts no adapter for it. Names from Hermes' own config
# (gateway/config_env.py, plugins/platforms/*/plugin.yaml, 2026-10-14).
SIGNAL_ACCOUNT="${SIGNAL_ACCOUNT:-}" MATRIX_HOMESERVER="${MATRIX_HOMESERVER:-}" TELEGRAM_ALLOWED_USERS="${TELEGRAM_ALLOWED_USERS:-}"
DISCORD_ALLOWED_USERS="${DISCORD_ALLOWED_USERS:-}"
ADMIN_NUMBER="${ADMIN_NUMBER:-}" ADMIN_ROOM="${ADMIN_ROOM:-}"
if [ -z "$SIGNAL_ACCOUNT$MATRIX_HOMESERVER$TELEGRAM_ALLOWED_USERS$DISCORD_ALLOWED_USERS" ]; then echo "bote: kein Kanal (SIGNAL_ACCOUNT, MATRIX_HOMESERVER, TELEGRAM_ALLOWED_USERS oder DISCORD_ALLOWED_USERS)" >&2; exit 1; fi
if [ -n "$MATRIX_HOMESERVER" ] && [ -z "${LAIB_SECRET_BOTE_MATRIX_TOKEN:-}" ]; then echo "bote: Matrix ohne Token: laib secret set BOTE_MATRIX_TOKEN" >&2; exit 1; fi
if [ -n "$TELEGRAM_ALLOWED_USERS" ] && [ -z "${LAIB_SECRET_BOTE_TELEGRAM_TOKEN:-}" ]; then echo "bote: Telegram ohne Token: laib secret set BOTE_TELEGRAM_TOKEN" >&2; exit 1; fi
if [ -n "$DISCORD_ALLOWED_USERS" ] && [ -z "${LAIB_SECRET_BOTE_DISCORD_TOKEN:-}" ]; then echo "bote: Discord ohne Token: laib secret set BOTE_DISCORD_TOKEN" >&2; exit 1; fi
if [ -n "$ADMIN_NUMBER" ] && [ -z "$SIGNAL_ACCOUNT" ]; then echo "bote: ADMIN_NUMBER braucht Signal (SIGNAL_ACCOUNT)" >&2; exit 1; fi
# Who may talk (#586): the value, plus everyone in box.yml people with an id on the platform
# (render/people/people.json; a change there restarts the pod and runs this again). Signal's
# number and a Telegram DM's chat id are the sender's id; a Matrix or Discord target is a room or
# a channel, not a user, so those lists stay the value's. The value alone switches a channel on.
allowed() { python3 - "$1" "$2" "${LAIB_RENDER_DIR:-/nonexistent}/people/people.json" <<'PY'
import json, sys
platform, value, path = sys.argv[1:]
ids = [i.strip() for i in value.split(",") if i.strip()]
try:
    people = json.load(open(path))
except (OSError, ValueError):
    people = {}
for name in sorted(people):
    for ch in people[name]:
        p, _, target = ch.partition(":")
        if p == platform and target and target not in ids and not target.startswith("-"):   # a negative Telegram id is a group
            ids.append(target)
print(",".join(ids))
PY
}
[ -z "$SIGNAL_ACCOUNT" ] || SIGNAL_ALLOWED_USERS="$(allowed signal "${SIGNAL_ALLOWED_USERS:-}")"
[ -z "$TELEGRAM_ALLOWED_USERS" ] || TELEGRAM_ALLOWED_USERS="$(allowed telegram "$TELEGRAM_ALLOWED_USERS")"
# Hermes' notice to the owner about a dropped sender (#586) is Hermes' own text (locales/*.yaml):
# it names ~/.env and `hermes pairing`, neither is the way here. Hermes reads an overlay from
# $HERMES_HOME/locales/<lang>.yaml over its own (agent/i18n.py); it speaks en unless told otherwise.
# #596: it asks who it is and offers the people without a signal: id; the owner's answer reaches
# the Bote, which proposes the number (laib_person_signal) for the owner to approve. {who} is
# Hermes' "Name (+49…)"; a change to people restarts the pod, so the list stays current.
OHNE="$(python3 - "${LAIB_RENDER_DIR:-/nonexistent}/people/people.json" <<'PY'
import json, sys
try:
    people = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    people = {}
print(", ".join(n for n in sorted(people) if not any(c.startswith("signal:") for c in people[n])))
PY
)"
if [ -n "$OHNE" ]; then BEISPIEL="${OHNE%%,*}"; OHNE=" Noch ohne Signal-Nummer: $OHNE."; else BEISPIEL="<Name>"; fi
mkdir -p "$H/locales"
for lang in en de; do cat > "$H/locales/$lang.yaml" <<YAML
# rendered by laib pre-start; do not edit by hand (#586, #596)
gateway:
  unauthorized:
    owner_notice: "Laib hat eine Nachricht von {who} auf {platform} verworfen: der Absender steht bei keiner Person in box.yml people. Wer ist das? Gehört er zum Haushalt, antworte mir hier, etwa „{who} ist $BEISPIEL“.$OHNE Ich schlage seine Nummer dann vor, du gibst den Vorschlag in der Inbox frei, und danach darf er dem Boten schreiben; die verworfene Nachricht schickt er noch einmal. Auf anderen Wegen als Signal trag seine Kennung selbst in box.yml people ein."
YAML
done
{
  echo "# rendered by laib pre-start; do not edit by hand"
  if [ -n "$SIGNAL_ACCOUNT" ]; then
    echo "SIGNAL_HTTP_URL=http://127.0.0.1:8080"
    echo "SIGNAL_ACCOUNT=$SIGNAL_ACCOUNT"
    echo "SIGNAL_ALLOWED_USERS=${SIGNAL_ALLOWED_USERS:-}"
    [ -z "$ADMIN_NUMBER" ] || echo "SIGNAL_HOME_CHANNEL=$ADMIN_NUMBER"
  fi
  if [ -n "$MATRIX_HOMESERVER" ]; then
    echo "MATRIX_HOMESERVER=$MATRIX_HOMESERVER"
    echo "MATRIX_ACCESS_TOKEN=$LAIB_SECRET_BOTE_MATRIX_TOKEN"
    [ -z "${MATRIX_ALLOWED_USERS:-}" ] || echo "MATRIX_ALLOWED_USERS=$MATRIX_ALLOWED_USERS"
    # unencrypted rooms only (ADR 0016 §3): bote-notify's `hermes send` shares the Bote's
    # token, and a second process on an E2EE device would take its to-device keys
    echo "MATRIX_E2EE_MODE=off"
    [ -z "$ADMIN_ROOM" ] || echo "MATRIX_HOME_ROOM=$ADMIN_ROOM"
  fi
  if [ -n "$TELEGRAM_ALLOWED_USERS" ]; then
    echo "TELEGRAM_BOT_TOKEN=$LAIB_SECRET_BOTE_TELEGRAM_TOKEN"
    echo "TELEGRAM_ALLOWED_USERS=$TELEGRAM_ALLOWED_USERS"
  fi
  if [ -n "$DISCORD_ALLOWED_USERS" ]; then
    # Hermes' names (plugins/platforms/discord/gateway_env.py, #421); in a DM no mention is needed
    echo "DISCORD_BOT_TOKEN=$LAIB_SECRET_BOTE_DISCORD_TOKEN"
    echo "DISCORD_ALLOWED_USERS=$DISCORD_ALLOWED_USERS"
  fi
  echo "LAIB_TOKEN=${LAIB_SECRET_BOTE_LAIB_TOKEN}"
  echo "MODEL_API_KEY=${LAIB_SECRET_BOTE_MODEL_KEY:-llama}"
  echo "HA_TOKEN=${LAIB_SECRET_BOTE_HA_TOKEN:-}"
  echo "HAUSHALT_TOKEN=${LAIB_SECRET_HAUS_HAUSHALT_TOKEN:-}"
  echo "GESUNDHEIT_TOKEN=${LAIB_SECRET_GESUNDHEIT_BOTE_TOKEN:-}"
  # the plugin laib-journal (#591) notes who switched in HA: to Laib with LAIB_TOKEN, the context id from HA
  echo "LAIB_MCP_URL=${LAIB_MCP_URL:-http://host.containers.internal:5900/mcp}"
  echo "HA_URL=${HA_URL:-http://host.containers.internal:8123}"
  echo "HERMES_NON_INTERACTIVE=1"
  # the plugin laib-nutzung (#266) reads these; without usage-metrics' token no line and no plugin
  if [ -n "${LAIB_SECRET_USAGE_METRICS_TOKEN:-}" ]; then
    echo "USAGE_METRICS_URL=${USAGE_URL:-http://host.containers.internal:8094}"
    echo "USAGE_METRICS_TOKEN=$LAIB_SECRET_USAGE_METRICS_TOKEN"
  fi
  # Hermes' API server, for Haus's Sprechen field (#215): on only with a key (gateway/config_env.py
  # _api_server; apply generates BOTE_API_KEY), on the pod's interfaces so the published 8642 reaches it
  if [ -n "${LAIB_SECRET_BOTE_API_KEY:-}" ]; then
    echo "API_SERVER_KEY=$LAIB_SECRET_BOTE_API_KEY"
    echo "API_SERVER_HOST=0.0.0.0"
  fi
} > "$H/.env"
chmod 600 "$H/.env"
# Who wrote (#591): Hermes knows the sender's id, laib-journal names the person; box.yml people
# turned round, "signal:+49…" to the name, for the ids that are a person's (as for the allowed lists)
( umask 077; python3 - "${LAIB_RENDER_DIR:-/nonexistent}/people/people.json" > "$H/personen.json" <<'PY'
import json, sys
try:
    people = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    people = {}
print(json.dumps({ch: name for name in sorted(people) for ch in people[name]
                  if ch.partition(":")[0] in ("signal", "telegram") and ch.partition(":")[2][:1] not in ("", "-")}))
PY
)
chmod 600 "$H/personen.json"
# bote-notify (#177) gets the platform credentials only: no Bote token, no
# model key, nothing else of HERMES_HOME (sessions, memory).
N="$LAIB_DATA_DIR/bote/notify"; mkdir -p "$N"
( umask 077; grep -E '^(SIGNAL|TELEGRAM|MATRIX|DISCORD|SLACK|WHATSAPP|EMAIL|SMS|TWILIO)_|^HERMES_NON_INTERACTIVE=' "$H/.env" > "$N/.env" || true )
chmod 600 "$N/.env"
