[Unit]
Description=Stimme: Piper TTS (Wyoming, 10200)
After=network-online.target

[Container]
Image=${PIPER_IMAGE}
# host network: Home Assistant reaches it on the host's loopback, the pods at host.containers.internal
Network=host
# the house's voice, Piper's Thorsten (ADR 0030). Beyond loopback so pods on the box reach it at
# host.containers.internal:10200 (foundry-chronicle's chronik, #242); lan: false keeps the LAN out.
Exec=--voice de_DE-thorsten-high --uri tcp://0.0.0.0:10200 --data-dir /data --download-dir /data
Volume=${DATA_DIR}/stimme/piper:/data:z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
