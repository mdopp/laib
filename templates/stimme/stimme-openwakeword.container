[Unit]
Description=Stimme: openWakeWord (Wyoming, 10400)
After=network-online.target

[Container]
Image=${OPENWAKEWORD_IMAGE}
Network=host
# serves streaming satellites; the Voice PE wakes on the device (microWakeWord,
# stimme/micro). No preload: a satellite asks for its model by name (#128).
Exec=--uri tcp://127.0.0.1:10400 --custom-model-dir /custom
Volume=${DATA_DIR}/stimme/wakeword:/custom:z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
