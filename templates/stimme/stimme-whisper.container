[Unit]
Description=Stimme: Whisper STT (Wyoming, 10300)
After=network-online.target

[Container]
Image=${WHISPER_IMAGE}
Network=host
Environment=WHISPER_MODEL=${WHISPER_MODEL}
Environment=WHISPER_LANG=${WHISPER_LANG}
Environment=WHISPER_BEAM=1
# the household's names from Home Assistant as Whisper's initial prompt, read at start: stimme-names.service
# writes the file and restarts Whisper when the names change. A missing file stops Whisper, so ExecStartPre makes it
Environment=WYO_WHISPER_INITIAL_PROMPT_FILE=/config/laib-names.txt
# required: Quadlet passes an optional "-" to podman --env-file as part of the path (#557); llama's pre-start writes the file
EnvironmentFile=${VOICE_ENV}
Volume=${DATA_DIR}/stimme/whisper:/config:z
# Stimme's status: stimme-names writes whether the devices run the persona's wake word (#759)
Volume=${DATA_DIR}/stimme/micro:/micro:z
# the household's recordings, read-only: stimme-names counts them into that status and offers a retrain (#828)
Volume=${DATA_DIR}/stimme/recordings:/recordings:ro
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
AutoUpdate=registry

[Service]
# the folder belongs to the container's user (linuxserver's abc), so the host's user creates it in
# podman's user namespace; a plain touch is refused (Permission denied, v0.33.0 on the box)
ExecStartPre=/usr/bin/podman unshare touch ${DATA_DIR}/stimme/whisper/laib-names.txt
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
