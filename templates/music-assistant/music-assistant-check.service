# music-assistant's detail line on the Box page (#785): music-assistant-check.py
# in a stock Python image, fed on stdin (as kalender-abgleich), on the host
# network where Music Assistant listens (8095). It reads the speakers, which
# play now and the titles through MA's command API with the token post-deploy
# minted, and writes the status file laib.yml declares. laib starts it when
# someone looks and the file is older than its stale; the timer every 15
# minutes. The token reaches podman through the environment, never on argv.
[Unit]
Description=Music Assistant: Lautsprecher und Titel für laibs Status
After=music-assistant.service

[Service]
Type=oneshot
Environment=MA_TOKEN=${MA_TOKEN}
StandardInput=file:%h/.config/containers/systemd/music-assistant/music-assistant-check.py
ExecStart=/usr/bin/podman run --rm -i --name music-assistant-check --network host --security-opt label=disable -e MA_TOKEN -e MA_URL=http://127.0.0.1:8095 -e STATUS_DIR=/data -v ${DATA_DIR}/music-assistant/check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
