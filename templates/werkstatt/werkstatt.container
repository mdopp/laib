[Unit]
Description=Werkstatt — the one place where agents build (Claude Code, pi, repos)

[Container]
Image=${IMAGE}
PublishPort=${SSH_PORT}:22
# pi in the browser (#384): the host's loopback only, Caddy and Authelia in front
PublishPort=127.0.0.1:8791:8791
# quoted: Quadlet splits Environment= on whitespace, and a public key has two spaces
Environment="WERKSTATT_AUTHORIZED_KEY=${AUTHORIZED_KEY}"
Environment=WERKSTATT_SSH_PASSWORD=${SSH_PASSWORD}
Environment=CLAUDE_CODE_OAUTH_TOKEN=${CLAUDE_TOKEN}
# the werkstatt hand: each Claude session gets its own claude token with it (#380)
Environment=LAIB_WERKSTATT_TOKEN=${WERKSTATT_TOKEN}
Environment=LAIB_MCP_URL=http://host.containers.internal:5900/mcp
Environment=MODEL_URL=${MODEL_URL}
Environment=MODEL_KEY=${MODEL_KEY}
# the web pi (#384): its hand and the name it answers to
Environment=LAIB_PI_TOKEN=${LAIB_PI_TOKEN}
Environment=WERKSTATT_DOMAIN=${DOMAIN}
# the sessions' permission mode (#898): default asks, bypass does not
Environment=WERKSTATT_PERMISSION_MODE=${PERMISSION_MODE}
Volume=${DATA_DIR}/werkstatt/workspace:/workspace:z
# dev's home (#241): ~/.claude, ~/.claude.json, dotfiles, history; ~/.cache
# (npm, go, pip) is its own data path, not backed up; sshd's host keys, made once.
# A unit file has no trailing comments: they would be part of the value.
Volume=${DATA_DIR}/werkstatt/home:/home/dev:z
Volume=${DATA_DIR}/werkstatt/cache:/home/dev/.cache:z
Volume=${DATA_DIR}/werkstatt/ssh-host-keys:/etc/ssh/keys:z
# the entrypoint's status line for laib status werkstatt (#898)
Volume=${DATA_DIR}/werkstatt/status:/var/lib/werkstatt-status:z
# this container's tokens, not the shared volume (#44)
Tmpfs=/run/laib
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
