[Unit]
Description=Vaultwarden — Passwörter (SSO über Authelia)

[Container]
Image=${IMAGE}
PublishPort=127.0.0.1:8222:8222
Environment=TZ=${TZ}
Environment=DOMAIN=https://vault.${DOMAIN}
Environment=SIGNUPS_ALLOWED=${SIGNUPS}
Environment=ADMIN_TOKEN=${ADMIN_TOKEN}
Environment=ROCKET_PORT=8222
Environment=SSO_ENABLED=true
Environment=SSO_ONLY=false
Environment=SSO_AUTHORITY=https://auth.${DOMAIN}
Environment=SSO_CLIENT_ID=vaultwarden
Environment=SSO_CLIENT_SECRET=${SSO_SECRET}
Environment=SSO_SCOPES=email profile offline_access
# Authelia for the OIDC discovery and the token exchange: the host gateway is the
# host (Caddy on 443); under pasta the container has the host's own address, so
# the LAN IP would stay inside it (ServiceBay #817, #252)
AddHost=auth.${DOMAIN}:host-gateway
Volume=${DATA_DIR}/vaultwarden/data:/data:z
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always

[Install]
WantedBy=default.target
