[Unit]
Description=Samba — die LAN-Freigabe
After=network-online.target

[Container]
Image=${SAMBA_IMAGE}
Network=host
Environment=TZ=${TZ}
Environment=ACCOUNT_${SHARE_USER}=${SHARE_PW}
Environment="SAMBA_VOLUME_CONFIG_data=[data]; path=/data; browseable=yes; read only=no; valid users=${SHARE_USER}"
Environment="SAMBA_GLOBAL_STANZA=server min protocol = SMB2"
Volume=${DATA_DIR}/file-share/data:/data:z
Volume=${DATA_DIR}/file-share/samba-private:/var/lib/samba/private:z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
