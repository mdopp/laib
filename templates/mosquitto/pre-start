#!/usr/bin/env bash
# pre-start (#221): mosquitto.conf before the broker's first start, and a
# password file it can open (without one it refuses to start). post-deploy
# writes the user's hash into it (#432). Rewritten on every apply.
set -euo pipefail
C="$LAIB_DATA_DIR/mosquitto/config"; mkdir -p "$C" "$LAIB_DATA_DIR/mosquitto/data"
cat > "$C/mosquitto.conf" <<CFG
# rendered by laib pre-start (templates/mosquitto)
listener 1883
allow_anonymous false
password_file /mosquitto/config/passwd
persistence true
persistence_location /mosquitto/data/
log_dest stdout
CFG
[ -e "$C/passwd" ] || (umask 077; : > "$C/passwd")
# eclipse-mosquitto 2.1 drops to its own user (1883) before it opens the
# password file and writes its persistence: both are that user's, as the
# broker's user namespace maps it (this hook runs in the same one, #248)
chown 1883:1883 "$C/passwd" "$LAIB_DATA_DIR/mosquitto/data"
echo "mosquitto.conf rendered"
