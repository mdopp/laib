#!/usr/bin/env bash
# post-deploy (#221): the password file, hashed by the image's own
# mosquitto_passwd inside the running broker. This hook has no podman: laib
# runs the laib-exec lines below in the broker's container, in order, after
# the hook exits. The password travels in the 0600 file, never on their argv,
# where ps shows it to every user on the box (#214). The file is written in
# plain text on every run, so -U never hashes a hash; SIGHUP to the broker
# (PID 1) reloads it.
set -euo pipefail
C="$LAIB_DATA_DIR/mosquitto/config"
(umask 077; printf '%s:%s\n' "$MQTT_USER" "$LAIB_SECRET_MQTT_PASSWORD" > "$C/passwd")
chmod 600 "$C/passwd"
echo "laib-exec: systemd-mosquitto mosquitto_passwd -U /mosquitto/config/passwd"
echo "laib-exec: systemd-mosquitto chown mosquitto:mosquitto /mosquitto/config/passwd"
echo "laib-exec: systemd-mosquitto kill -HUP 1"
echo "mosquitto passwd written for $MQTT_USER; the broker hashes and reloads it"
