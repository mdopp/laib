#!/usr/bin/env bash
# post-deploy (#221, #432): the password file, as mosquitto's own hash. The
# file never holds a plain-text line: eclipse-mosquitto 2.1.2 terminates on
# one ("Unable to decode line in password file"), so writing the password and
# having the broker hash it (mosquitto_passwd -U) left no broker to hash in.
# The hash is mosquitto's $7$ (PBKDF2-SHA512, 101 rounds, 12-byte salt),
# computed here; a line that still matches the password is kept, so an apply
# that changed nothing changes nothing. The password reaches python through
# the environment, never argv (#214). SIGHUP to the broker (PID 1) reloads.
#
# Two logins: MQTT_USER (Home Assistant and the house's devices) and `scan`,
# the scan service's bridge to Home Assistant (homes ADR 0004 §6). Its
# password is minted here, as Home Assistant mints Homes's token (#349): a
# new one is handed back as SCAN_MQTT_PASSWORD, and the scan service, which
# declares it, is applied again with it. It exists whether or not scan is
# installed, like HA's tokens; nobody but secrets.age holds it then.
set -euo pipefail
C="$LAIB_DATA_DIR/mosquitto/config"
(umask 077; python3 - "$C/passwd" <<'PY'
import base64, hashlib, os, secrets, sys
path = sys.argv[1]
scan = os.environ.get("LAIB_SECRET_SCAN_MQTT_PASSWORD", "")
if not scan:
    scan = secrets.token_urlsafe(32)
    print("laib-secret: SCAN_MQTT_PASSWORD=" + scan)   # stored in secrets.age, never printed again
want = {os.environ["MQTT_USER"]: os.environ["LAIB_SECRET_MQTT_PASSWORD"], "scan": scan}

def matches(h, pw):
    p = h.split("$")
    if len(p) != 5 or p[1] != "7":
        return False
    salt, hashed = base64.b64decode(p[3]), base64.b64decode(p[4])
    return hashlib.pbkdf2_hmac("sha512", pw.encode(), salt, int(p[2]), len(hashed)) == hashed

def line(user, pw):
    salt = os.urandom(12)
    h = hashlib.pbkdf2_hmac("sha512", pw.encode(), salt, 101, 64)
    return f"{user}:$7$101${base64.b64encode(salt).decode()}${base64.b64encode(h).decode()}"

try:
    old = open(path).read().splitlines()
except FileNotFoundError:
    old = []
hashes = [l for l in old if l.partition(":")[2].startswith("$7$")]   # any line that is no hash goes (it would stop the broker)
users = {u: [l for l in hashes if l.partition(":")[0] == u] for u in want}
if len(hashes) == len(old) and all(len(m) == 1 and matches(m[0].partition(":")[2], want[u]) for u, m in users.items()):
    sys.exit(0)
# other users' hashes stay; each of ours is kept while it matches, else made again
keep = [l for l in hashes if l.partition(":")[0] not in want]
mine = [m[0] if len(m) == 1 and matches(m[0].partition(":")[2], want[u]) else line(u, want[u]) for u, m in users.items()]
with open(path + ".tmp", "w") as f:
    f.write("".join(l + "\n" for l in keep + mine))
os.replace(path + ".tmp", path)
PY
)
chmod 600 "$C/passwd"
# the broker's own user opens it (eclipse-mosquitto 2.1 drops to 1883, #248), and its group
# (#524, pre-start)
chown 1883:1883 "$C/passwd"
echo "laib-exec: systemd-mosquitto kill -HUP 1"
echo "mosquitto passwd holds the hashes for $MQTT_USER and scan; the broker reloads it"
