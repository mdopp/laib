# mosquitto's detail line on the Box page (#785): mosquitto-check.py in a stock
# Python image, fed on stdin (as kalender-abgleich), in the broker's own network
# namespace, so it asks Mosquitto on 127.0.0.1. One MQTT session as the MQTT
# user reads $SYS/broker/clients/connected and writes the status file laib.yml
# declares. laib starts it when someone looks and the file is older than its
# stale; the timer every 15 minutes. The password reaches podman through the
# environment, never on argv.
[Unit]
Description=Mosquitto: verbundene Geräte für laibs Status
After=mosquitto.service

[Service]
Type=oneshot
Environment=MQTT_PASSWORD=${MQTT_PW}
StandardInput=file:%h/.config/containers/systemd/mosquitto/mosquitto-check.py
ExecStart=/usr/bin/podman run --rm -i --name mosquitto-check --network container:systemd-mosquitto --security-opt label=disable -e MQTT_PASSWORD -e MQTT_USER=${MQTT_USER} -e MQTT_HOST=127.0.0.1 -e MQTT_PORT=1883 -e STATUS_DIR=/data -v ${DATA_DIR}/mosquitto/check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
