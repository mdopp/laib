# The Musik-Eingang (#639): musik-eingang.py runs inside the running beets
# container and imports what the family dropped into the share's
# musik-eingang folder (beets-eingang.timer, once a minute). It writes the
# status file laib.yml declares; laib also starts it when someone looks and
# the file is older than its stale. The script holds a lock: a run that
# finds another one still importing leaves it alone.
[Unit]
Description=beets: the Musik-Eingang into the music library
After=beets.service

# After the run, one message per upload through the Bote's bote-notify: the importer
# writes them into /config/musik-eingang/meldungen.jsonl (for the uploader Haus names
# in ._<name>.von, else box.yml notify.person), and musik-meldungen.sh sends them from
# here, the host, where bote-notify listens on loopback. "-": a message never fails
# the unit. The token is the sender's environment, never argv, and never the container's.
[Service]
Type=oneshot
Environment=MUSIK_MELDEN=${MUSIK_MELDEN}
Environment=NOTIFY_PERSON=${NOTIFY_PERSON}
Environment=NOTIFY_TOKEN=${NOTIFY_TOKEN}
Environment=MELDUNGEN=${DATA_DIR}/beets/config/musik-eingang/meldungen.jsonl
StandardInput=file:%h/.config/containers/systemd/beets/musik-eingang.py
ExecStart=/usr/bin/podman exec -i -e MUSIK_MELDEN -e NOTIFY_PERSON systemd-beets python3 -
ExecStartPost=-/bin/sh %h/.config/containers/systemd/beets/musik-meldungen.sh
TimeoutStartSec=2h
