[Unit]
Description=beets — Musik taggen und sortieren

[Container]
Image=${IMAGE}
PublishPort=127.0.0.1:8337:8337
Environment=TZ=${TZ}
Environment=PUID=0
Environment=PGID=0
Environment=BEETSDIR=/config
Volume=${DATA_DIR}/beets/config:/config:z
Volume=${MUSIC}:/music:z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
