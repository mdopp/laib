#!/usr/bin/env bash
# A first config.yaml: library in /config, music in /music, web UI on 8337.
set -euo pipefail
C="$LAIB_DATA_DIR/beets/config"; mkdir -p "$C"
[ -f "$C/config.yaml" ] && { echo "beets config kept"; exit 0; }
cat > "$C/config.yaml" <<CFG
# written once by laib post-deploy; edit freely afterwards
directory: /music
library: /config/library.db
import:
  move: yes
  write: yes
plugins: web fetchart lyrics
web:
  host: 0.0.0.0
  port: 8337
CFG
echo "beets config written"
