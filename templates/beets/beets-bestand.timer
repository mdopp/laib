[Unit]
Description=beets: den Musikbestand einsortieren, dreimal in der Stunde (#727)

[Timer]
# owner 2026-10-26: three runs an hour, start to start; a run still going
# when the next is due lets that one pass (systemd starts no second)
OnCalendar=*:00/20
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
