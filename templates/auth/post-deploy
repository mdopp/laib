#!/usr/bin/env python3
"""auth post-deploy (#36): LLDAP seeded with the groups admins and family and
the operator's account, through its GraphQL API on the host network (the
pod is up and verified green). Idempotent: seeding skips what exists. The
passwords, which LLDAP's GraphQL cannot set, go over its LDAP port as the
password modify operation (RFC 3062), from this process to LLDAP's socket:
never on a command line, where ps shows them to every user on the box
(#214). configuration.yml and the OIDC key are pre-start's."""
import json, os, socket, sys, time, urllib.request

E = os.environ
S = lambda n: E["LAIB_SECRET_" + n]
DOMAIN = E["LAIB_DOMAIN"]
op = E["OPERATOR_USER"]
READERS = [("radicale", "RADICALE_LDAP_PASSWORD", "Radicale (Lesekonto)"),
           ("file-share", "FILE_SHARE_LDAP_PASSWORD", "Netzlaufwerk (Lesekonto)")]
# checked before anything is created: an empty password binds anonymously, which
# proves nothing, and a name with DN specials ("," "+" ...) is another entry's DN
if not op or set(op) & set(',+"\\<>;=') or op[0] in "# " or op[-1] == " " or \
        not all(S(n) for n in ("LLDAP_ADMIN_PASSWORD", "OPERATOR_PASSWORD", *(r[1] for r in READERS))):
    print(f"OPERATOR_USER {op!r} is not a name LDAP can address, or a password is empty: nothing seeded", file=sys.stderr); sys.exit(1)

# seed LLDAP through its GraphQL API: groups, the operator's account
def http(path, body=None, token=None):
    req = urllib.request.Request("http://127.0.0.1:17170" + path, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json", **({"Authorization": "Bearer " + token} if token else {})})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)

token = None
for attempt in range(60):
    try:
        token = http("/auth/simple/login", {"username": "admin", "password": S("LLDAP_ADMIN_PASSWORD")})["token"]
        break
    except Exception:
        time.sleep(2)
if not token:
    print("LLDAP did not answer; groups and the operator account were NOT seeded (re-run laib apply auth)", file=sys.stderr); sys.exit(1)

def gql(query, variables=None):
    res = http("/api/graphql", {"query": query, "variables": variables or {}}, token)
    if res.get("errors"):
        raise RuntimeError(res["errors"])
    return res["data"]

# LDAP, as much of it as a bind and a password modify need: BER, definite lengths
def ber(tag, body):
    n = len(body)
    k = (n.bit_length() + 7) // 8
    return bytes([tag]) + (bytes([n]) if n < 128 else bytes([0x80 | k]) + n.to_bytes(k, "big")) + body

def tlv(b, i):
    tag, n, i = b[i], b[i + 1], i + 2
    if n & 0x80:
        n, i = int.from_bytes(b[i:i + (n & 0x7F)], "big"), i + (n & 0x7F)
    return tag, b[i:i + n], i + n

def ldap(dn, password, op=None):
    """binds as dn, then sends op; the first result code that is not success, with its message, or None"""
    with socket.create_connection(("127.0.0.1", 3890), timeout=10) as s:
        f = s.makefile("rb")
        bind = ber(0x60, ber(0x02, b"\x03") + ber(0x04, dn.encode()) + ber(0x80, password.encode()))
        for mid, req in enumerate([bind] + ([op] if op else []), 1):
            s.sendall(ber(0x30, ber(0x02, bytes([mid])) + req))
            head = f.read(2)
            n = int.from_bytes(f.read(head[1] & 0x7F), "big") if head[1] & 0x80 else head[1]
            msg = f.read(n)
            _, res, _ = tlv(msg, tlv(msg, 0)[2])
            _, code, i = tlv(res, 0)
            if code != b"\x00":
                return f"result {int.from_bytes(code, 'big')} {tlv(res, tlv(res, i)[2])[1].decode(errors='replace')}"
        s.sendall(ber(0x30, ber(0x02, bytes([mid + 1])) + b"\x42\x00"))  # unbind
    return None

dn = lambda uid: f"uid={uid},ou=people,{E['BASE_DN']}"

# set as the admin, then a bind with it: a set that did not take is red here,
# not a radicale that cannot log in later
def set_password(user, password):
    modify = ber(0x77, ber(0x80, b"1.3.6.1.4.1.4203.1.11.1") + ber(0x81, ber(0x30, ber(0x80, dn(user).encode()) + ber(0x82, password.encode()))))
    for what, args in (("set", (dn("admin"), S("LLDAP_ADMIN_PASSWORD"), modify)), ("bind with it", (dn(user), password))):
        if e := ldap(*args):
            print(f"LLDAP: {user}'s password: {what}: {e}", file=sys.stderr); sys.exit(1)
    print("password set:", user)

groups = {g["displayName"]: g["id"] for g in gql("{ groups { id displayName } }")["groups"]}
for name in ("admins", "family"):
    if name not in groups:
        groups[name] = gql("mutation($n:String!){ createGroup(name:$n){ id } }", {"n": name})["createGroup"]["id"]
        print("group created:", name)
users = {u["id"] for u in gql("{ users { id } }")["users"]}
if op not in users:
    gql("mutation($u:CreateUserInput!){ createUser(user:$u){ id } }",
        {"u": {"id": op, "email": E["OPERATOR_EMAIL"], "displayName": E.get("OPERATOR_DISPLAY", op)}})
    print("operator account created:", op)
    set_password(op, S("OPERATOR_PASSWORD"))
member = gql("query($id:String!){ user(userId:$id){ groups { displayName } } }", {"id": op})["user"]["groups"]
if "admins" not in {g["displayName"] for g in member}:
    gql("mutation($u:String!,$g:Int!){ addUserToGroup(userId:$u, groupId:$g){ ok } }", {"u": op, "g": groups["admins"]})
    print("operator added to admins")

# the read-only accounts other services read LLDAP with (#55): radicale looks
# users up through its own, file-share reads who is family (#296) — never as
# the LLDAP admin. lldap_strict_readonly is LLDAP's own group for exactly that.
if "lldap_strict_readonly" not in groups:
    groups["lldap_strict_readonly"] = gql("mutation($n:String!){ createGroup(name:$n){ id } }", {"n": "lldap_strict_readonly"})["createGroup"]["id"]
for reader, secret, display in READERS:
    if reader not in users:
        gql("mutation($u:CreateUserInput!){ createUser(user:$u){ id } }",
            {"u": {"id": reader, "email": reader + "@" + DOMAIN, "displayName": display}})
        print("read-only account created:", reader)
    # a service secret, not a person's password: set on every run, so a set that failed once
    # does not leave the reader without one for good (#209)
    set_password(reader, S(secret))
    rmember = gql("query($id:String!){ user(userId:$id){ groups { displayName } } }", {"id": reader})["user"]["groups"]
    if "lldap_strict_readonly" not in {g["displayName"] for g in rmember}:
        gql("mutation($u:String!,$g:Int!){ addUserToGroup(userId:$u, groupId:$g){ ok } }", {"u": reader, "g": groups["lldap_strict_readonly"]})
        print(reader, "added to lldap_strict_readonly")
print("lldap seeded: groups admins, family; operator", op)
