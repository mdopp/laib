#!/usr/bin/env python3
"""auth post-deploy (#36): LLDAP seeded with the groups admins and family and
the operator's account, through its GraphQL API on the host network (the
pod is up and verified green). Idempotent: seeding skips what exists. The
operator's password is set with LLDAP's own tool inside the pod, which laib
runs for us (`laib-exec:`) — this hook has no podman. configuration.yml
and the OIDC key are pre-start's."""
import json, os, sys, time, urllib.request

E = os.environ
S = lambda n: E["LAIB_SECRET_" + n]
DOMAIN = E["LAIB_DOMAIN"]

# seed LLDAP through its GraphQL API: groups, the operator's account
def http(path, body=None, token=None):
    req = urllib.request.Request("http://127.0.0.1:17170" + path, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json", **({"Authorization": "Bearer " + token} if token else {})})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)

token = None
for attempt in range(60):
    try:
        token = http("/auth/simple/login", {"username": "admin", "password": S("LLDAP_ADMIN_PASSWORD")})["token"]
        break
    except Exception:
        time.sleep(2)
if not token:
    print("LLDAP did not answer; groups and the operator account were NOT seeded (re-run laib apply auth)", file=sys.stderr); sys.exit(1)

def gql(query, variables=None):
    res = http("/api/graphql", {"query": query, "variables": variables or {}}, token)
    if res.get("errors"):
        raise RuntimeError(res["errors"])
    return res["data"]

groups = {g["displayName"]: g["id"] for g in gql("{ groups { id displayName } }")["groups"]}
for name in ("admins", "family"):
    if name not in groups:
        groups[name] = gql("mutation($n:String!){ createGroup(name:$n){ id } }", {"n": name})["createGroup"]["id"]
        print("group created:", name)
users = {u["id"] for u in gql("{ users { id } }")["users"]}
op = E["OPERATOR_USER"]
if op not in users:
    gql("mutation($u:CreateUserInput!){ createUser(user:$u){ id } }",
        {"u": {"id": op, "email": E["OPERATOR_EMAIL"], "displayName": E.get("OPERATOR_DISPLAY", op)}})
    print("operator account created:", op)
    # the password: LLDAP's GraphQL has no password mutation; its own tool in
    # the container does it. laib runs the line below in the pod's lldap
    # container (the hooks image has no podman; ADR 0004 amendment #36).
    print("laib-exec: systemd-auth-lldap /app/lldap_set_password --base-url http://127.0.0.1:17170 --admin-username admin"
          f" --admin-password {S('LLDAP_ADMIN_PASSWORD')} --username {op} --password {S('OPERATOR_PASSWORD')}")
member = gql("query($id:String!){ user(userId:$id){ groups { displayName } } }", {"id": op})["user"]["groups"]
if "admins" not in {g["displayName"] for g in member}:
    gql("mutation($u:String!,$g:Int!){ addUserToGroup(userId:$u, groupId:$g){ ok } }", {"u": op, "g": groups["admins"]})
    print("operator added to admins")

# the read-only account other services bind with (#55): radicale looks users up
# through it — never as the LLDAP admin. lldap_strict_readonly is LLDAP's own
# group for exactly that.
if "lldap_strict_readonly" not in groups:
    groups["lldap_strict_readonly"] = gql("mutation($n:String!){ createGroup(name:$n){ id } }", {"n": "lldap_strict_readonly"})["createGroup"]["id"]
if "radicale" not in users:
    gql("mutation($u:CreateUserInput!){ createUser(user:$u){ id } }",
        {"u": {"id": "radicale", "email": "radicale@" + DOMAIN, "displayName": "Radicale (Lesekonto)"}})
    print("laib-exec: systemd-auth-lldap /app/lldap_set_password --base-url http://127.0.0.1:17170 --admin-username admin"
          f" --admin-password {S('LLDAP_ADMIN_PASSWORD')} --username radicale --password {S('RADICALE_LDAP_PASSWORD')}")
    print("read-only account created: radicale")
rmember = gql("query($id:String!){ user(userId:$id){ groups { displayName } } }", {"id": "radicale"})["user"]["groups"]
if "lldap_strict_readonly" not in {g["displayName"] for g in rmember}:
    gql("mutation($u:String!,$g:Int!){ addUserToGroup(userId:$u, groupId:$g){ ok } }", {"u": "radicale", "g": groups["lldap_strict_readonly"]})
    print("radicale added to lldap_strict_readonly")
print("lldap seeded: groups admins, family; operator", op)
