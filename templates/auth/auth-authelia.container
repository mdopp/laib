[Unit]
Description=Authelia — forward-auth and OIDC (laib role: sso)
After=auth-lldap.service auth-sessions.service

[Container]
Image=${AUTHELIA_IMAGE}
Pod=auth.pod
Environment=TZ=${TZ}
Environment=X_AUTHELIA_CONFIG=/config/configuration.yml,/laib/laib-access.yml,/config/oidc-clients.yml
Environment=X_AUTHELIA_CONFIG_FILTERS=template
# the SMTP password as a podman secret (#224), read by configuration.yml's
# template (#359); empty without a mail server, and then nothing reads it
Environment=X_LAIB_SMTP_PASSWORD=${SMTP_PASSWORD}
Volume=${DATA_DIR}/auth/authelia-config:/config:z
Volume=${DATA_DIR}/auth/authelia-data:/data:z
Volume=/mnt/data/laib/render/authelia:/laib:ro,z
# no AutoUpdate: this service keeps a database; images change by proposal with a snapshot first (#46)

[Service]
Restart=always
# LLDAP in the same pod is ordered before (After=) but not necessarily listening
# yet: Authelia's LDAP check at start is fatal, and five quick retries would hit
# systemd's start limit (#36 VM run). Three seconds between tries never does.
RestartSec=3

[Install]
WantedBy=default.target
