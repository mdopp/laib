#!/usr/bin/env python3
"""auth pre-start (#36): Authelia's configuration.yml from the values, the
OIDC signing key and the OIDC clients (oidc-clients.yml), before the pod
starts — Authelia does not start without them, so this cannot wait for a
green verify. Idempotent: the config and the clients are rewritten on every
apply (values may change), the key is kept. LLDAP is seeded by
post-deploy. Runs in the hooks image, not on the host."""
import datetime, json, os, re, subprocess, sys

E = os.environ
D = E["LAIB_DATA_DIR"]
DOMAIN = E["LAIB_DOMAIN"]
cfg_dir = os.path.join(D, "auth", "authelia-config")
os.makedirs(cfg_dir, exist_ok=True)

conf_path = os.path.join(cfg_dir, "configuration.yml")
key_path = os.path.join(cfg_dir, "oidc.pem")

# 1. the OIDC signing key, generated once: a 4096-bit RSA key in PKCS#1 PEM
# (what Authelia's own `crypto pair rsa generate` writes); openssl is in the image
if not os.path.exists(key_path):
    r = subprocess.run(["openssl", "genrsa", "-traditional", "-out", key_path + ".tmp", "4096"], capture_output=True, text=True)
    if r.returncode != 0:
        print("could not generate the OIDC key:", r.stderr[-400:], file=sys.stderr); sys.exit(1)
    os.chmod(key_path + ".tmp", 0o600)
    os.replace(key_path + ".tmp", key_path)
    print("oidc signing key generated")
key = open(key_path).read().rstrip("\n")
indented = "\n".join("          " + line for line in key.splitlines())

# 2. configuration.yml (secrets arrive as LAIB_SECRET_*; nothing is logged)
S = lambda n: E["LAIB_SECRET_" + n]
q = lambda v: "'" + v.replace("'", "''") + "'"

# the notifier (#359): mail through the box's SMTP server when SMTP_HOST is
# set, else a file in /data that nobody reads. The password is no line in
# this file: it reaches the container as a podman secret (X_LAIB_SMTP_PASSWORD,
# auth-authelia.container) and Authelia's template filter reads it there, as
# a literal block, so no quote in it can end the YAML string. The startup
# check is off, as ServiceBay had it (#987): a mail server that is down or
# refuses a login must not keep everyone out of every app.
smtp = {k: E.get("SMTP_" + k, "").strip() for k in ("HOST", "PORT", "SECURITY", "USER", "FROM")}
sender = smtp["FROM"] or smtp["USER"]
scheme = {"starttls": "submission", "tls": "submissions", "none": "smtp"}.get(smtp["SECURITY"] or "starttls")
missing = [w for w, bad in (("SMTP_FROM (der Absender)", "@" not in sender), ("ein gültiges SMTP_SECURITY (starttls, tls, none)", not scheme),
                            ("das Passwort (laib secret set AUTHELIA_SMTP_PASSWORD)", smtp["USER"] and not E.get("SMTP_PASSWORD")))
           if bad] if smtp["HOST"] else []
if smtp["HOST"] and not missing:
    notifier = f"""notifier:
  disable_startup_check: true
  template_path: '/config/templates'
  smtp:
    address: {q(f'{scheme}://{smtp["HOST"]}:{smtp["PORT"] or 587}')}
    timeout: '10s'
    sender: {q(sender)}
    identifier: 'localhost'
    tls:
      server_name: {q(smtp["HOST"])}
      minimum_version: 'TLS1.2'
"""
    if smtp["SECURITY"] == "none":
        notifier += "    disable_require_tls: true\n"
    if smtp["USER"]:
        notifier += f"""    username: {q(smtp["USER"])}
    password: |2-
      {{{{ env "X_LAIB_SMTP_PASSWORD" }}}}
"""
    status = {"detail": f"Passwort-Mails über {smtp['HOST']}", "findings": []}
    print(f"notifier: smtp via {smtp['HOST']}")
else:
    notifier = """notifier:
  template_path: '/config/templates'
  filesystem:
    filename: '/data/notification.txt'
"""
    why = "SMTP_HOST ist leer" if not smtp["HOST"] else "es fehlt " + ", ".join(missing)
    status = {"detail": "Passwort-Mails gehen nicht (kein Mailserver)", "findings": [{
        "severity": "gelb",
        "detail": f"Passwort-Mails gehen nicht: {why}. „Passwort vergessen“, Einladungen und der Code vor dem zweiten Faktor landen in einer Datei auf der Box (auth/authelia-data/notification.txt)",
        "fix": "in services/auth/values.yml SMTP_HOST, SMTP_PORT, SMTP_SECURITY, SMTP_USER, SMTP_FROM setzen, laib secret set AUTHELIA_SMTP_PASSWORD, dann laib apply auth"}]}
    print("notifier: filesystem (" + why + ")")
# Authelia's regulation (#653): AUTH_MAX_RETRIES failed logins for one name
# within AUTH_FIND_TIME ban it for AUTH_BAN_TIME. Without the block Authelia
# bans after 3 in 2 minutes for 5 minutes, and nobody hears of it;
# anmeldungen.py reads the same values and tells the owner. A values.yml
# from before has none: the defaults. What Authelia would refuse stops here.
reg = {k: E.get(k, d).strip() for k, d in (("AUTH_MAX_RETRIES", "5"), ("AUTH_FIND_TIME", "10m"), ("AUTH_BAN_TIME", "30m"))}
bad = [k for k, v in reg.items() if not (re.fullmatch(r"[1-9][0-9]{0,2}", v) if k == "AUTH_MAX_RETRIES" else re.fullmatch(r"[1-9][0-9]*[smhd]", v))]
if bad:
    print("services/auth/values.yml: " + ", ".join(f"{k}={reg[k]!r}" for k in bad) +
          " is no value Authelia takes (AUTH_MAX_RETRIES a number 1-999, the times like 10m, 30m, 1h)", file=sys.stderr); sys.exit(1)
conf = f"""---
# rendered by laib pre-start (templates/auth); access rules come from /laib/laib-access.yml, OIDC clients from oidc-clients.yml
theme: dark
server:
  address: 'tcp://0.0.0.0:9091'
log:
  level: info
regulation:
  max_retries: {reg["AUTH_MAX_RETRIES"]}
  find_time: '{reg["AUTH_FIND_TIME"]}'
  ban_time: '{reg["AUTH_BAN_TIME"]}'
identity_validation:
  reset_password:
    jwt_lifespan: '24h'
    jwt_secret: '{S("AUTHELIA_JWT_SECRET")}'
authentication_backend:
  ldap:
    address: 'ldap://127.0.0.1:3890'
    base_dn: '{E["BASE_DN"]}'
    additional_users_dn: 'ou=people'
    users_filter: '(&(|({{username_attribute}}={{input}})({{mail_attribute}}={{input}}))(objectClass=person))'
    additional_groups_dn: 'ou=groups'
    groups_filter: '(member={{dn}})'
    user: 'uid=admin,ou=people,{E["BASE_DN"]}'
    password: '{S("LLDAP_ADMIN_PASSWORD")}'
    attributes:
      username: 'uid'
      display_name: 'displayName'
      mail: 'mail'
      group_name: 'cn'
session:
  secret: '{S("AUTHELIA_SESSION_SECRET")}'
  expiration: '1M'
  inactivity: '1M'
  remember_me: '1M'
  # in the pod's Valkey, on disk (auth-sessions.container): in memory, every
  # restart of the pod logged the household out (#369)
  redis:
    host: '127.0.0.1'
    port: 6379
  cookies:
    - domain: '{DOMAIN}'
      authelia_url: 'https://auth.{DOMAIN}'
      default_redirection_url: '{E["LAIB_START_URL"]}'
storage:
  encryption_key: '{S("AUTHELIA_STORAGE_KEY")}'
  local:
    path: '/data/db.sqlite3'
{notifier}# access_control: all of it in /laib/laib-access.yml, rendered by laib (#249).
# No rule here: Authelia replaces a list from an earlier file with the later
# file's instead of joining them, so a rule here would be dropped or, with the
# files in another order, decide alone (a wildcard would open the admin hosts).
"""
# 2c. the reset mail in German (#360): the same mail sets a first password
# (laib person invite) and a forgotten one, so it says both, and where the
# family goes next: Haus's welcome once Haus is installed, else the start page
# (#480: never a name the box does not serve). Authelia fills the {{ }}; the
# link lives 24 hours (jwt_lifespan above), long enough to pass it on by Signal.
welcome = E["LAIB_HAUS_URL"] + "willkommen" if E.get("LAIB_HAUS_URL") else E["LAIB_START_URL"]
tpl_dir = os.path.join(cfg_dir, "templates")
os.makedirs(tpl_dir, exist_ok=True)
TXT = """Hallo {{ .DisplayName }},

mit diesem Link setzt du dein Passwort für @DOMAIN@, das erste oder ein neues:

{{ .LinkURL }}

Der Link gilt 24 Stunden und nur einmal. Danach meldest du dich mit deinem
Benutzernamen und dem Passwort an. Los geht es hier: @WELCOME@

Hast du das nicht angefordert? Dann sperre den Link: {{ .RevocationLinkURL }}
"""
HTML = """<!DOCTYPE html>
<html lang="de"><body style="font-family: sans-serif; line-height: 1.5; max-width: 34em">
<p>Hallo {{ .DisplayName }},</p>
<p>mit diesem Link setzt du dein Passwort für @DOMAIN@, das erste oder ein neues:</p>
<p><a href="{{ .LinkURL }}" style="font-size: 1.1em">Passwort setzen</a></p>
<p>Der Link gilt 24 Stunden und nur einmal. Danach meldest du dich mit deinem Benutzernamen und dem Passwort an.
Los geht es hier: <a href="@WELCOME@">@WELCOME@</a></p>
<p style="color: #666; font-size: 0.9em">Hast du das nicht angefordert? Dann <a href="{{ .RevocationLinkURL }}">sperre den Link</a>.</p>
</body></html>
"""
for ext, body in (("txt", TXT), ("html", HTML)):
    with open(os.path.join(tpl_dir, "IdentityVerificationJWT." + ext + ".tmp"), "w") as f:
        f.write(body.replace("@DOMAIN@", DOMAIN).replace("@WELCOME@", welcome))
    os.replace(os.path.join(tpl_dir, "IdentityVerificationJWT." + ext + ".tmp"), os.path.join(tpl_dir, "IdentityVerificationJWT." + ext))

# 3. the OIDC clients, one list in one file (oidc-clients.yml): Laib's, rendered
# into /laib/laib-clients.yml (render/authelia; the hook runs again whenever it
# changes). Authelia replaces a list from a later config file instead of
# merging it, so two files with clients would leave one set out.
entries = lambda text: re.split(r"(?m)^(?=      - client_id: )", text)[1:]
try:
    laib = entries(open(os.path.join(E.get("LAIB_RENDER_DIR", "/mnt/data/laib/render"), "authelia", "laib-clients.yml")).read())
except OSError:
    laib = []
has_clients = bool(laib)
body = "identity_providers:\n  oidc:\n    clients:\n" + "".join(laib) if has_clients else ""
tmp = os.path.join(cfg_dir, "oidc-clients.yml.tmp")
with open(tmp, "w") as f:
    f.write("# rendered by laib pre-start (templates/auth): render/authelia/laib-clients.yml\n" + body)
os.chmod(tmp, 0o600)
os.replace(tmp, os.path.join(cfg_dir, "oidc-clients.yml"))
# OIDC only once a client exists: Authelia refuses an oidc block without
# clients (VM run 38161974424)
if has_clients:
    conf += f"""identity_providers:
  oidc:
    hmac_secret: '{S("AUTHELIA_OIDC_HMAC_SECRET")}'
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
{indented}
"""
else:
    print("no OIDC clients yet: identity_providers left out (Authelia refuses an empty block)")
tmp = conf_path + ".tmp"
with open(tmp, "w") as f:
    f.write(conf)
os.chmod(tmp, 0o600)
os.replace(tmp, conf_path)
print("authelia configuration.yml written")
# what auth says about itself (#309): laib diag and the Box page read it
status["at"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
tmp = os.path.join(cfg_dir, "laib-status.json.tmp")
with open(tmp, "w") as f:
    json.dump(status, f, ensure_ascii=False)
os.replace(tmp, os.path.join(cfg_dir, "laib-status.json"))
