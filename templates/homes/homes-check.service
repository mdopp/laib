# homes's detail line on the Box page (#785): homes-check.py in a stock Python
# image, fed on stdin (as kalender-abgleich), with Homes's folder mounted
# read-only and no network: it counts the devices signed in to the app from
# devices.json (never a hash) and writes the status file laib.yml declares, in
# homes-check beside Homes's folder (Homes relabels its own, :Z). Labelling is off
# here, so neither folder is relabelled. laib starts it when someone looks and
# the file is older than its stale; the timer every 15 minutes.
[Unit]
Description=Homes: angemeldete Geräte für laibs Status
After=homes.service

[Service]
Type=oneshot
StandardInput=file:%h/.config/containers/systemd/homes/homes-check.py
ExecStart=/usr/bin/podman run --rm -i --name homes-check --network none --security-opt label=disable -e HOMES_DATA=/homes -e STATUS_DIR=/data -v ${DATA_DIR}/homes:/homes:ro -v ${DATA_DIR}/homes-check:/data ${CHECK_IMAGE} python3 -
TimeoutStartSec=2min
