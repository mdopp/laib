# Automat: the Bote's Home Assistant automation tool (#26); one static binary.
FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /automat ./automat/cmd/automat
FROM scratch
COPY --from=build /automat /automat
EXPOSE 8643
ENTRYPOINT ["/automat"]
