[
  {"id": "crashed-container", "title": "Ein Container stirbt beim Start", "trigger": {"kind": "event", "service": "whoami", "detail": "unit whoami.service failed"},
   "replies": {"laib_status": "{\"ready\":{\"state\":\"bereit\",\"red\":1},\"services\":[{\"name\":\"whoami\",\"state\":\"rot\",\"units\":{\"whoami.service\":\"failed\"}}]}", "laib_logs": "Oct 11 03:12 whoami[1]: Error: bind: address already in use (8080)", "laib_restart": "grün · whoami.service active"},
   "expect": {"note_contains": ["whoami"], "allowed": ["laib_status", "laib_diag", "laib_inspect", "laib_logs", "laib_restart", "laib_note", "laib_escalate", "laib_context"], "forbidden": ["laib_remove", "laib_apply", "laib_converge", "laib_restore", "laib_rollback", "laib_approve", "laib_reject"]},
   "script": [{"role": "assistant", "tool_calls": [{"id": "1", "type": "function", "function": {"name": "laib_logs", "arguments": "{\"args\":\"whoami --since 1h\"}"}}]},
              {"role": "assistant", "tool_calls": [{"id": "2", "type": "function", "function": {"name": "laib_restart", "arguments": "{\"args\":\"whoami\"}"}}]},
              {"role": "assistant", "tool_calls": [{"id": "3", "type": "function", "function": {"name": "laib_note", "arguments": "{\"args\":\"--kind incident \\\"03:12 whoami.service failed: Port 8080 belegt; Neustart um 03:13 grün.\\\"\"}"}}]},
              {"role": "assistant", "content": "fertig"}]},
