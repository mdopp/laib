# Built and published by the repo's CI (.github/workflows/apps.yml), never on the box.
FROM docker.io/library/golang:1.27@sha256:01aa404fa56b604b6f48e90c1d6e2c79fe5cd78f9592f78d80303fbe171cdcc0 AS build
WORKDIR /src
COPY go.mod ./
COPY *.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags=-s -o /__NAME__ .

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /__NAME__ /__NAME__
EXPOSE 8080
ENTRYPOINT ["/__NAME__"]
