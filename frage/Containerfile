# Frage: built from this repo; one static binary, no runtime (ADR 0015).
FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /frage ./frage/cmd/frage
FROM scratch
COPY --from=build /frage /frage
EXPOSE 8710
ENTRYPOINT ["/frage"]
