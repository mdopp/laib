# laib-operator in its container (ADR 0027): the box's admin agent (ADR
# 0013). It asks a model and reads the web (ADR 0025), so it gets no more
# of the box than its folder and its token.
# One static binary on distroless/python3: CA certificates for https (the
# model, the watchdog, SMTP) and tzdata, no shell; Python 3 and its
# standard library for the skills' scripts (#839, skills/<name>/run.py),
# which it runs through skills/laibskill.py, their one door. It runs as the
# container's root, which rootless podman maps to core: it owns its folder
# as the host unit did. Laib renders the unit (internal/render ownUnit).
FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /laib-operator ./operator/cmd/laib-operator
FROM gcr.io/distroless/python3-debian12@sha256:2fdb05402a2cf21cf78fdb3ba4c5db167241e9e498140f5bf689d7efb773731f
COPY --from=build /laib-operator /laib-operator
COPY skills /skills
# the eval's cases, played against the household model every night (#860)
COPY werkstatt/evals/incidents.json werkstatt/evals/incidents-typed.json /evals/
LABEL org.opencontainers.image.source=https://github.com/mdopp/laib
ENTRYPOINT ["/laib-operator"]
