# Laib — Fedora CoreOS Butane for a box (rendered by laib-stick; the
# ${VARS} are substituted there). Ported from ServiceBay's TUI build, cut
# to what Laib needs: the core user, hostname, the data dir, DNS stub off
# (AdGuard owns 53), Z-Wave udev, linger, and a first-boot unit that runs
# scripts/install-box.sh with the answers you gave laib-stick.
variant: fcos
version: 1.5.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "${SSH_AUTHORIZED_KEY}"
      groups: [wheel, sudo]
      password_hash: "${PASSWORD_HASH}"
storage:
  directories:
    - path: /mnt/data
      mode: 0755
      user: {name: core}
      group: {name: core}
    - path: /mnt/data/stacks
      mode: 0755
      user: {name: core}
      group: {name: core}
    - path: /mnt/data/laib
      mode: 0755
      user: {name: core}
      group: {name: core}
    # every parent spelled out: Ignition creates implicit parents as root,
    # and podman refuses a ~/.config it does not own (VM run 11)
    - path: /var/home/core/.config
      mode: 0755
      user: {name: core}
      group: {name: core}
    - path: /var/home/core/.config/containers
      mode: 0755
      user: {name: core}
      group: {name: core}
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user: {name: core}
      group: {name: core}
    - path: /var/home/core/.config/systemd
      mode: 0755
      user: {name: core}
      group: {name: core}
    - path: /var/home/core/.config/systemd/user
      mode: 0755
      user: {name: core}
      group: {name: core}
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: ${HOSTNAME}
    - path: /etc/systemd/resolved.conf.d/no-stub.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          DNSStubListener=no
    - path: /etc/sysctl.d/90-laib-ports.conf
      mode: 0644
      contents:
        inline: |
          # rootless Caddy binds 80/443 and AdGuard 53 (ServiceBay set this too)
          net.ipv4.ip_unprivileged_port_start=0
    - path: /etc/udev/rules.d/99-zwave.rules
      mode: 0644
      contents:
        inline: |
          SUBSYSTEM=="tty", KERNEL=="ttyACM*", MODE="0666"
    - path: /var/lib/systemd/linger/core
      mode: 0644
      contents:
        inline: ""
    - path: /usr/local/bin/laib-data-disk.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          # The data disk (#29, #32): /mnt/data is a RAID1 with two slots and one
          # member — on purpose, so a mirror joins later with `laib disk add`, no
          # reformat. The disk is chosen ONCE and recorded by its array UUID in
          # /etc/laib/data-disk; every later boot only assembles and mounts that array.
          # Nothing here wipes a disk that holds anything, and a disk that appears later
          # (a USB backup drive, a stick left in, an SD card) is never claimed. No empty
          # disk at the first boot (the NUC): /mnt/data stays a directory on the OS
          # disk, recorded as DEVICE=none.
          set -euo pipefail
          MP=${LAIB_MP:-/mnt/data}        # overridable for the test harness only
          ETC=${LAIB_ETC:-/etc}
          SYS=${LAIB_SYS:-/sys}
          MDSTAT=${LAIB_MDSTAT:-/proc/mdstat}
          REC=$ETC/laib/data-disk
          log() { echo "laib-data-disk: $*"; }
          field() { sed -n "s/.*\b$1=\([^ ]*\).*/\1/p" "$REC"; }
          dirs() {   # what laib, podman and the day-one backup expect, owned by core
            chown core:core "$MP"
            mkdir -p "$MP/stacks" "$MP/laib" "$MP/containers/storage" "$MP/backup"
            chown core:core "$MP/stacks" "$MP/laib" "$MP/containers" "$MP/containers/storage" "$MP/backup"
            chcon -R -t container_file_t "$MP/containers" 2>/dev/null || true
          }
          md_of() {   # the active md device of an array UUID, or nothing
            mdadm --detail --scan 2>/dev/null | awk -v u="UUID=$1" 'index($0, u) {print $2; exit}'
          }
          start_inactive() {   # udev's incremental assembly holds an array INACTIVE while a member is
            local m          # missing; the members are then busy, so --assemble cannot. Start it degraded:
            for m in $(awk '/^md[0-9]+ : inactive/ {print $1}' "$MDSTAT" 2>/dev/null); do   # this is a recorded array of ours
              log "/dev/$m is inactive (a member missing?): starting it degraded" >&2
              mdadm --run "/dev/$m" >/dev/null 2>&1 || true
            done
          }
          assemble() {   # $1 = array UUID: assemble it (degraded is fine) and print the device
            local md i; md=$(md_of "$1")
            for i in 1 2 3 4 5; do
              [[ -z "$md" ]] || break
              start_inactive
              mdadm --assemble --scan --uuid="$1" --run >/dev/null 2>&1 || true
              md=$(md_of "$1")
              [[ -n "$md" ]] || sleep 2   # udev may still be adding members
            done
            [[ -n "$md" ]] || return 1
            md=$(readlink -f "$md")
            for i in 1 2 3 4 5; do
              [[ "$(cat "$SYS/block/$(basename "$md")/md/array_state" 2>/dev/null)" == inactive ]] || break
              log "$md is inactive (a member missing?): starting it degraded" >&2
              mdadm --run "$md" >/dev/null 2>&1 || sleep 2
            done
            echo "$md"
          }
          mount_array() {   # $1 = md device: mounted now, and by filesystem UUID on every boot
            local md=$1 fs; fs=$(blkid -s UUID -o value "$md")
            cat > "$ETC/systemd/system/mnt-data.mount" <<UNIT
          [Unit]
          Description=Laib data disk (RAID1, filesystem $fs)
          After=laib-data-disk.service
          Requires=laib-data-disk.service

          [Mount]
          What=/dev/disk/by-uuid/$fs
          Where=$MP
          Type=xfs
          Options=noatime

          [Install]
          WantedBy=multi-user.target
          UNIT
            systemctl daemon-reload; systemctl enable mnt-data.mount >/dev/null 2>&1 || true
            { echo "# laib-data-disk: the recorded array"; mdadm --detail --scan | sort -u; } > "$ETC/mdadm.conf"
            if ! findmnt -n "$MP" >/dev/null 2>&1; then
              mkdir -p "$MP"; chattr -i "$MP" 2>/dev/null || true
              mount -o noatime "$md" "$MP"
            fi
            dirs
          }
          active() { mdadm --detail "$1" | awk '/Active Devices/ {print $4}'; }
          mkdir -p "$ETC/laib"

          # --- every boot after the first: only the recorded array, never anything else
          if [[ -f "$REC" ]]; then
            dev=$(field DEVICE); uuid=$(field UUID); members=$(field MEMBERS)
            if [[ "$dev" == none ]]; then
              mkdir -p "$MP"; dirs
              log "no data disk recorded: $MP is on the OS disk; a disk that appears later is never claimed (laib disk status)"
              exit 0
            fi
            if [[ -z "$uuid" ]]; then   # a record from before #32: learn the UUID once
              [[ -e "$dev" ]] || mdadm --assemble --scan --run >/dev/null 2>&1 || true
              uuid=$(mdadm --detail --export "$dev" 2>/dev/null | sed -n 's/^MD_UUID=//p')
              [[ -n "$uuid" ]] && echo "DEVICE=$dev UUID=$uuid MEMBERS=${members:-1}" > "$REC"
            fi
            md=$(assemble "$uuid") || true
            if [[ -z "$md" ]]; then
              # nothing is written to the OS disk in its place: the mountpoint stays empty and immutable
              mkdir -p "$MP"; findmnt -n "$MP" >/dev/null 2>&1 || chattr +i "$MP" 2>/dev/null || true
              log "the recorded array $uuid is missing: $MP stays unmounted and read-only; laib cannot start until the disk is back"
              exit 1
            fi
            mount_array "$md"
            log "$md assembled, $(active "$md") of ${members:-?} member(s) active"
            exit 0
          fi

          # --- the first boot (or the first after a reinstall): adopt Laib's array, or claim an empty disk
          src=$(findmnt -n -o SOURCE / || true)
          lsblk "$src" >/dev/null 2>&1 || src=$(findmnt -n -o SOURCE /sysroot)
          osdisk=$(lsblk -ndo PKNAME "$src" | head -1)
          # 1) a Laib array from an earlier install (name *:data, raid1, filesystem label data): keep its data
          seen=""
          for dev in $(lsblk -nrpo NAME,TYPE | awk '$2=="part" || $2=="disk" {print $1}'); do
            info=$(mdadm --examine --export "$dev" 2>/dev/null || true)
            [[ "$(sed -n 's/^MD_LEVEL=//p' <<<"$info")" == raid1 && "$(sed -n 's/^MD_NAME=//p' <<<"$info")" == *:data ]] || continue
            uuid=$(sed -n 's/^MD_UUID=//p' <<<"$info"); seen="$seen $dev"
            md=$(assemble "$uuid") || true
            if [[ -n "$md" && "$(blkid -s LABEL -o value "$md")" == data ]]; then
              log "Laib's array $uuid found on $dev: assembled as $md, the data stays"
              mount_array "$md"
              echo "DEVICE=$md UUID=$uuid MEMBERS=$(active "$md")" > "$REC"
              exit 0
            fi
          done
          if [[ -n "$seen" ]]; then
            # Laib's array is there but will not come up: record nothing (the next boot tries again), write nothing
            mkdir -p "$MP"; chattr +i "$MP" 2>/dev/null || true
            log "Laib's array on$seen cannot be assembled: nothing recorded, $MP stays unmounted and read-only"
            exit 1
          fi
          # 2) an empty, internal disk: the largest one
          best=""; bestsize=0
          for dev in $(lsblk -dnpo NAME,TYPE | awk '$2=="disk" {print $1}'); do
            n=$(basename "$dev")
            [[ "$n" == "$osdisk" || "$n" == zram* || "$n" == loop* ]] && continue
            if [[ "$(cat "$SYS/block/$n/removable" 2>/dev/null)" == 1 || "$(lsblk -dno TRAN "$dev" | tr -d ' ')" == usb ]]; then
              log "$dev: removable or USB, never used for data"; continue
            fi
            parts=$(lsblk -nro NAME "$dev" | tail -n +2 | tr '\n' ' ')
            sigs=$(wipefs -n --noheadings -O TYPE,LABEL "$dev" 2>/dev/null | tr -s ' \n' ' ')
            if [[ -n "$parts$sigs" ]] || mdadm --examine "$dev" >/dev/null 2>&1; then
              log "$dev: not empty (${parts}${sigs}), never claimed automatically"; continue
            fi
            size=$(blockdev --getsize64 "$dev")
            if (( size > bestsize )); then bestsize=$size; best=$dev; fi
          done
          if [[ -z "$best" ]]; then
            mkdir -p "$MP"; dirs
            echo "DEVICE=none MEMBERS=0" > "$REC"
            log "no empty internal disk: $MP stays on the OS disk ($osdisk); recorded, so a later disk is never claimed"
            exit 0
          fi
          log "creating the array on the empty disk $best ($(( bestsize / 1073741824 )) GiB): one member, the mirror comes later"
          sgdisk -Z -n 1:0:0 -t 1:fd00 -c 1:laib-data "$best"
          udevadm settle
          part="${best}1"; [[ -e "$part" ]] || part="${best}p1"
          mdadm --create /dev/md/data --level=1 --raid-devices=2 --metadata=1.2 --run "$part" missing
          mkfs.xfs -q -L data /dev/md/data
          md=$(readlink -f /dev/md/data)
          uuid=$(mdadm --detail --export "$md" | sed -n 's/^MD_UUID=//p')
          mount_array "$md"
          echo "DEVICE=$md UUID=$uuid MEMBERS=1" > "$REC"
          log "done: $md, array $uuid, one member"
    - path: /usr/local/bin/laib-boot-order.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          # Every boot on EFI (#33): the entry this box booted from goes first and USB
          # entries are switched off, so a stick left in is not booted again. If the
          # firmware boots it anyway, the live system refuses an installed box.
          set -euo pipefail
          command -v efibootmgr >/dev/null || { echo "laib-boot-order: no efibootmgr"; exit 0; }
          cur=$(efibootmgr | sed -n 's/^BootCurrent: *//p')
          [[ -n "$cur" ]] || { echo "laib-boot-order: no BootCurrent"; exit 0; }
          order=$(efibootmgr | sed -n 's/^BootOrder: *//p')
          rest=$(tr ',' '\n' <<<"$order" | grep -vix "$cur" | paste -sd, - || true)
          efibootmgr -q -o "$cur${rest:+,$rest}"
          for e in $(efibootmgr -v | grep -iE '^Boot[0-9a-f]{4}\*.*(usb|removable)' | grep -oiP '^Boot\K[0-9a-f]{4}' || true); do
            [[ "${e,,}" == "${cur,,}" ]] && continue
            efibootmgr -q -b "$e" -A && echo "laib-boot-order: USB entry Boot$e switched off"
          done
          echo "laib-boot-order: Boot$cur first"
    # rootless podman keeps its images on the data disk (ServiceBay #1494): the
    # Kraftwerk's images are big; without a data disk this is still the OS disk.
    - path: /var/home/core/.config/containers/storage.conf
      mode: 0644
      user: {name: core}
      group: {name: core}
      contents:
        inline: |
          [storage]
          driver = "overlay"
          graphroot = "/mnt/data/containers/storage"
    - path: /etc/laib/firstboot.env
      mode: 0600
      user: {name: core}             # the first-boot unit runs as core
      group: {name: core}
      contents:
        inline: |
          LAIB_DOMAIN=${DOMAIN}
          LAIB_LAN_IP=${LAN_IP}
          LAIB_MODEL_URL=${MODEL_URL}
          LAIB_MODEL_LEASE=${MODEL_LEASE}
          LAIB_GPU=${GPU}
          LAIB_GH_TOKEN=${GH_TOKEN}
          LAIB_SOURCE=${SOURCE}
          LAIB_DNS_PROVIDER=${DNS_PROVIDER}
          LAIB_DNS_TOKEN=${DNS_TOKEN}
          LAIB_TLS=${TLS}
    - path: /usr/local/bin/laib-firstboot.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          # Runs as core until /etc/laib/installed exists (#37): fetch the installer of
          # the release it installs and run it with the flags from the stick. The unit
          # passes firstboot.env as environment (the token never on argv, never in ps).
          # Every step is idempotent, so a power cut or a reboot in between resumes at
          # the next boot; the marker is written last. The env file is shredded on exit
          # — except when the installer rebooted into a layered tree (exit 75): the
          # post-reboot run still needs it.
          set -euo pipefail
          KEEP=0
          finish() { [ "$KEEP" = 1 ] && return 0; sudo shred -u /etc/laib/firstboot.env 2>/dev/null || sudo rm -f /etc/laib/firstboot.env; }
          trap finish EXIT
          [ -f /etc/laib/installed ] && exit 0
          for i in $(seq 1 60); do curl -fsS https://api.github.com >/dev/null 2>&1 && break; sleep 5; done
          flags=(--domain "$LAIB_DOMAIN")
          if [ -n "${LAIB_SOURCE:-}" ]; then
            # one build served over HTTP (the VM job boots the commit under test, #38)
            curl -fsSL "$LAIB_SOURCE/install-box.sh" -o /tmp/install-box.sh
            flags+=(--source "$LAIB_SOURCE")
          else
            # the installer of the release that gets installed, not main's of today
            auth=(); [ -n "${LAIB_GH_TOKEN:-}" ] && auth=(-H "Authorization: Bearer $LAIB_GH_TOKEN")
            tag=$(curl -fsSL "${auth[@]}" -H "Accept: application/vnd.github+json" https://api.github.com/repos/mdopp/laib/releases/latest | tr -d '\n' | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
            [ -n "$tag" ] || { echo "laib-firstboot: no latest release (private repo without a token?)" >&2; exit 1; }
            curl -fsSL "${auth[@]}" -H "Accept: application/vnd.github.raw" \
              "https://api.github.com/repos/mdopp/laib/contents/scripts/install-box.sh?ref=$tag" -o /tmp/install-box.sh
            flags+=(--version "$tag")
          fi
          [ -n "${LAIB_LAN_IP:-}" ] && flags+=(--lan-ip "$LAIB_LAN_IP")
          [ -n "${LAIB_MODEL_URL:-}" ] && flags+=(--model-url "$LAIB_MODEL_URL")
          [ -n "${LAIB_MODEL_LEASE:-}" ] && flags+=(--model-lease "$LAIB_MODEL_LEASE")
          [ "${LAIB_GPU:-}" = "1" ] && flags+=(--gpu)
          [ -n "${LAIB_DNS_PROVIDER:-}" ] && flags+=(--dns-provider "$LAIB_DNS_PROVIDER")
          [ -n "${LAIB_TLS:-}" ] && flags+=(--tls "$LAIB_TLS")
          rc=0; bash /tmp/install-box.sh "${flags[@]}" || rc=$?   # LAIB_GH_TOKEN and LAIB_DNS_TOKEN come from the environment
          if [ "$rc" = 75 ]; then KEEP=1; echo "laib-firstboot: rebooting into the layered tree; continues after"; exit 0; fi
          [ "$rc" = 0 ] || exit "$rc"
          sudo mkdir -p /etc/laib && sudo touch /etc/laib/installed
systemd:
  units:
    - name: laib-data-disk.service
      enabled: true
      contents: |
        [Unit]
        Description=Laib data disk: assemble or create the RAID1 and mount /mnt/data
        DefaultDependencies=no
        # the script is in /usr/local/bin = /var/usrlocal, a mount of its own on CoreOS: wait
        # for that mount, not for local-fs.target — mnt-data.mount (written below) is part of
        # local-fs.target, and After= that target was an ordering cycle systemd broke by
        # dropping the target, sometimes spawning this before /var was there (203/EXEC)
        RequiresMountsFor=/var/usrlocal/bin
        After=systemd-udevd.service systemd-udev-trigger.service
        Before=user@1000.service laib-firstboot.service multi-user.target

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/laib-data-disk.sh
        RemainAfterExit=yes
        StandardOutput=journal+console

        [Install]
        WantedBy=multi-user.target
    - name: laib-boot-order.service
      enabled: true
      contents: |
        [Unit]
        Description=Laib: this disk first in the EFI boot order, USB entries off (#33)
        ConditionPathExists=/sys/firmware/efi

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/laib-boot-order.sh

        [Install]
        WantedBy=multi-user.target
    - name: laib-boot-flag.service
      enabled: true
      contents: |
        [Unit]
        Description=Laib: the end of the first boot reaches the disk GRUB reads (#81)
        # coreos-ignition-firstboot-complete deletes /boot/ignition.firstboot and
        # nothing syncs it. GRUB reads ext4 without replaying the journal: a power
        # cut before writeback (~30 s) boots a first boot again, Ignition re-runs
        # and the box lands in emergency mode. A freeze writes the journal home.
        ConditionKernelCommandLine=ignition.firstboot
        After=coreos-ignition-firstboot-complete.service
        RequiresMountsFor=/boot

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        # a private mount namespace: /boot is writable only in here, as in CoreOS's own unit
        MountFlags=slave
        ExecStart=/bin/sh -c 'mount -o remount,rw /boot && fsfreeze --freeze /boot && fsfreeze --unfreeze /boot'

        [Install]
        WantedBy=basic.target
    - name: laib-firstboot.service
      enabled: true
      contents: |
        [Unit]
        Description=Laib first boot: install the binaries and init the state repo
        After=network-online.target user@1000.service laib-data-disk.service laib-boot-flag.service
        Wants=network-online.target user@1000.service laib-boot-flag.service
        # never without the data disk: a failed one left the state repo on the OS disk (#107);
        # a box without a second disk passes here too (DEVICE=none exits 0)
        Requires=laib-data-disk.service
        # the marker is written by the script as its last step (#37): a boot in between resumes
        ConditionPathExists=!/etc/laib/installed

        [Service]
        Type=oneshot
        User=core
        EnvironmentFile=/etc/laib/firstboot.env
        # install-box.sh talks to core's user systemd (systemctl --user): a system
        # unit running as core needs the user bus spelled out, linger starts it.
        Environment=XDG_RUNTIME_DIR=/run/user/1000
        Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
        Environment=HOME=/var/home/core
        ExecStart=/usr/local/bin/laib-firstboot.sh
        RemainAfterExit=yes
        StandardOutput=journal+console

        [Install]
        WantedBy=multi-user.target
