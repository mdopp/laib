# The Bote's directory (ADR 0030); one static binary.
FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /directory ./directory/cmd/directory
FROM scratch
LABEL org.opencontainers.image.source=https://github.com/mdopp/laib
COPY --from=build /directory /directory
EXPOSE 8644
ENTRYPOINT ["/directory"]
