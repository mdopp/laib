# The Bote's persona engine (ADR 0020; today: Joshua); one static binary.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /persona ./persona/cmd/persona
FROM scratch
LABEL org.opencontainers.image.source=https://github.com/mdopp/laib
COPY --from=build /persona /persona
EXPOSE 8644
ENTRYPOINT ["/persona"]
