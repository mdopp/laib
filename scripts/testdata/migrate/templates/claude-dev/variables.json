{
 "CLAUDE_DEV_CONFIG_SUBDOMAIN": {
  "type": "subdomain",
  "default": "claude",
  "exposure": "public",
  "proxyPort": "CLAUDE_DEV_CONFIG_PORT",
  "proxyConfig": {
   "ssl_forced": true,
   "advanced_config": "__authelia_forward_auth__"
  },
  "audience": "admin"
 },
 "CLAUDE_DEV_PI_SUBDOMAIN": {
  "type": "subdomain",
  "default": "pi",
  "exposure": "public",
  "proxyPort": "CLAUDE_DEV_PI_PORT",
  "proxyConfig": {
   "ssl_forced": true,
   "advanced_config": "__authelia_forward_auth__"
  },
  "audience": "admin"
 },
 "CLAUDE_DEV_CONFIG_PORT": {
  "type": "text",
  "default": "8790"
 },
 "CLAUDE_DEV_PI_PORT": {
  "type": "text",
  "default": "8791"
 }
}