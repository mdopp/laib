{
 "HA_SUBDOMAIN": {
  "type": "subdomain",
  "default": "home",
  "exposure": "public",
  "proxyPort": "8123",
  "proxyConfig": {
   "ssl_forced": true
  },
  "audience": "family"
 },
 "ZWAVE_JS_SUBDOMAIN": {
  "type": "subdomain",
  "default": "zwave",
  "exposure": "internal",
  "proxyPort": "8091",
  "proxyConfig": {
   "ssl_forced": true,
   "advanced_config": "__authelia_forward_auth__"
  },
  "audience": "family"
 },
 "ZWAVE_DEVICE": {
  "type": "device",
  "default": ""
 },
 "ZWAVE_SECRET": {
  "type": "secret"
 },
 "OSCAR_HA_ADMIN_USERNAME": {
  "type": "text",
  "default": "oscar"
 },
 "OSCAR_HA_ADMIN_PASSWORD": {
  "type": "secret"
 }
}
