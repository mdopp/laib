{
 "reverseProxy": {
  "publicDomain": "example.home",
  "lanIp": "192.168.1.10",
  "hosts": [
   {
    "domain": "auth.example.home",
    "service": "auth",
    "forwardPort": 9091,
    "exposure": "public"
   },
   {
    "domain": "ldap.example.home",
    "service": "auth",
    "forwardPort": 17170,
    "exposure": "internal"
   },
   {
    "domain": "dns.example.home",
    "service": "adguard",
    "forwardPort": 8083,
    "exposure": "internal"
   },
   {
    "domain": "vault.example.home",
    "service": "vaultwarden",
    "forwardPort": 8222,
    "exposure": "public"
   },
   {
    "domain": "media.example.home",
    "service": "media",
    "forwardPort": 8096,
    "exposure": "public"
   },
   {
    "domain": "paperless.example.home",
    "service": "paperless",
    "forwardPort": 8000,
    "exposure": "internal"
   }
  ]
 },
 "installedTemplates": {
  "auth": {
   "schemaVersion": 4
  },
  "adguard": {
   "schemaVersion": 2
  },
  "vaultwarden": {
   "schemaVersion": 2
  },
  "media": {
   "schemaVersion": 8
  },
  "paperless": {
   "schemaVersion": 1
  }
 },
 "installedVariables": [
  {
   "varName": "JELLYFIN_PORT",
   "value": "8096",
   "service": "media"
  },
  {
   "varName": "MEDIA_SUBDOMAIN",
   "value": "media",
   "service": "media"
  },
  {
   "varName": "JELLYFIN_ADMIN_PASSWORD",
   "value": "",
   "service": "media",
   "kind": "secret"
  },
  {
   "varName": "TZ",
   "value": "Europe/Berlin",
   "service": "media"
  },
  {
   "varName": "PAPERLESS_PORT",
   "value": "8000",
   "service": "paperless"
  },
  {
   "varName": "PAPERLESS_SUBDOMAIN",
   "value": "paperless",
   "service": "paperless"
  },
  {
   "varName": "PAPERLESS_SECRET_KEY",
   "value": "",
   "service": "paperless",
   "kind": "secret"
  }
 ]
}