#!/usr/bin/env node
// The library answers (#195): a word search through the Vermittler's
// /query (#198) — the index opens and a search runs. Lex only and no rerank, so the probe
// loads no model.
const port = process.env.QMD_PORT || "8181";
fetch(`http://127.0.0.1:${port}/query`, {
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({ searches: [{ type: "lex", query: "haus" }], limit: 1, rerank: false }),
  signal: AbortSignal.timeout(5000),
})
  .then(async (r) => {
    if (!r.ok) throw new Error(`HTTP ${r.status}: ${(await r.text()).slice(0, 200)}`);
    await r.json();
  })
  .catch((e) => {
    console.error(`qmd does not answer: ${e.message}`);
    process.exit(1);
  });
