# laib-qmd: qmd (tobi/qmd, MIT) as released, the search of Haus's memory
# library (#195, haus#13). package-lock.json pins every dependency; the
# image tag is qmd's version. It serves the Vermittler (vermittler.mjs,
# #198): qmd's /query on qmd's SDK, plus each hit's cosine. CPU only: of
# node-llama-cpp's prebuilt backends only linux-x64 stays — no CUDA,
# Vulkan or ARM builds (~640 MB), and no llama.cpp source to build from.
# The embed model is not in the image: the first `qmd embed` downloads it
# into the mounted cache.
FROM docker.io/library/node:22-bookworm-slim AS build
WORKDIR /opt/qmd
COPY qmd/package.json qmd/package-lock.json ./
# no install scripts: every native part ships prebuilt (better-sqlite3's
# prebuilds/, node-llama-cpp's backends, the grammars as wasm); without
# them npm would node-gyp better-sqlite3 from source
RUN npm ci --omit=dev --omit=peer --ignore-scripts --no-audit --no-fund \
 && find node_modules/@node-llama-cpp -mindepth 1 -maxdepth 1 ! -name linux-x64 -exec rm -rf {} + \
 && rm -rf node_modules/node-llama-cpp/llama/gitRelease.bundle \
 && test -d node_modules/@node-llama-cpp/linux-x64/bins/linux-x64

FROM docker.io/library/node:22-bookworm-slim
LABEL org.opencontainers.image.source=https://github.com/mdopp/laib
COPY --from=build /opt/qmd /opt/qmd
COPY qmd/vermittler.mjs /opt/qmd/
COPY qmd/qmd-health /usr/local/bin/
# beside node_modules, so it imports @tobilu/qmd; node runs a symlink by its real path
RUN ln -s /opt/qmd/vermittler.mjs /usr/local/bin/qmd-vermittler
# the index and the model live in /cache (a volume), index.yml in /etc/qmd;
# QMD_FORCE_CPU: no GPU probing, the CPU build only
ENV PATH=/opt/qmd/node_modules/.bin:$PATH \
    XDG_CACHE_HOME=/cache QMD_CONFIG_DIR=/etc/qmd \
    QMD_FORCE_CPU=1 NODE_LLAMA_CPP_SKIP_DOWNLOAD=true NO_COLOR=1
# 127.0.0.1:8181; `qmd update` and `qmd embed` run beside it (podman exec)
ENTRYPOINT ["qmd-vermittler"]
